---
import Layout from '../layouts/Layout.astro';
import { STRINGS, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = STRINGS[lang].home;
---
<Layout lang={lang} title={s.title} wide>
  <div class="pt-4 sm:pt-8">
    <div class="flex items-center gap-4">
      <div class="avatar !h-14 !w-14 text-xl" id="avatar"></div>
      <div class="min-w-0"><h1 class="truncate text-[1.6rem] font-semibold tracking-tight" id="hello"><span class="skeleton inline-block w-40"></span></h1><p class="muted text-sm ltr" id="subline"></p></div>
    </div>

    <section id="workspace" class="ws mt-6" aria-live="polite"></section>

    <div id="backup" class="notice mt-6" hidden>
      <p class="font-medium">{s.backupTitle}</p><p class="mt-1 text-sm text-fg-2">{s.backupSub}</p>
    </div>

    <section class="panel mt-6" aria-labelledby="h-profile">
      <h2 id="h-profile">{s.profile}</h2>
      <form id="profile" class="mt-4 grid gap-3 sm:grid-cols-[1fr_12rem_auto] sm:items-end">
        <div><label class="label" for="p-name">{STRINGS[lang].signIn.nameLabel}</label><input class="input" id="p-name" maxlength="80" required /></div>
        <div><label class="label" for="p-locale">{STRINGS[lang].signIn.languageLabel}</label>
          <select class="input" id="p-locale"><option value="ar">العربية</option><option value="en">English</option></select></div>
        <button class="btn btn-secondary" id="p-save">{s.save}</button>
      </form>
    </section>

    <section class="panel" aria-labelledby="h-methods">
      <h2 id="h-methods">{s.methods}</h2>
      <div id="methods" class="mt-2"></div>
      <h3 class="mt-6 text-sm font-medium text-fg-2">{s.passkeys}</h3>
      <div id="passkeys" class="mt-1"></div>
      <button type="button" class="btn btn-secondary mt-3" id="add-passkey">{s.addPasskey}</button>
    </section>

    <section class="panel" aria-labelledby="h-biz">
      <h2 id="h-biz">{s.businesses}</h2>
      <div id="orgs" class="mt-2"></div>
      <div id="early-note" class="notice mt-4" hidden><p class="font-medium">{s.earlyTitle}</p><p class="mt-1 text-sm text-fg-2">{s.earlyBody} <a class="link-arrow" href={lang === 'en' ? 'https://hemlohq.com/en/early-access/' : 'https://hemlohq.com/early-access/'}>{s.earlyLink} <span class="arr">→</span></a></p></div>
      <form id="new-org" class="mt-4 flex gap-2" hidden>
        <input class="input" id="org-name" placeholder={s.businessName} maxlength="80" required aria-label={s.businessName} />
        <button class="btn btn-secondary shrink-0" id="org-create">{s.create}</button>
      </form>
    </section>

    <section class="panel" id="pin-panel" aria-labelledby="h-pin" hidden>
      <h2 id="h-pin">{s.pin}</h2>
      <p class="mt-1 text-sm muted" id="pin-sub"></p>
      <form id="pin-form" class="mt-4 flex gap-2">
        <input class="input ltr max-w-[12rem]" id="pin" type="password" inputmode="numeric" autocomplete="off" maxlength="6" placeholder={s.pinPlaceholder} aria-label={s.pin} />
        <button class="btn btn-secondary" id="pin-save">{s.pinSet}</button>
      </form>
      <p class="mt-2 text-sm" id="pin-state"></p>
    </section>

    <section class="panel" aria-labelledby="h-dev">
      <div class="flex items-center justify-between gap-3"><h2 id="h-dev">{s.devices}</h2><button type="button" class="btn-ghost btn-danger" id="others">{s.signOutOthers}</button></div>
      <div id="sessions" class="mt-2"></div>
    </section>

    <section class="panel" aria-labelledby="h-act">
      <h2 id="h-act">{s.activity}</h2>
      <div id="events" class="mt-2 text-sm"></div>
    </section>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-3">
      <a class="link-arrow hidden" id="admin-link" href="#">Hemlo admin</a>
      <button type="button" class="btn btn-secondary" id="sign-out">{s.signOut}</button>
    </div>
  </div>
</Layout>

<script>
  import { authClient, api, ba, busy, toast, h, t, fill, lang, formatIraqiPhone, normalizeIraqiPhone, requireMe, page, roleName, initials, when, passkeysSupported, ApiError, $, SYSTEM, type Me } from '../lib/client';

  let me: Me = await requireMe();

  function renderHeader() {
    $('#avatar').textContent = initials(me.user.name);
    $('#hello').textContent = me.user.name || '—';
    $('#subline').textContent = me.user.phoneNumber ? formatIraqiPhone(me.user.phoneNumber) : me.user.email ?? '';
    $('#backup').hidden = !me.needsBackup;
    ($('#p-name') as HTMLInputElement).value = me.user.name;
    ($('#p-locale') as HTMLSelectElement).value = me.user.locale === 'en' ? 'en' : 'ar';
  }

  // ---- ways to sign in: phone and email, each changed with a code ----
  function methodRow(kind: 'phone' | 'email') {
    const value = kind === 'phone' ? (me.user.phoneNumber ? formatIraqiPhone(me.user.phoneNumber) : null) : me.user.email;
    const verified = kind === 'phone' ? me.user.phoneNumberVerified : me.user.emailVerified;
    const box = h('div', { class: 'mt-3', hidden: true });
    const row = h('div', { class: 'row' },
      h('div', { class: 'flex-1 min-w-0' }, h('p', { class: 'text-sm muted', text: kind === 'phone' ? t.home.phone : t.home.email }),
        h('p', { class: 'truncate ltr' + (value ? '' : ' muted'), text: value ?? t.home.none })),
      verified ? h('span', { class: 'badge ok', text: t.home.verified }) : null,
      h('button', { type: 'button', class: 'btn-ghost', text: value ? t.home.changeAction : t.home.add, onclick: () => { box.hidden = !box.hidden; box.replaceChildren(changeForm(kind)); } }));
    return h('div', {}, row, box);
  }

  function changeForm(kind: 'phone' | 'email') {
    const input = h('input', { class: 'input ltr', type: kind === 'phone' ? 'tel' : 'email', placeholder: kind === 'phone' ? t.signIn.phonePlaceholder : t.signIn.emailPlaceholder, 'aria-label': kind === 'phone' ? t.home.phone : t.home.email });
    const code = h('input', { class: 'input code-input', inputmode: 'numeric', autocomplete: 'one-time-code', maxlength: '6', hidden: true, 'aria-label': t.signIn.codeTitle });
    const hint = h('p', { class: 'text-sm muted', hidden: true });
    const btn = h('button', { class: 'btn btn-secondary', text: t.signIn.sendCode });
    let target = '', sent = false;
    const form = h('form', { class: 'space-y-3', novalidate: true }, input, hint, code, btn);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      busy(btn, async () => {
        if (!sent) {
          if (kind === 'phone') {
            const p = normalizeIraqiPhone(input.value); if (!p) throw new ApiError(400, 'INVALID_PHONE', '');
            target = p; await ba(authClient.phoneNumber.sendOtp({ phoneNumber: p }));
          } else {
            target = input.value.trim().toLowerCase();
            await api('/v1/auth/email-otp/request-email-change', { body: { newEmail: target } });
          }
          sent = true; input.disabled = true; code.hidden = false; hint.hidden = false; code.focus();
          // isolate the number/email so it stays left-to-right inside Arabic text
          hint.textContent = fill(t.home.newCode, { to: '⁦' + (kind === 'phone' ? formatIraqiPhone(target) : target) + '⁩' });
          btn.textContent = t.signIn.verify;
        } else {
          if (kind === 'phone') await ba(authClient.phoneNumber.verify({ phoneNumber: target, code: code.value, updatePhoneNumber: true }));
          else await api('/v1/auth/email-otp/change-email', { body: { newEmail: target, otp: code.value } });
          toast(t.home.saved); await reload();
        }
      });
    });
    return form;
  }

  async function renderPasskeys() {
    const list = await ba(authClient.passkey.listUserPasskeys()).catch(() => []) as any[];
    const box = $('#passkeys');
    box.replaceChildren(...(list.length ? list.map((p) => h('div', { class: 'row' },
      h('div', { class: 'flex-1' }, h('p', { text: p.name || 'Passkey' }), h('p', { class: 'text-xs muted', text: when(p.createdAt) })),
      h('button', { type: 'button', class: 'btn-ghost btn-danger', text: t.home.remove, onclick: (e: Event) => busy(e.currentTarget as HTMLButtonElement, async () => { await ba(authClient.passkey.deletePasskey({ id: p.id })); await reload(); }) })))
      : [h('p', { class: 'text-sm muted py-2', text: t.home.passkeysNone })]));
    $('#add-passkey').hidden = !passkeysSupported();
  }

  // ---- businesses ----
  // open a business in Hemlo Systems (making it the current one first, so the workspace opens on it)
  const openIn = async (orgId: string) => {
    if (orgId !== me.activeOrganizationId) await ba(authClient.organization.setActive({ organizationId: orgId }));
    location.href = `${SYSTEM}?lang=${lang}`;
  };
  function renderWorkspace() {
    const box = $('#workspace');
    const site = lang === 'en' ? 'https://hemlohq.com/en' : 'https://hemlohq.com';
    if (!me.organizations.length) {
      box.className = 'ws ws-empty mt-6';
      box.replaceChildren(
        h('p', { class: 'ws-label', text: t.home.workspace }),
        h('h2', { class: 'mt-1 text-xl font-semibold', text: t.home.noWsTitle }), h('p', { class: 'mt-1 text-sm text-fg-2', text: t.home.noWsBody }),
        h('div', { class: 'mt-4 grid gap-2' },
          h('a', { class: 'btn btn-primary btn-block', href: `${SYSTEM}?start=dental&lang=${lang}`, text: t.home.startClinic }),
          h('a', { class: 'btn btn-primary btn-block', href: `${SYSTEM}?start=store&lang=${lang}`, text: t.home.startShop }),
          h('a', { class: 'btn btn-primary btn-block', href: `${SYSTEM}?start=gym&lang=${lang}`, text: t.home.startGym })),
        h('p', { class: 'mt-3 text-sm muted', text: t.home.invitedNote }));
      return;
    }
    const current = me.organizations.find((o) => o.id === me.activeOrganizationId) ?? me.organizations[0];
    const others = me.organizations.filter((o) => o.id !== current.id);
    const go = h('button', { type: 'button', class: 'ws-open' },
      h('span', { class: 'avatar !h-12 !w-12 text-lg', text: initials(current.name) }),
      h('span', { class: 'min-w-0 flex-1 text-start' }, h('span', { class: 'block truncate text-lg font-semibold', text: fill(t.home.open, { name: current.name }) }), h('span', { class: 'block text-sm opacity-75', text: t.home.openSub })),
      h('span', { class: 'ws-arrow', 'aria-hidden': 'true', text: '→' }));
    go.addEventListener('click', () => busy(go, () => openIn(current.id)));
    box.className = 'ws mt-6';
    box.replaceChildren(h('p', { class: 'ws-label', text: t.home.workspace }), go,
      ...others.map((o) => { const b = h('button', { type: 'button', class: 'ws-other' }, h('span', { class: 'avatar', text: initials(o.name) }), h('span', { class: 'flex-1 truncate text-start', text: o.name }), h('span', { class: 'link-arrow', text: t.home.openOther + ' →' })); b.addEventListener('click', () => busy(b, () => openIn(o.id))); return b; }));
  }

  function renderOrgs() {
    const box = $('#orgs');
    if (!me.organizations.length) { box.replaceChildren(h('p', { class: 'text-sm muted py-2', text: t.home.noBusiness })); return; }
    box.replaceChildren(...me.organizations.map((o) => {
      const active = o.id === me.activeOrganizationId;
      return h('div', { class: 'row' },
        h('div', { class: 'avatar', text: initials(o.name) }),
        h('div', { class: 'flex-1 min-w-0' }, h('p', { class: 'truncate font-medium', text: o.name }), h('p', { class: 'text-sm muted', text: roleName(o.role) })),
        active ? h('span', { class: 'badge ok', text: t.home.active }) : h('button', { type: 'button', class: 'btn-ghost', text: t.home.switchTo,
          onclick: (e: Event) => busy(e.currentTarget as HTMLButtonElement, async () => { await ba(authClient.organization.setActive({ organizationId: o.id })); await reload(); }) }),
        active ? h('a', { class: 'btn-ghost', href: page('business'), text: t.home.manage }) : null);
    }));
  }

  async function renderPin() {
    const org = me.organizations.find((o) => o.id === me.activeOrganizationId);
    $('#pin-panel').hidden = !org;
    if (!org) return;
    $('#pin-sub').textContent = fill(t.home.pinSub, { org: org.name });
    const st = await api<{ hasPin: boolean }>('/v1/counter/pin').catch(() => ({ hasPin: false }));
    $('#pin-state').textContent = st.hasPin ? t.home.pinIsSet : '';
    $('#pin-save').textContent = st.hasPin ? t.home.pinChange : t.home.pinSet;
  }

  // ---- devices ----
  async function renderSessions() {
    const list = await ba(authClient.listSessions()).catch(() => []) as any[];
    list.sort((a, b) => +new Date(b.updatedAt) - +new Date(a.updatedAt));
    $('#sessions').replaceChildren(...list.map((s) => {
      const current = s.id === me.session.id;
      return h('div', { class: 'row' },
        h('div', { class: 'flex-1 min-w-0' },
          h('p', { class: 'truncate', text: deviceLabel(s.userAgent) }),
          h('p', { class: 'text-xs muted', text: `${(t.methods as any)[s.loginMethod] ?? ''} · ${t.home.lastActive}: ${when(s.updatedAt)}` })),
        current ? h('span', { class: 'badge', text: t.home.thisDevice })
          : h('button', { type: 'button', class: 'btn-ghost btn-danger', text: t.home.signOutDevice, onclick: (e: Event) => busy(e.currentTarget as HTMLButtonElement, async () => { await ba(authClient.revokeSession({ token: s.token })); await renderSessions(); }) }));
    }));
    $('#others').hidden = list.length < 2;
  }

  const deviceLabel = (ua = '') => {
    const os = /iPhone/.test(ua) ? 'iPhone' : /iPad/.test(ua) ? 'iPad' : /Android/.test(ua) ? 'Android' : /Windows/.test(ua) ? 'Windows' : /Mac OS X/.test(ua) ? 'Mac' : 'Linux';
    const br = /Edg\//.test(ua) ? 'Edge' : /SamsungBrowser/.test(ua) ? 'Samsung Internet' : /Firefox/.test(ua) ? 'Firefox' : /Chrome|CriOS/.test(ua) ? 'Chrome' : /Safari/.test(ua) ? 'Safari' : 'Browser';
    return `${br} · ${os}`;
  };

  async function renderEvents() {
    const { events } = await api<{ events: any[] }>('/v1/events/me').catch(() => ({ events: [] }));
    $('#events').replaceChildren(...events.slice(0, 12).map((e) => h('div', { class: 'row !py-2.5' },
      h('span', { class: 'flex-1', text: (t.events as any)[e.kind] ?? e.kind }),
      h('span', { class: 'muted text-xs', text: when(e.at) }))));
  }

  async function reload() {
    me = await requireMe();
    renderHeader();
    $('#methods').replaceChildren(methodRow('phone'), methodRow('email'));
    renderWorkspace();
    renderOrgs();
    $('#new-org').hidden = !me.canCreateBusiness;
    $('#early-note').hidden = me.canCreateBusiness || me.organizations.length > 0;
    await Promise.all([renderPasskeys(), renderPin(), renderSessions(), renderEvents()]);
    const admin = $('#admin-link'); admin.classList.toggle('hidden', !me.user.hemloStaff);
  }

  $('#profile').addEventListener('submit', (e) => { e.preventDefault(); busy($('#p-save') as HTMLButtonElement, async () => {
    const locale = ($('#p-locale') as HTMLSelectElement).value;
    await ba(authClient.updateUser({ name: ($('#p-name') as HTMLInputElement).value.trim(), locale } as any));
    toast(t.home.saved);
    if (locale !== lang) location.href = locale === 'en' ? '/en/' : '/'; else await reload();
  }); });
  $('#add-passkey').addEventListener('click', () => busy($('#add-passkey') as HTMLButtonElement, async () => { await ba(authClient.passkey.addPasskey({})); await reload(); }));
  $('#new-org').addEventListener('submit', (e) => { e.preventDefault(); busy($('#org-create') as HTMLButtonElement, async () => {
    const name = ($('#org-name') as HTMLInputElement).value.trim(); if (!name) return;
    const slug = name.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-|-$/g, '').slice(0, 40) + '-' + Math.random().toString(36).slice(2, 6);
    await ba(authClient.organization.create({ name, slug }));
    ($('#org-name') as HTMLInputElement).value = '';
    await reload();
  }); });
  $('#pin-form').addEventListener('submit', (e) => { e.preventDefault(); busy($('#pin-save') as HTMLButtonElement, async () => {
    await api('/v1/counter/pin', { method: 'PUT', body: { pin: ($('#pin') as HTMLInputElement).value } });
    ($('#pin') as HTMLInputElement).value = ''; toast(t.home.saved); await renderPin();
  }); });
  $('#others').addEventListener('click', () => busy($('#others') as HTMLButtonElement, async () => { await ba(authClient.revokeOtherSessions()); await renderSessions(); }));
  $('#sign-out').addEventListener('click', () => busy($('#sign-out') as HTMLButtonElement, async () => { await ba(authClient.signOut()); location.href = page('sign-in'); }));

  await reload();
</script>
