{
  // admin.hemlohq.com: Hemlo staff dashboard (static). Also protect it with Cloudflare Access (Zero Trust → Access → Applications).
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hemlo-admin",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application", "html_handling": "auto-trailing-slash" },
  "routes": [{ "pattern": "admin.hemlohq.com", "custom_domain": true }],
  "workers_dev": false
}
