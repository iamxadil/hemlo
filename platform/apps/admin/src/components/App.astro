    // ---------- activity: what the team did ----------
    function sentence(e: any) {
      const d = e.detail ?? {}, who = e.actor || t.activity.someone, role = t.roles[d.role] ?? d.role ?? '';
      const A = t.activity;
      switch (e.kind) {
        case 'admin.early_access_approved': return ['grant', fill(A.approved, { who, business: d.business ?? '' })];
        case 'admin.early_access_updated':
          if (d.status === 'contacted') return ['work', fill(A.contacted, { who, business: d.business ?? '' })];
          if (d.status === 'declined') return ['stop', fill(A.declined, { who, business: d.business ?? '' })];
          if (d.status === 'new') return ['work', fill(A.reopened, { who, business: d.business ?? '' })];
          return ['work', fill(A.noted, { who, business: d.business ?? '' })];
        case 'early_access.activated': return ['live', fill(A.activated, { business: d.business ?? '' })];
        case 'staff.invited': return ['team', fill(A.invited, { who, email: d.email ?? '', role })];
        case 'staff.invite_canceled': return ['stop', fill(A.inviteCanceled, { who, email: d.email ?? '' })];
        case 'staff.joined': return ['team', fill(A.joined, { who, role })];
        case 'staff.removed': return ['stop', fill(A.removed, { who, name: d.name || t.activity.someone })];
        case 'staff.updated': {
          const name = d.name || t.activity.someone;
          if (d.change === 'suspended') return ['stop', fill(A.paused, { who, name })];
          if (d.change === 'resumed') return ['team', fill(A.resumed, { who, name })];
          if (d.change === 'permissions') return ['team', fill(A.perms, { who, name, role })];
          if (d.change === 'access') return ['team', fill(A.accessChanged, { who, name })];
          return ['team', fill(A.titleChanged, { who, name })];
        }
        case 'admin.ai_route_changed': {
          const [ed, f] = String(d.job ?? '').split(':'), job = `${jobName(f)} · ${t.kinds[ed] ?? ed}`;
          return ['work', d.provider === 'default' ? fill(A.aiDefault, { who, job }) : fill(A.aiRoute, { who, job, model: `${d.provider} · ${d.model}` })];
        }
        case 'admin.ai_provider_changed': return ['work', fill(d.key === 'set' ? A.aiKeySet : d.key === 'removed' ? A.aiKeyRemoved : d.enabled === false ? A.aiOff : A.aiOn, { who, provider: d.provider ?? '' })];
        case 'admin.ai_provider_added': return ['work', fill(A.aiAdded, { who, provider: d.label ?? d.provider ?? '' })];
        case 'admin.ai_provider_removed': return ['stop', fill(A.aiRemoved, { who, provider: d.provider ?? '' })];
      }
      return ['work', e.kind];
    }

    async function showActivity() {
      const sub = header(t.activity.title, t.activity.sub);
      loading();
      const { events } = await api('/v1/admin/activity');
      stamp();
      if (!events.length) return put(sub, h('div', { class: 'panel p-6 text-muted', text: t.activity.empty }));
      const dayOf = (d: string) => { const x = new Date(d); x.setHours(0, 0, 0, 0); return x.getTime(); };
      const today = dayOf(new Date().toISOString()), label = (k: number) => (k === today ? t.activity.today : k === today - 86400_000 ? t.activity.yesterday : date(new Date(k)));
      const days = new Map<number, any[]>();
      for (const e of events) { const k = dayOf(e.at); days.set(k, [...(days.get(k) ?? []), e]); }
      const time = new Intl.DateTimeFormat(locale, { timeStyle: 'short' });
      put(sub, ...[...days].map(([k, list]) => h('section', { class: 'panel mb-4' },
        h('div', { class: 'panel-h' }, h('h2', { text: label(k) }), h('span', { class: 'sub', text: num(list.length) })),
        h('ol', { class: 'feed' }, ...list.map((e) => { const [kind, text] = sentence(e); return h('li', { class: kind },
          h('span', { class: 'avatar', text: initials(e.actor || '·') }), h('p', { class: 'min-w-0 flex-1', text }), h('time', { text: time.format(new Date(e.at)) })); })))));
    }

    // ---------- chrome ----------
    ($('#search') as HTMLInputElement).addEventListener('input', () => { const p = location.hash.slice(2).split('?')[0]; if (p === 'requests') showRequests(null); else if (p === 'users') showUsers(); else if (p === 'usage') showUsage(null); });
    $('#refresh').addEventListener('click', () => act($('#refresh') as HTMLButtonElement, async () => {
      const p = location.hash.slice(2).split('?')[0] || 'overview';
      if (p === 'requests') await showRequests(new URLSearchParams(location.hash.split('?')[1]).get('id'), true);
      else if (p === 'users') await showUsers(true); else if (p === 'businesses') await showBusinesses(true); else if (p === 'billing') await showBilling(true);
      else if (p === 'team') await showTeam(new URLSearchParams(location.hash.split('?')[1]).get('id'), true); else if (p === 'activity') await showActivity(); else await showOverview(true);
    }));
    $('#menu-btn').addEventListener('click', () => document.body.classList.toggle('nav-open'));
    document.body.addEventListener('click', (e) => { if (document.body.classList.contains('nav-open') && !(e.target as HTMLElement).closest('.sidebar,#menu-btn')) document.body.classList.remove('nav-open'); });
    $('#lang-link').addEventListener('click', (e) => { (e.currentTarget as HTMLAnchorElement).href += location.hash; });
    $('#sign-out').addEventListener('click', async () => { await auth.signOut().catch(() => {}); document.cookie = 'hemlo.hint=; Max-Age=0; Path=/; Domain=.hemlohq.com'; location.href = `${ACCOUNT}${lang === 'en' ? '/en' : ''}/sign-in/`; });
    let installEvt: any = null;
    window.addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); installEvt = e; $('#install').hidden = false; });
    $('#install').addEventListener('click', async () => { await installEvt?.prompt(); $('#install').hidden = true; });

    boot();
  </script>
</body>
</html>
