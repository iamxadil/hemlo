---
import '../styles/admin.css';
import Lockup from './Lockup.astro';
import { STRINGS, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = STRINGS[lang];
const other = lang === 'ar' ? '/en/' : '/';
const I = {
  overview: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>',
  requests: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11Z"/></svg>',
  users: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
  team: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v5c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10V6l-8-3Z"/><circle cx="12" cy="10" r="2.5"/><path d="M8 16.5c.8-1.6 2.2-2.5 4-2.5s3.2.9 4 2.5"/></svg>',
  activity: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg>',
  usage: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.9 19a9 9 0 1 1 14.2 0"/><path d="m12 13 3.5-4.5"/><circle cx="12" cy="13" r="1.3"/></svg>',
  billing: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M2.5 10h19M6.5 15h4"/></svg>',
  costs: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 1 0 9 9h-9Z"/><path d="M15 3.5A9 9 0 0 1 20.5 9H15Z"/></svg>',
  ai: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3.5 11.6 8a2 2 0 0 0 1.3 1.3l4.6 1.6-4.6 1.6a2 2 0 0 0-1.3 1.3L10 18.5l-1.6-4.6a2 2 0 0 0-1.3-1.3L2.5 11l4.6-1.6A2 2 0 0 0 8.4 8Z"/><path d="M18.5 3v4M16.5 5h4M19 15.5v3M17.5 17h3"/></svg>',
  businesses: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6M9 10h.01M15 10h.01"/></svg>',
};
---
<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <title>{s.appName}</title>
  <meta name="robots" content="noindex,nofollow" />
  <meta name="theme-color" content="#0E1420" />
  <!-- use-credentials: behind Cloudflare Access the manifest needs the Access cookie, or installing the app breaks -->
  <link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preload" href={lang === 'ar' ? '/fonts/vazirmatn-arabic.woff2' : '/fonts/readex-pro-latin.woff2'} as="font" type="font/woff2" crossorigin />
</head>
<body>
  <!-- access checks -->
  <div id="gate" class="gate">
    <div class="box">
      <Lockup class="mx-auto h-7 w-auto text-white" />
      <h1 id="gate-title" class="mt-8 text-2xl font-semibold">{s.gate.checking}</h1>
      <p id="gate-body" class="mt-2"></p>
      <div id="gate-actions" class="mt-8 flex flex-col items-center gap-5"></div>
    </div>
  </div>

  <div id="app" class="shell" hidden>
    <aside class="sidebar" aria-label={s.menu}>
      <div class="brand"><Lockup class="h-[22px] w-auto" /><small>Admin</small></div>
      <nav class="grid gap-1">
        <a class="nav-item" href="#/overview" data-nav="overview" data-perm="overview.view"><Fragment set:html={I.overview} />{s.nav.overview}</a>
        <a class="nav-item" href="#/requests" data-nav="requests" data-perm="requests.view"><Fragment set:html={I.requests} />{s.nav.requests}<span class="nav-count" id="new-count" hidden></span></a>
        <a class="nav-item" href="#/users" data-nav="users" data-perm="users.view"><Fragment set:html={I.users} />{s.nav.users}</a>
        <a class="nav-item" href="#/businesses" data-nav="businesses" data-perm="businesses.view"><Fragment set:html={I.businesses} />{s.nav.businesses}</a>
        <a class="nav-item" href="#/usage" data-nav="usage" data-perm="usage.view"><Fragment set:html={I.usage} />{s.nav.usage}</a>
        <a class="nav-item" href="#/billing" data-nav="billing" data-perm="usage.view"><Fragment set:html={I.billing} />{s.nav.billing}<span class="nav-count" id="bill-count" hidden></span></a>
        <a class="nav-item" href="#/costs" data-nav="costs" data-perm="usage.view"><Fragment set:html={I.costs} />{s.nav.costs}</a>
        <a class="nav-item" href="#/ai" data-nav="ai" data-perm="ai.manage"><Fragment set:html={I.ai} />{s.nav.ai}</a>
        <hr class="nav-div" data-perm-any="team.view activity.view" />
        <a class="nav-item" href="#/team" data-nav="team" data-perm="team.view"><Fragment set:html={I.team} />{s.nav.team}</a>
        <a class="nav-item" href="#/activity" data-nav="activity" data-perm="activity.view"><Fragment set:html={I.activity} />{s.nav.activity}</a>
      </nav>
      <div class="side-foot">
        <button type="button" class="nav-item" id="install" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>{s.nav.install}</button>
        <a class="nav-item" href={other} id="lang-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"/></svg>{s.switchTo}</a>
        <div class="me-row"><span class="av" id="me-av"></span><div class="min-w-0"><p class="truncate text-sm text-white" id="me-name"></p><p class="truncate text-xs" style="color:var(--sidebar-muted)" id="me-mail"></p></div></div>
        <button type="button" class="nav-item" id="sign-out">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>{s.nav.signOut}</button>
      </div>
    </aside>

    <div class="main">
      <header class="topbar">
        <button type="button" class="icon-btn menu-btn" id="menu-btn" aria-label={s.menu}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
        <div class="min-w-0 flex-1"><h1 class="page-title truncate" id="title"></h1></div>
        <label class="search" id="search-box" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input id="search" type="search" autocomplete="off" /></label>
        <span class="hidden text-xs text-muted lg:block" id="updated"></span>
        <button type="button" class="icon-btn" id="refresh" aria-label={s.refresh} title={s.refresh}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-2.64-6.36M21 3v6h-6"/></svg></button>
      </header>
      <main class="content" id="view"></main>
    </div>
  </div>

  <div class="scrim" id="scrim"></div>
  <aside class="drawer" id="drawer" aria-modal="true" role="dialog"></aside>

  <script>
    import { createAuthClient } from 'better-auth/client';
    import { passkeyClient } from '@better-auth/passkey/client';
    import { STRINGS, fill, type Lang } from '../lib/i18n';
    import { STAFF_ROLES, PERMISSION_IMPLIES, normalizePermissions, roleFor, type StaffPermission } from '@hemlo/core/staff';

    const API = (import.meta.env.PUBLIC_API_URL as string) ?? 'http://localhost:8787';
    const ACCOUNT = (import.meta.env.PUBLIC_ACCOUNT_URL as string) ?? 'http://localhost:4321';
    const lang = document.documentElement.lang as Lang;
    const t = STRINGS[lang];
    const auth = createAuthClient({ baseURL: `${API}/v1/auth`, fetchOptions: { credentials: 'include' }, plugins: [passkeyClient()] });
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector(s) as T;

    // ---------- helpers ----------
    class ApiError extends Error { constructor(public status: number, public code: string) { super(code); } }
    async function api<T = any>(path: string, init: { method?: string; body?: unknown } = {}): Promise<T> {
      let res: Response;
      try { res = await fetch(API + path, { method: init.method ?? (init.body ? 'POST' : 'GET'), credentials: 'include', headers: init.body ? { 'content-type': 'application/json' } : {}, body: init.body ? JSON.stringify(init.body) : undefined }); }
      catch { throw new ApiError(0, 'NETWORK'); }
      const json = await res.json().catch(() => ({}));
      if (!res.ok) throw new ApiError(res.status, json.error ?? 'ERROR');
      return json;
    }
    type Kid = Node | string | null | undefined | false;
    function h<K extends keyof HTMLElementTagNameMap>(tag: K, a: Record<string, any> = {}, ...kids: Kid[]): HTMLElementTagNameMap[K] {
      const el = document.createElement(tag);
      for (const [k, v] of Object.entries(a)) {
        if (v == null || v === false) continue;
        if (k.startsWith('on')) el.addEventListener(k.slice(2).toLowerCase(), v);
        else if (k === 'class') el.className = v; else if (k === 'text') el.textContent = v; else if (k === 'html') el.innerHTML = v;
        else el.setAttribute(k, v === true ? '' : String(v));
      }
      for (const k of kids) if (k != null && k !== false) el.append(k);
      return el;
    }
    const SVG = (inner: string, cls = '') => h('span', { class: `inline-flex ${cls}`, html: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">${inner}</svg>` });
    const ICON = {
      wa: '<path d="M3 21l1.65-4.94A9 9 0 1 1 7.9 19.3L3 21Z"/><path d="M9 10c.5 2 2 3.5 4 4l1.2-1.2a1 1 0 0 1 1-.25l1.8.6"/>',
      phone: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"/>',
      mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
      close: '<path d="M18 6 6 18M6 6l12 12"/>', key: '<circle cx="7.5" cy="15.5" r="4.5"/><path d="m10.7 12.3 9.3-9.3M17 6l3 3M14 9l2 2"/>',
      check: '<path d="M20 6 9 17l-5-5"/>', lock: '<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>', plus: '<path d="M12 5v14M5 12h14"/>', link: '<path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.8 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/>',
    };
    const initials = (n: string) => { const w = (n || '·').trim().split(/\s+/); return /[؀-ۿ]/.test(w[0]) ? w[0][0] : w.slice(0, 2).map((x) => x[0]).join('').toUpperCase(); };
    const local = (p?: string | null) => (p ? p.replace(/^\+964(\d{3})(\d{3})(\d{4})$/, '0$1 $2 $3') : '—');
    const locale = lang === 'ar' ? 'ar-IQ-u-nu-latn' : 'en-GB';
    const date = (d: string | Date | null) => (d ? new Intl.DateTimeFormat(locale, { dateStyle: 'medium' }).format(new Date(d)) : '—');
    const dateTime = (d: string | Date | null) => (d ? new Intl.DateTimeFormat(locale, { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(d)) : '—');
    const rtf = new Intl.RelativeTimeFormat(lang === 'ar' ? 'ar-u-nu-latn' : 'en', { numeric: 'auto' });
    function ago(d: string | Date | null) {
      if (!d) return '—';
      const s = (new Date(d).getTime() - Date.now()) / 1000, a = Math.abs(s);
      return a < 60 ? rtf.format(Math.round(s), 'second') : a < 3600 ? rtf.format(Math.round(s / 60), 'minute') : a < 86400 ? rtf.format(Math.round(s / 3600), 'hour') : a < 86400 * 30 ? rtf.format(Math.round(s / 86400), 'day') : date(d);
    }
    const num = (n: number) => new Intl.NumberFormat(locale).format(n);
    const sum = (xs: { n: number }[]) => xs.reduce((s, x) => s + x.n, 0);
    function toast(text: string, kind: 'ok' | 'error' = 'ok') {
      const el = h('div', { class: `toast ${kind}`, role: 'status', text }); document.body.append(el);
      setTimeout(() => el.classList.add('out'), 2600); setTimeout(() => el.remove(), 3000);
    }
    async function act(btn: HTMLButtonElement | null, fn: () => Promise<unknown>) {
      if (btn) btn.disabled = true;
      try { await fn(); } catch (e) { toast(e instanceof ApiError && e.code === 'NETWORK' ? t.errors.network : t.errors.generic, 'error'); }
      finally { if (btn) btn.disabled = false; }
    }
    const pill = (status: string) => h('span', { class: `pill ${status}`, text: (t.status as any)[status] ?? status });

    // ---------- gate: signed in, Hemlo staff, fresh passkey session ----------
    function gate(title: string, body: string, actions: Node[]) {
      $('#gate-title').textContent = title; $('#gate-body').textContent = body;
      $('#gate-actions').replaceChildren(...actions); $('#gate').hidden = false; $('#app').hidden = true;
    }
    const signInUrl = () => `${ACCOUNT}${lang === 'en' ? '/en' : ''}/sign-in/?return_to=${encodeURIComponent(location.href)}`;

    let me: any;
    const perms = new Set<string>();
    const can = (p: string) => perms.has(p);
    const signOutTo = async (url: string) => { await auth.signOut().catch(() => {}); location.href = url; };
    const passkeySignIn = async () => { const r: any = await auth.signIn.passkey(); if (r?.error) throw new Error('passkey'); location.reload(); };

    async function boot() {
      if (location.hash.startsWith('#/join')) return join();
      try { me = await api('/v1/me'); }
      catch (e) {
        if (e instanceof ApiError && e.status === 401) return gate(t.gate.signInTitle, t.gate.signInBody, [h('a', { class: 'btn btn-primary', href: signInUrl(), text: t.gate.signIn })]);
        return gate(t.errors.generic, '', [h('button', { class: 'btn btn-primary', text: t.refresh, onclick: () => location.reload() })]);
      }
      const back = h('a', { class: 'btn btn-secondary', href: `${ACCOUNT}${lang === 'en' ? '/en/' : '/'}`, text: t.gate.back });
      if (me.staff?.state === 'suspended') return gate(t.access.suspendedTitle, t.access.suspendedBody, [back]);
      if (me.staff?.state === 'expired') return gate(t.access.expiredTitle, t.access.expiredBody, [back]);
      if (!me.user.hemloStaff) return gate(t.gate.deniedTitle, t.gate.deniedBody, [back]);
      me.staff.permissions.forEach((p: string) => perms.add(p));
      try { await api('/v1/admin/check'); }
      catch (e) {
        if (e instanceof ApiError && ['PASSKEY_REQUIRED', 'SESSION_TOO_OLD'].includes(e.code)) {
          // Team members join without a passkey; the first visit creates one, then signs in with it.
          if (!me.backup.passkeys) {
            const b = h('button', { class: 'btn btn-primary' }, SVG(ICON.key), t.access.create);
            b.addEventListener('click', () => act(b, async () => {
              const r: any = await auth.passkey.addPasskey({ name: 'Hemlo Admin' });
              if (r?.error) {
                if (r.error.code === 'SESSION_NOT_FRESH') return gate(t.access.createTitle, t.access.notFresh, [h('button', { class: 'btn btn-primary', text: t.access.signInAgain, onclick: () => signOutTo(signInUrl()) })]);
                throw new Error('passkey');
              }
              await passkeySignIn();
            }));
            return gate(t.access.createTitle, t.access.createBody, [b]);
          }
          const b = h('button', { class: 'btn btn-primary' }, SVG(ICON.key), t.gate.passkey);
          b.addEventListener('click', () => act(b, passkeySignIn));
          return gate(t.gate.passkeyTitle, t.gate.passkeyBody, [b]);
        }
        return gate(t.errors.generic, '', []);
      }
      $('#gate').hidden = true; $('#app').hidden = false;
      document.querySelectorAll<HTMLElement>('[data-perm]').forEach((el) => { el.hidden = !can(el.dataset.perm!); });
      document.querySelectorAll<HTMLElement>('[data-perm-any]').forEach((el) => { el.hidden = !el.dataset.permAny!.split(' ').some(can); });
      $('#me-av').textContent = initials(me.user.name); $('#me-name').textContent = me.user.name;
      $('#me-mail').textContent = [t.roles[me.staff.role], me.staff.title].filter(Boolean).join(' · ');
      if (can('requests.view')) api('/v1/admin/early-access?status=new').then((r) => setNewCount(r.requests.length)).catch(() => {});
      route();
    }

    // ---------- joining the team from an invite link ----------
    async function join() {
      const token = new URLSearchParams(location.hash.split('?')[1]).get('t') ?? '';
      const inv = await api(`/v1/team-invites/${encodeURIComponent(token)}`).catch(() => ({ status: 'invalid' }));
      const done = () => { history.replaceState(null, '', location.pathname); location.reload(); };
      if (inv.status !== 'open') return gate(t.join.title, (t.join as any)[inv.status] ?? t.join.invalid, [h('a', { class: 'btn btn-secondary', href: `${ACCOUNT}${lang === 'en' ? '/en/' : '/'}`, text: t.gate.back })]);
      const role = t.roles[inv.role] ?? inv.role;
      const intro = [inv.inviter ? fill(t.join.by, { inviter: inv.inviter, role }) : fill(t.join.plain, { role }), inv.accessUntil ? fill(t.join.until, { date: date(inv.accessUntil) }) : ''].filter(Boolean).join(' ');
      const list = h('ul', { class: 'join-perms' }, ...inv.permissions.map((p: string) => h('li', {}, SVG(ICON.check), t.perms[p]?.[0] ?? p)));
      const me0 = await api('/v1/me').catch(() => null);
      if (!me0) return gate(t.join.title, `${intro} ${fill(t.join.forEmail, { email: inv.email })}`, [h('a', { class: 'btn btn-primary', href: signInUrl(), text: t.join.signIn }), list]);
      const accept = h('button', { class: 'btn btn-primary' }, t.join.accept);
      accept.addEventListener('click', () => act(accept, async () => {
        try { await api(`/v1/team-invites/${encodeURIComponent(token)}`, { method: 'POST', body: {} }); done(); }
        catch (e) {
          if (e instanceof ApiError && e.code === 'WRONG_ACCOUNT') return gate(t.join.title, fill(t.join.wrong, { email: inv.email }), [h('button', { class: 'btn btn-primary', text: t.join.switch, onclick: () => signOutTo(signInUrl()) })]);
          if (e instanceof ApiError && e.code === 'ALREADY_ON_TEAM') return done();
          throw e;
        }
      }));
      gate(t.join.title, intro, [accept, list]);
    }

    // ---------- routing ----------
    let overview: any = null, requests: any[] = [], reqStatus = 'all', users: any[] = [], businesses: any[] = [];
    const view = () => $('#view');
    function setNewCount(n: number) { const b = $('#new-count'); b.textContent = String(n); b.hidden = !n; }
    function setBillCount(n: number) { const b = $('#bill-count'); b.textContent = String(n); b.hidden = !n; }
    function stamp() { $('#updated').textContent = fill(t.updated, { t: new Intl.DateTimeFormat(locale, { timeStyle: 'short' }).format(new Date()) }); }
    const PAGES: [string, string][] = [['overview', 'overview.view'], ['requests', 'requests.view'], ['users', 'users.view'], ['businesses', 'businesses.view'], ['usage', 'usage.view'], ['billing', 'usage.view'], ['costs', 'usage.view'], ['ai', 'ai.manage'], ['team', 'team.view'], ['activity', 'activity.view']];
    function route() {
      let [path, query] = (location.hash.slice(2) || 'overview').split('?');
      const allowed = PAGES.filter(([, p]) => can(p)).map(([name]) => name);
      if (!allowed.includes(path)) { path = allowed[0] ?? 'overview'; query = ''; history.replaceState(null, '', `#/${path}`); }
      const params = new URLSearchParams(query);
      document.querySelectorAll('[data-nav]').forEach((a) => a.toggleAttribute('aria-current', false));
      document.querySelector(`[data-nav="${path}"]`)?.setAttribute('aria-current', 'page');
      document.body.classList.remove('nav-open');
      const sb = $('#search-box'), si = $('#search') as HTMLInputElement;
      sb.hidden = !['requests', 'users', 'usage'].includes(path); si.value = ''; si.placeholder = path === 'users' ? t.users.search : path === 'usage' ? t.usage.search : t.requests.search;
      if (path === 'requests') { reqStatus = params.get('status') ?? 'all'; showRequests(params.get('id')); }
      else if (path === 'users') showUsers();
      else if (path === 'businesses') showBusinesses();
      else if (path === 'usage') { usageStatus = params.get('s') ?? 'all'; showUsage(params.get('id')); }
      else if (path === 'billing') showBilling();
      else if (path === 'costs') showCosts();
      else if (path === 'ai') showAi(params.get('job'), params.get('provider'), false, params.get('org'));
