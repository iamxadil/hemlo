    // Drawn at the container's real width (redrawn on resize), so text stays 11px on every screen.
    type ChartOpts = { labels?: [string, string | null]; extra?: (i: number) => string; aria?: string };
    function chart(a: { day: string; n: number }[], b: { day: string; n: number }[] | null, o: ChartOpts = {}) {
      const wrap = h('div', { class: 'chart-wrap', dir: 'ltr' });
      let drawn = 0;
      new ResizeObserver(() => {
        const w = Math.round(wrap.clientWidth - 40);
        if (w > 0 && Math.abs(w - drawn) > 4) { drawn = w; drawChart(wrap, a, b, w, o); }
      }).observe(wrap);
      return wrap;
    }
    function drawChart(wrap: HTMLElement, a: { day: string; n: number }[], b: { day: string; n: number }[] | null, W: number, o: ChartOpts = {}) {
      const [la, lb] = o.labels ?? [t.overview.sRequests, t.overview.sUsers];
      const H = W < 480 ? 200 : 250, L = 26, R = 4, T = 10, B = 26, n = a.length;
      const max = Math.max(4, ...a.map((x) => x.n), ...(b ?? []).map((x) => x.n));
      const step = max <= 5 ? 1 : Math.ceil(max / 4);
      const top = Math.ceil(max / step) * step;
      const y = (v: number) => T + (H - T - B) * (1 - v / top);
      const colW = (W - L - R) / n, bw = b ? Math.max(2, Math.min(12, (colW - 6) / 2)) : Math.max(3, Math.min(18, colW - 6));
      const every = W < 480 ? 10 : 7, fmt = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short' });
      const ticks = Array.from({ length: Math.floor(top / step) + 1 }, (_, i) => i * step);
      const bar = (x: number, v: number, color: string) => { if (!v) return ''; const hgt = y(0) - y(v), r = Math.min(4, bw / 2, hgt); return `<path d="M${x},${y(0)} v${-(hgt - r)} q0,${-r} ${r},${-r} h${bw - 2 * r} q${r},0 ${r},${r} v${hgt - r} z" fill="${color}"/>`; };
      let g = ticks.map((v) => `<line x1="${L}" x2="${W - R}" y1="${y(v)}" y2="${y(v)}" stroke="var(--line)" stroke-width="1"/><text x="${L - 8}" y="${y(v) + 4}" text-anchor="end">${num(v)}</text>`).join('');
      a.forEach((d, i) => {
        const x0 = L + i * colW + (colW - (b ? 2 * bw + 2 : bw)) / 2;
        g += bar(x0, d.n, 'var(--s1)') + (b ? bar(x0 + bw + 2, b[i].n, 'var(--s2)') : '');
        // a tick every week, plus the last day unless it would crowd the previous tick
        const last = i === n - 1 && (n - 1) % every >= every / 2;
        if (i % every === 0 || last) g += `<text x="${L + i * colW + colW / 2}" y="${H - 6}" text-anchor="${i === 0 ? 'start' : last ? 'end' : 'middle'}" dx="${i === 0 ? -colW / 2 : last ? colW / 2 : 0}">${fmt.format(new Date(d.day))}</text>`;
        g += `<rect class="hit" data-i="${i}" x="${L + i * colW}" y="${T}" width="${colW}" height="${H - T - B}" fill="transparent"/>`;
      });
      g += `<line x1="${L}" x2="${W - R}" y1="${y(0)}" y2="${y(0)}" stroke="var(--line-strong)" stroke-width="1"/>`;
      wrap.innerHTML = `<svg viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" role="img" aria-label="${o.aria ?? t.overview.chart}">${g}</svg>`;
      const tip = h('div', { class: 'tip' }); wrap.append(tip);
      const guide = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
      guide.setAttribute('fill', 'var(--sunken)'); guide.setAttribute('opacity', '0'); guide.setAttribute('y', String(T)); guide.setAttribute('height', String(H - T - B)); guide.setAttribute('width', String(colW));
      wrap.querySelector('svg')!.prepend(guide);
      wrap.querySelectorAll<SVGRectElement>('.hit').forEach((r) => {
        r.addEventListener('mouseenter', () => {
          const i = +r.dataset.i!;
          guide.setAttribute('x', r.getAttribute('x')!); guide.setAttribute('opacity', '1');
          tip.innerHTML = `<b>${new Intl.DateTimeFormat(locale, { weekday: 'short', day: 'numeric', month: 'long' }).format(new Date(a[i].day))}</b><br><i style="background:var(--s1)"></i>${la}: ${num(a[i].n)}` + (b && lb ? `<br><i style="background:var(--s2)"></i>${lb}: ${num(b[i].n)}` : '') + (o.extra ? `<br>${o.extra(i)}` : '');
          const box = wrap.getBoundingClientRect(), rb = r.getBoundingClientRect();
          const left = Math.min(Math.max(8, rb.left - box.left + rb.width / 2 - 70), box.width - 150);
          tip.style.left = `${left}px`; tip.style.top = '4px'; tip.style.opacity = '1';
        });
      });
      wrap.onmouseleave = () => { tip.style.opacity = '0'; guide.setAttribute('opacity', '0'); };
    }
