{
  "name": "hemlo-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "dev:api": "npm run dev -w @hemlo/api",
    "preview:website": "tsx scripts/website-preview.ts",
    "dev:account": "npm run dev -w @hemlo/account",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/system --noEmit",
    "test:ui": "tsx scripts/ui-e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "auth:schema": "npx auth@1.7.6 generate --config packages/auth/src/cli.ts --output packages/db/src/auth-schema.ts --yes"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@rolldown/binding-win32-x64-msvc": "^1.2.11",
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  }
}
