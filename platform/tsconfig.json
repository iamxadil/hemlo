{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true, "skipLibCheck": true, "noEmit": true, "resolveJsonModule": true, "isolatedModules": true,
    "types": ["node", "@cloudflare/workers-types"], "verbatimModuleSyntax": false
  },
  "include": ["packages/*/src", "apps/api/src", "tests"]
}
