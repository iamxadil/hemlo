{
  // hemlohq.com (Astro static site). Publish: npm run deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hemlo-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "404-page", "html_handling": "auto-trailing-slash" },
  "routes": [
    { "pattern": "hemlohq.com", "custom_domain": true },
    { "pattern": "www.hemlohq.com", "custom_domain": true }
  ],
  "workers_dev": false,
  // property, collection and owner-report pages (hemlohq.com/p/…, /c/…, /r/…) come from the API, worker to worker
  "services": [{ "binding": "API", "service": "hemlo-api" }],
  "observability": { "enabled": true }
}
