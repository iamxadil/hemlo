---
// Hemlo Systems with its add-ons, as one unit: a customer finds the agency's listing on Hemlo Website, asks, lands in the
// system as a lead, and hears back on WhatsApp through Hemlo Connect — a loop that plays step by step (tap a step to
// jump). Plays only while on screen; with reduced motion it stays still and the steps are tapped instead.
import Mark from './Mark.astro';
import HwBadge from './HwBadge.astro';
import type { Lang } from '../i18n/strings';
interface Props { lang: Lang; class?: string; }
const { lang, class: cls = '' } = Astro.props;
const ar = lang === 'ar';
const C = ar ? {
  customer: 'زبون', customerSub: 'على موبايله', website: 'موقعك', websiteSub: 'nakheel.hemlohq.com', system: 'نظام Hemlo', systemSub: 'مكتبك العقاري', connect: 'واتساب', connectSub: 'يرد عنك',
  steps: [['يجد عقارك على موقعك', 'من بحث جوجل، أو رابط وصله على واتساب.'], ['يسأل، فيصل إلى نظامك', 'زبون جديد في قائمتك، مع ما يبحث عنه.'], ['يرد عليه Connect خلال ثوانٍ', 'على واتساب، من عقاراتك الحقيقية وبلغته.'], ['يحجز معاينة', 'وتصله التذكيرات والمتابعة وحدها.']],
  pops: ['يتصفّح الفيلا', 'زبون جديد في قائمتك', '✦ ردّ في ٣ ثوانٍ', 'معاينة · السبت ٥ م'], short: ['✓✓', 'جديد', '✦ ٣ ث'], step: 'الخطوة',
} : {
  customer: 'A customer', customerSub: 'on their phone', website: 'Your website', websiteSub: 'nakheel.hemlohq.com', system: 'Hemlo System', systemSub: 'your agency', connect: 'WhatsApp', connectSub: 'answers for you',
  steps: [['Finds your listing on your website', 'From a Google search, or a link sent on WhatsApp.'], ['Asks, and lands in your system', 'A new lead in your list, with what they want.'], ['Connect answers within seconds', 'On WhatsApp, from your real listings, in their language.'], ['Books a viewing', 'Reminders and follow-ups go out by themselves.']],
  pops: ['Viewing the villa', '+1 new lead', '✦ Replied in 3s', 'Viewing · Sat 5 PM'], short: ['✓✓', '+1', '✦ 3s'], step: 'Step',
};
const n = (i: number) => (ar ? '١٢٣٤'[i] : String(i + 1));
---
<div class:list={['eco', cls]} data-eco data-step="0" dir={ar ? 'rtl' : 'ltr'}>
  <div class="eco-map" aria-hidden="true">
    <svg class="eco-lines" viewBox="0 0 1000 420" preserveAspectRatio="none">
      <!-- 0 customer → website · 1 website → system · 2 system → connect · 3 connect → customer -->
      {['M430 78 C270 88 175 150 165 228', 'M262 300 L392 300', 'M608 300 L738 300', 'M835 228 C825 150 730 88 570 78'].map((d, i) => (
        <g class="eco-path" data-p={i}><path class="base" d={d} pathLength="100" /><path class="flow" d={d} pathLength="100" /></g>
      ))}
    </svg>
    <div class="eco-node cust" style="--x:50%;--y:17%"><span class="ic"><svg viewBox="0 0 24 24"><rect x="7" y="2.5" width="10" height="19" rx="2.5" /><path d="M11 18.5h2" /></svg></span><b>{C.customer}</b><small>{C.customerSub}</small><em class="pop" data-on="3">✓✓ {C.pops[3]}</em></div>
    <div class="eco-node web" style="--x:15%;--y:71%"><HwBadge /><span class="url" dir="ltr">{C.websiteSub}</span><em class="pop" data-on="0">{C.pops[0]}</em></div>
    <div class="eco-node sys" style="--x:50%;--y:71%"><span class="mk"><Mark /></span><b>{C.system}</b><small>{C.systemSub}</small><em class="pop" data-on="1">{C.pops[1]}</em></div>
    <div class="eco-node con" style="--x:85%;--y:71%"><HwBadge label="Connect" /><span class="wa"><svg viewBox="0 0 24 24"><path d="M3 21l1.65-4.94A9 9 0 1 1 7.9 19.3L3 21Z" /></svg>{C.connect}</span><em class="pop" data-on="2">{C.pops[2]}</em></div>
  </div>

  <!-- on a phone: the same loop, top to bottom -->
  <ol class="eco-list" aria-hidden="true">
    <li class="cust"><span class="ic"><svg viewBox="0 0 24 24"><rect x="7" y="2.5" width="10" height="19" rx="2.5" /><path d="M11 18.5h2" /></svg></span><span><b>{C.customer}</b><small>{C.customerSub}</small></span><em class="pop" data-on="3">{C.short[0]}</em></li>
    <li class="web"><HwBadge /><em class="pop" data-on="0">{C.pops[0]}</em></li>
    <li class="sys"><span class="mk"><Mark /></span><span><b>{C.system}</b><small>{C.systemSub}</small></span><em class="pop" data-on="1">{C.short[1]}</em></li>
    <li class="con"><HwBadge label="Connect" /><em class="pop" data-on="2">{C.short[2]}</em></li>
  </ol>

  <div class="eco-steps" role="tablist">
    {C.steps.map(([h, p], i) => (
      <button type="button" role="tab" data-go={i} aria-selected={i === 0 ? 'true' : 'false'}>
        <span class="bar"><i></i></span>
        <span class="k">{C.step} {n(i)}</span><b>{h}</b><span class="p">{p}</span>
      </button>
    ))}
  </div>
</div>

<script>
  // one loop per diagram: advance every few seconds while it is on screen; a tap jumps to that step
  const STEP_MS = 3200;
  for (const root of document.querySelectorAll<HTMLElement>('[data-eco]')) {
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-go]')];
    let step = 0, timer = 0, seen = false;
    const show = (i: number) => {
      step = (i + 4) % 4;
      root.dataset.step = String(step);
      tabs.forEach((t, j) => t.setAttribute('aria-selected', j === step ? 'true' : 'false'));
    };
    const run = () => { window.clearInterval(timer); if (seen && !still && !document.hidden) timer = window.setInterval(() => show(step + 1), STEP_MS); };
    tabs.forEach((t, j) => t.addEventListener('click', () => { show(j); run(); }));
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; root.classList.toggle('on', seen); run(); }, { threshold: 0.35 }).observe(root);
    document.addEventListener('visibilitychange', run);
    if (still) root.classList.add('still');
  }
</script>

<style>
  .eco { --g: #1F6F5C; --wa: #1FA855; --ink: #0E1420; --step: 3.2s; position: relative; }
  @media (prefers-color-scheme: dark) { .eco { --g: #5FBF9F; --wa: #3CCB75; } }

  /* the map (wide screens) */
  .eco-map { position: relative; aspect-ratio: 1000 / 420; margin-inline: auto; max-width: 62rem; }
  .eco-lines { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .eco[dir="rtl"] .eco-lines { transform: scaleX(-1); }
  .eco-path path { fill: none; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .eco-path .base { stroke: var(--line-strong); stroke-width: 1.6; stroke-dasharray: 2 3; }
  .eco-path .flow { stroke: var(--g); stroke-width: 3; stroke-dasharray: 0 100; opacity: 0; transition: opacity .3s; }
  .eco[data-step="0"] [data-p="0"] .flow, .eco[data-step="1"] [data-p="1"] .flow, .eco[data-step="2"] [data-p="2"] .flow, .eco[data-step="3"] [data-p="3"] .flow { opacity: 1; animation: eco-draw var(--step) cubic-bezier(.65, 0, .35, 1) both; }
  .eco[data-step="2"] [data-p="2"] .flow, .eco[data-step="3"] [data-p="3"] .flow { stroke: var(--wa); }
  @keyframes eco-draw { 0% { stroke-dasharray: 0 100; } 45%, 100% { stroke-dasharray: 100 0; } }
  /* once a step has passed, its line stays lit, quietly: the loop reads as one path */
  .eco[data-step="1"] [data-p="0"] .base, .eco[data-step="2"] [data-p="0"] .base, .eco[data-step="2"] [data-p="1"] .base,
  .eco[data-step="3"] [data-p="0"] .base, .eco[data-step="3"] [data-p="1"] .base, .eco[data-step="3"] [data-p="2"] .base { stroke: color-mix(in oklab, var(--g) 45%, var(--line-strong)); stroke-dasharray: none; }

  .eco-node { position: absolute; inset-inline-start: var(--x); top: var(--y); translate: -50% -50%; display: grid; justify-items: center; gap: .35rem; text-align: center; }
  .eco[dir="rtl"] .eco-node { translate: 50% -50%; }
  .eco-node b { font-weight: 600; font-size: 1rem; letter-spacing: -.01em; }
  .eco-node small { font-size: .8rem; color: var(--muted); }
  .eco-node .ic { display: grid; place-items: center; width: 3.4rem; height: 3.4rem; border-radius: 50%; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line), 0 10px 26px -14px rgb(14 20 32 / .35); }
  .eco-node svg { width: 1.45rem; height: 1.45rem; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .eco-node.web, .eco-node.con { padding: 1rem 1.1rem; border-radius: 1.1rem; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line), 0 24px 48px -30px rgb(14 20 32 / .4); }
  .eco-node .url { font-size: .76rem; color: var(--fg-2); }
  .eco-node .wa { display: inline-flex; align-items: center; gap: .35rem; font-size: .82rem; font-weight: 600; color: var(--wa); }
  .eco-node .wa svg { width: 1rem; height: 1rem; }
  .eco-node.sys { padding: 1.2rem 1.6rem; border-radius: 1.3rem; background: var(--ink); color: #F4F1EA; box-shadow: 0 30px 60px -28px rgb(14 20 32 / .7), inset 0 1px 0 rgb(255 255 255 / .08); }
  @media (prefers-color-scheme: dark) { .eco-node.sys { background: #F2F1EC; color: #0E1420; } .eco-node.sys small { color: #4B5563; } }
  .eco-node.sys small { color: rgb(244 241 234 / .62); }
  .eco-node.sys .mk { display: block; width: 2.3rem; color: var(--g); }
  .eco-node.sys .mk :global(svg) { width: 100%; height: auto; }
  /* the node that's acting now breathes; its note pops */
  .eco[data-step="0"] .eco-node.web, .eco[data-step="1"] .eco-node.sys, .eco[data-step="2"] .eco-node.con, .eco[data-step="3"] .eco-node.cust .ic { animation: eco-beat var(--step) ease both; }
  @keyframes eco-beat { 40% { scale: 1; } 52% { scale: 1.045; } 66%, 100% { scale: 1; } }
  .pop { position: absolute; top: 100%; inset-inline-start: 50%; translate: -50% .55rem; white-space: nowrap; padding: .3rem .7rem; border-radius: 999px; font-size: .78rem; font-weight: 600; font-style: normal;
    background: var(--g); color: #fff; box-shadow: 0 10px 22px -12px var(--g); opacity: 0; scale: .9; transition: opacity .35s ease, scale .35s cubic-bezier(.34, 1.56, .64, 1); pointer-events: none; }
  .eco[dir="rtl"] .pop { translate: 50% .55rem; }
  .eco-node.cust .pop { top: auto; bottom: 100%; translate: -50% -.55rem; }
  .eco[dir="rtl"] .eco-node.cust .pop { translate: 50% -.55rem; }
  .eco-node.con .pop, .eco-node.cust .pop { background: var(--wa); box-shadow: 0 10px 22px -12px var(--wa); }
  @media (prefers-color-scheme: dark) { .pop { color: #0B1019; } }
  .eco[data-step="0"] .pop[data-on="0"], .eco[data-step="1"] .pop[data-on="1"], .eco[data-step="2"] .pop[data-on="2"], .eco[data-step="3"] .pop[data-on="3"] { opacity: 1; scale: 1; transition-delay: calc(var(--step) * .42); }

  /* the steps */
  .eco-steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin-top: 2.6rem; }
  .eco-steps button { display: grid; gap: .3rem; align-content: start; text-align: start; padding: 0; background: none; border: 0; cursor: pointer; color: inherit; }
  .eco-steps .bar { display: block; height: 3px; border-radius: 3px; background: var(--line); overflow: hidden; margin-bottom: .7rem; }
  .eco-steps .bar i { display: block; height: 100%; width: 0; background: var(--g); border-radius: inherit; }
  .eco-steps [aria-selected="true"] .bar i { width: 100%; transition: width var(--step) linear; }
  .eco.still .eco-steps [aria-selected="true"] .bar i, .eco:not(.on) .eco-steps [aria-selected="true"] .bar i { transition: none; }
  .eco-steps .k { font-size: .78rem; font-weight: 600; color: var(--muted); }
  .eco-steps b { font-weight: 600; font-size: 1.02rem; line-height: 1.35; transition: color .3s; }
  .eco-steps .p { font-size: .9rem; color: var(--fg-2); line-height: 1.5; }
  .eco-steps button[aria-selected="false"] b { color: var(--fg-2); }
  .eco-steps button[aria-selected="true"] .k { color: var(--g); }
  .eco-steps button:focus-visible { outline: 2px solid var(--g); outline-offset: 6px; border-radius: 6px; }

  /* the list (phones) */
  .eco-list { display: none; }
  @media (max-width: 760px) {
    .eco-map { display: none; }
    .eco-list { display: grid; gap: 1.6rem; position: relative; padding-inline-start: .2rem; }
    .eco-list::before { content: ""; position: absolute; inset-block: 1.6rem; inset-inline-start: 1.9rem; width: 2px; background: repeating-linear-gradient(var(--line-strong) 0 3px, transparent 3px 7px); }
    .eco-list li { position: relative; display: flex; align-items: center; gap: .8rem; min-height: 3.4rem; }
    .eco-list .ic, .eco-list .mk { position: relative; z-index: 1; display: grid; place-items: center; flex: none; width: 3.4rem; height: 3.4rem; border-radius: 50%; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
    .eco-list .mk { background: var(--ink); color: var(--g); padding: .75rem; }
    .eco-list .mk :global(svg) { width: 100%; height: auto; }
    .eco-list .ic svg { width: 1.4rem; height: 1.4rem; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
    .eco-list li.web :global(.hw), .eco-list li.con :global(.hw) { position: relative; z-index: 1; margin-inline-start: .15rem; }
    .eco-list b { display: block; font-weight: 600; } .eco-list small { color: var(--muted); font-size: .8rem; }
    .eco-list .pop { position: static; translate: none; margin-inline-start: auto; }
    .eco[data-step="0"] .eco-list .web, .eco[data-step="1"] .eco-list .sys, .eco[data-step="2"] .eco-list .con, .eco[data-step="3"] .eco-list .cust { animation: eco-beat var(--step) ease both; }
    .eco-steps { grid-template-columns: 1fr 1fr; gap: 1.4rem 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .eco *, .eco *::before { animation: none !important; transition: none !important; }
    .eco .eco-path .base { stroke: color-mix(in oklab, var(--g) 45%, var(--line-strong)); stroke-dasharray: none; }
    .eco .pop { opacity: 1; scale: 1; }
  }
</style>
