---
// The home hero: one line, one question ("I run a … gym / clinic / store"), and the answer on three real phones.
// Picking a business brings its phone forward, tints the page in its colour and points both buttons at its product.
// Until someone picks, it turns slowly through the three on its own (not with reduced motion, not off-screen).
import Mark from './Mark.astro';
import { t, href, TOOLS_URL, studioUrl, PRODUCT, TRADES_PAGES, productLinks, type Lang, type Trade } from '../i18n/strings';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang), H = s.home.hero;
const SHOT: Record<Trade, string> = { gym: 'gym/phone-desk', dental: 'dental/phone-today', stores: 'stores/phone-sell' };
// a small line icon for each one's floating moment: a WhatsApp-style bubble, a clock, a cloud that's offline
const ICON: Record<Trade, string> = {
  gym: 'M2.5 7.5a5.5 5.5 0 1 1 2.4 4.5L2.5 13l.9-2.6a5.5 5.5 0 0 1-.9-2.9ZM6 7.5l1.5 1.5L10.5 6',
  dental: 'M8 2.5a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11ZM8 5v3l2 1.5',
  stores: 'M4.5 12.5h7a3 3 0 0 0 .4-6 4 4 0 0 0-7.7-.9A3.5 3.5 0 0 0 4.5 12.5ZM6.5 9.5l1.2 1.2 2.3-2.4',
};
const trades = TRADES_PAGES.map((id) => ({ id, color: PRODUCT[id].color, url: href(lang, id), demo: productLinks(id, lang).demo, ...H.trades[id] }));
const title = s.home.title.replace(/\.$/, '');
---
<section class="hs" data-hs style={`--acc:${trades[0].color}`}>
  <div class="hs-wrap wrap">
    <div class="hs-top">
      <p class="eyebrow rise">{s.home.eyebrow}</p>
      <h1 class="hs-title rise rise-2">{title}<span class="hs-dot">.</span></h1>
      <p class="hs-sub rise rise-3">{H.sub}</p>

      <div class="hs-pick rise rise-4">
        <span class="hs-irun" id="hs-irun">{H.iRun}</span>
        <div class="hs-pills" role="group" aria-labelledby="hs-irun">
          {trades.map((x, i) => (
            <button type="button" class="hs-pill" data-i={i} data-url={x.url} data-demo={x.demo} data-color={x.color} aria-pressed={i === 0 ? 'true' : 'false'} style={`--c:${x.color}`}>
              <span>{x.pick}</span><i aria-hidden="true"></i>
            </button>
          ))}
        </div>
      </div>
    </div>

    <div class="hs-stage" aria-hidden="true">
      <div class="hs-glow"></div>
      <span class="hs-mark"><Mark /></span>
      {trades.map((x, i) => (
        <figure class="hs-phone" data-i={i} data-rel={i === 0 ? 0 : i === 1 ? 1 : 2} style={`--c:${x.color}`}>
          <img src={`/images/${SHOT[x.id]}-${lang}-420.webp`} srcset={`/images/${SHOT[x.id]}-${lang}-420.webp 420w, /images/${SHOT[x.id]}-${lang}-840.webp 840w`}
               sizes="(min-width: 1024px) 250px, 48vw" width="420" height="909" alt="" decoding="async" fetchpriority={i === 0 ? 'high' : undefined} />
        </figure>
      ))}
      {trades.map((x, i) => (
        <div class:list={['hs-toast', i === 0 && 'on']} data-i={i} style={`--c:${x.color}`}>
          <span class="hs-toast-ic"><svg viewBox="0 0 16 16"><path d={ICON[x.id]} /></svg></span>
          <span><b>{x.toast[0]}</b><small>{x.toast[1]}</small></span>
        </div>
      ))}
    </div>
    <div class="hs-bot">
      <div class="hs-cta rise rise-5">
        <a class="btn hs-go" href={trades[0].url} data-go>
          {trades.map((x, i) => <span class:list={['hs-go-t', i === 0 && 'on']} aria-hidden={i === 0 ? undefined : 'true'}>{x.see}</span>)}
          <span class="arr" aria-hidden="true">→</span>
        </a>
        <a class="btn btn-secondary" href={trades[0].demo} data-try rel="noopener">{s.product.demo}</a>
      </div>

      <ul class="hs-facts rise rise-5">{H.facts.map((f) => <li>{f}</li>)}</ul>
    </div>

  </div>

  <p class="hs-else wrap rise rise-5">
    <span>{H.else}</span>
    <a href={TOOLS_URL} rel="noopener">{H.tools}</a>
    <span aria-hidden="true">·</span>
    <a href={`${studioUrl(lang)}#build`} rel="noopener">{H.studio}</a>
    <span aria-hidden="true">·</span>
    <a href="#branches">{H.all}</a>
  </p>
</section>

<script>
  function init() {
    const root = document.querySelector<HTMLElement>('[data-hs]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const pills = [...root.querySelectorAll<HTMLButtonElement>('.hs-pill')];
    const phones = [...root.querySelectorAll<HTMLElement>('.hs-phone')];
    const toasts = [...root.querySelectorAll<HTMLElement>('.hs-toast')];
    const goT = [...root.querySelectorAll<HTMLElement>('.hs-go-t')];
    const go = root.querySelector<HTMLAnchorElement>('[data-go]')!, demo = root.querySelector<HTMLAnchorElement>("[data-try]")!;
    const data = pills.map((p) => ({ url: p.dataset.url!, demo: p.dataset.demo!, color: p.dataset.color! }));
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cur = 0, auto = !still, timer = 0, seen = true;

    const show = (i: number) => {
      cur = (i + pills.length) % pills.length;
      root.style.setProperty('--acc', data[cur].color);
      pills.forEach((p, k) => p.setAttribute('aria-pressed', String(k === cur)));
      phones.forEach((p, k) => (p.dataset.rel = String((k - cur + 3) % 3)));
      toasts.forEach((x, k) => x.classList.toggle('on', k === cur));
      goT.forEach((x, k) => { x.classList.toggle('on', k === cur); x.toggleAttribute('aria-hidden', k !== cur); });
      go.href = data[cur].url; demo.href = data[cur].demo;
    };
    // turning on its own: one business every few seconds, with a bar filling under the chosen pill
    const tick = () => {
      clearTimeout(timer);
      root.classList.toggle('auto', auto && seen);
      if (!auto || !seen) return;
      pills[cur].querySelector('i')!.getAnimations().forEach((a) => (a.currentTime = 0));
      timer = window.setTimeout(() => { show(cur + 1); tick(); }, 5200);
    };
    const pick = (i: number) => { auto = false; tick(); show(i); };

    pills.forEach((p, i) => p.addEventListener('click', () => pick(i)));
    phones.forEach((p) => p.addEventListener('click', () => pick(Number(p.dataset.i))));
    // a sideways swipe over the phones moves to the next business
    let x0 = 0, y0 = 0;
    const stage = root.querySelector<HTMLElement>('.hs-stage')!;
    stage.addEventListener('pointerdown', (e) => { x0 = e.clientX; y0 = e.clientY; });
    stage.addEventListener('pointerup', (e) => {
      const dx = e.clientX - x0, dy = e.clientY - y0;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.4) pick(cur + (dx < 0 ? 1 : -1) * (document.documentElement.dir === 'rtl' ? -1 : 1));
    });
    const io = new IntersectionObserver(([e]) => { seen = e.isIntersecting && !document.hidden; tick(); });
    io.observe(root);
    const vis = () => { seen = !document.hidden; tick(); };
    document.addEventListener('visibilitychange', vis);
    document.addEventListener('astro:before-swap', () => { clearTimeout(timer); io.disconnect(); document.removeEventListener('visibilitychange', vis); }, { once: true });
    tick();
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  @property --acc { syntax: '<color>'; inherits: true; initial-value: #E4572E; }
  .hs { position: relative; overflow: clip; padding-block: 2.5rem 1rem; transition: --acc .8s var(--ease-soft); }
  .hs-wrap { display: grid; gap: 1.75rem; }
  @media (min-width: 1024px) {
    .hs { padding-block: 4.5rem 1.5rem; }
    .hs-wrap { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); grid-template-areas: "top stage" "bot stage"; gap: 0 2rem; }
    .hs-top { grid-area: top; align-self: end; } .hs-bot { grid-area: bot; align-self: start; } .hs-stage { grid-area: stage; align-self: center; }
  }

  /* the words */
  .hs-top, .hs-bot { text-align: center; }
  @media (min-width: 1024px) { .hs-top, .hs-bot { text-align: start; } }
  .hs-title { margin-top: .7rem; font-size: clamp(2.9rem, 11vw, 6.25rem); line-height: 1.02; letter-spacing: -.045em; font-weight: 600; }
  :global(html[lang="ar"]) .hs-title { font-size: clamp(3rem, 12vw, 6rem); line-height: 1.2; letter-spacing: 0; }
  .hs-dot { color: var(--acc); }
  .hs-sub { max-width: 34rem; margin: 1.1rem auto 0; font-size: clamp(1rem, 1.6vw, 1.25rem); line-height: 1.55; color: var(--fg-2); text-wrap: pretty; }
  @media (min-width: 1024px) { .hs-sub { margin-inline: 0; } }

  /* "I run a  [gym] [dental clinic] [store]" */
  .hs-pick { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: .5rem .75rem; margin-top: 1.75rem; }
  @media (min-width: 1024px) { .hs-pick { justify-content: start; gap: 1rem; margin-top: 2rem; } }
  .hs-irun { font-weight: 500; color: var(--muted); white-space: nowrap; }
  .hs-pills { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: .3rem; padding: .3rem; border-radius: 999px; background: var(--sunken); border: 1px solid var(--line); }
  .hs-pill { position: relative; overflow: hidden; padding: .55rem .85rem; border-radius: 999px; font-size: .95rem; font-weight: 500; color: var(--fg-2); white-space: nowrap; transition: background-color .35s var(--ease-soft), color .25s, box-shadow .35s, transform .15s; }
  @media (min-width: 400px) { .hs-pill { padding: .6rem 1rem; } }
  .hs-pill:active { transform: scale(.96); }
  @media (hover: hover) { .hs-pill:hover { color: var(--fg); } }
  .hs-pill[aria-pressed="true"] { background: var(--c); color: #fff; box-shadow: 0 6px 18px -8px var(--c); }
  /* the bar that fills while the hero turns on its own */
  .hs-pill i { position: absolute; inset-inline: 1rem; bottom: .3rem; height: 2px; border-radius: 2px; background: rgb(255 255 255 / .9); transform: scaleX(0); transform-origin: left; opacity: 0; }
  :global(html[dir="rtl"]) .hs-pill i { transform-origin: right; }
  .hs.auto .hs-pill[aria-pressed="true"] i { opacity: .7; animation: hs-fill 5.2s linear both; }
  @keyframes hs-fill { to { transform: scaleX(1); } }

  .hs-cta { display: flex; flex-wrap: wrap; justify-content: center; gap: .75rem; }
  @media (min-width: 1024px) { .hs-cta { margin-top: 1.75rem; } }
  @media (min-width: 1024px) { .hs-cta { justify-content: start; } }
  .hs-go { position: relative; background: var(--invert); color: var(--on-invert); }
  .hs-go:hover { opacity: .88; }
  /* the three button texts share one place, so the button never jumps when the words change */
  .hs-go { display: inline-grid; grid-auto-flow: column; }
  .hs-go-t { grid-area: 1 / 1; opacity: 0; transform: translateY(6px); transition: opacity .3s, transform .4s var(--ease-soft); }
  .hs-go-t.on { opacity: 1; transform: none; }
  .hs-go .arr { grid-area: 1 / 2; margin-inline-start: .5rem; transition: transform .2s var(--ease-soft); }
  .hs-go:hover .arr { transform: translateX(3px); }
  :global(html[dir="rtl"]) .hs-go .arr { transform: scaleX(-1); }
  :global(html[dir="rtl"]) .hs-go:hover .arr { transform: scaleX(-1) translateX(3px); }

  .hs-facts { display: flex; flex-wrap: wrap; justify-content: center; gap: .4rem 1.1rem; margin-top: 1.6rem; font-size: .875rem; color: var(--muted); }
  @media (min-width: 1024px) { .hs-facts { justify-content: start; } }
  .hs-facts li { display: inline-flex; align-items: center; gap: .45rem; }
  .hs-facts li::before { content: ""; width: .4rem; height: .4rem; border-radius: 50%; background: var(--acc); }

  /* the phones: the chosen one in front, the other two leaning out behind it */
  .hs-stage { --pw: clamp(10.5rem, 42vw, 15.5rem); position: relative; height: calc(var(--pw) * 2.164 + 2rem); touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  .hs-glow { position: absolute; inset: 10% 5% 0; border-radius: 50%; background: radial-gradient(closest-side, color-mix(in oklab, var(--acc) 30%, transparent), transparent); filter: blur(24px); opacity: .8; }
  /* the founder's H, huge and faint behind the phones, in the chosen business's colour */
  .hs-mark { position: absolute; left: 50%; top: 50%; height: 104%; translate: -50% -50%; color: var(--acc); opacity: .09; }
  .hs-mark :global(svg) { display: block; height: 100%; width: auto; }
  @media (prefers-color-scheme: dark) { .hs-mark { opacity: .1; } .hs-glow { opacity: .6; } }
  .hs-phone { --x: 0; --s: 1; position: absolute; left: 50%; top: 1rem; width: var(--pw); margin: 0; cursor: pointer; border-radius: calc(var(--pw) * .15); border: calc(var(--pw) * .028) solid #0B0F16; background: #0B0F16; overflow: hidden;
    box-shadow: 0 40px 70px -30px rgb(11 15 22 / .55), 0 0 0 1px rgb(255 255 255 / .06);
    transform: translateX(calc(-50% + var(--x) * var(--s) * 58%)) scale(var(--k, 1)) rotate(calc(var(--x) * var(--s) * 6deg));
    transition: transform .9s var(--ease-soft), filter .6s, opacity .6s; }
  :global(html[dir="rtl"]) .hs-phone { --s: -1; }
  .hs-phone img { display: block; width: 100%; height: auto; border-radius: calc(var(--pw) * .12); }
  .hs-phone[data-rel="0"] { z-index: 3; cursor: default; }
  .hs-phone[data-rel="1"] { --x: 1; --k: .82; z-index: 2; filter: saturate(.7) brightness(.92); }
  .hs-phone[data-rel="2"] { --x: -1; --k: .82; z-index: 1; filter: saturate(.7) brightness(.92); }
  @media (prefers-color-scheme: dark) { .hs-phone[data-rel="1"], .hs-phone[data-rel="2"] { filter: saturate(.6) brightness(.6); } }
  @media (hover: hover) { .hs-phone:not([data-rel="0"]):hover { filter: none; } }

  /* one small moment from the chosen system, floating by its phone */
  .hs-toast { position: absolute; z-index: 4; inset-inline-start: 50%; bottom: 14%; display: flex; align-items: center; gap: .65rem; white-space: nowrap; padding: .7rem 1.1rem .7rem .7rem; border-radius: 1.1rem;
    background: color-mix(in oklab, var(--surface) 88%, transparent); -webkit-backdrop-filter: blur(16px) saturate(1.4); backdrop-filter: blur(16px) saturate(1.4); border: 1px solid var(--line);
    box-shadow: 0 1px 2px rgb(14 20 32 / .06), 0 20px 40px -18px rgb(14 20 32 / .35); text-align: start;
    translate: calc(var(--pw) * -.95) 0; opacity: 0; transform: translateY(12px) scale(.96); transition: opacity .35s, transform .5s var(--ease-soft); pointer-events: none; }
  :global(html[dir="rtl"]) .hs-toast { translate: calc(var(--pw) * .95) 0; }
  .hs-toast.on { opacity: 1; transform: none; transition-delay: .35s; }
  .hs-toast-ic { display: grid; place-items: center; flex: none; width: 2.2rem; height: 2.2rem; border-radius: .75rem; background: var(--c); color: #fff; }
  .hs-toast-ic svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .hs-toast b { display: block; font-size: .875rem; font-weight: 600; line-height: 1.3; }
  .hs-toast small { display: block; margin-top: .1rem; font-size: .78rem; color: var(--muted); }
  @media (max-width: 1023px) { .hs-toast { max-width: none; white-space: nowrap; padding: .55rem .8rem .55rem .55rem; bottom: 8%; translate: calc(var(--pw) * -.78) 0; } :global(html[dir="rtl"]) .hs-toast { translate: calc(var(--pw) * .78) 0; } .hs-toast-ic { width: 1.9rem; height: 1.9rem; } }

  /* not sure? the other two ways Hemlo helps */
  .hs-else { display: flex; flex-wrap: wrap; justify-content: center; gap: .35rem .6rem; margin-top: 2.75rem; font-size: .95rem; color: var(--muted); }
  .hs-else a { color: var(--fg); font-weight: 500; text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 4px; transition: text-decoration-color .2s; }
  .hs-else a:hover { text-decoration-color: currentColor; }

  @media (prefers-reduced-motion: reduce) {
    .hs, .hs-phone, .hs-toast, .hs-go-t, .hs-pill { transition: none !important; }
  }
</style>
