---
// The home hero: one line, one question ("I run a … gym / clinic / store / real estate office"), and the answer on real phones.
// The blank is a wheel: a little 3D drum of the trades, the chosen one in front in its colour, the others curving away
// above and below. Turning it (a tap on a word, a drag, the arrow keys, a swipe over the phones) brings that business's
// phone forward, tints the page in its colour and points both buttons at its product. Until someone turns it, it turns
// slowly on its own (not with reduced motion, not off-screen), and the phones turn with it.
import Mark from './Mark.astro';
import { t, href, TOOLS_URL, studioUrl, PRODUCT, TRADES_PAGES, productLinks, type Lang, type Trade } from '../i18n/strings';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang), H = s.home.hero;
const ORDER: Trade[] = ['gym', 'dental', 'stores', 'realestate'];
const SHOT: Record<Trade, string> = { gym: 'gym/phone-desk', dental: 'dental/phone-today', stores: 'stores/phone-sell', realestate: 'realestate/phone-today' };
// a small line icon for each one's floating moment: a WhatsApp-style bubble, a clock, a cloud that's offline, an eye (the page was opened)
const ICON: Record<Trade, string> = {
  gym: 'M2.5 7.5a5.5 5.5 0 1 1 2.4 4.5L2.5 13l.9-2.6a5.5 5.5 0 0 1-.9-2.9ZM6 7.5l1.5 1.5L10.5 6',
  dental: 'M8 2.5a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11ZM8 5v3l2 1.5',
  stores: 'M4.5 12.5h7a3 3 0 0 0 .4-6 4 4 0 0 0-7.7-.9A3.5 3.5 0 0 0 4.5 12.5ZM6.5 9.5l1.2 1.2 2.3-2.4',
  realestate: 'M1.5 8s2.4-4.5 6.5-4.5S14.5 8 14.5 8 12.1 12.5 8 12.5 1.5 8 1.5 8ZM8 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z',
};
const trades = ORDER.filter((x) => TRADES_PAGES.includes(x)).map((id) => ({ id, color: PRODUCT[id].color, url: href(lang, id), demo: productLinks(id, lang).demo, ...H.trades[id] }));
const N = trades.length;
// where each phone stands: 0 in front, 1 leaning out after it, 2 before it, 3 hidden behind
const relOf = (i: number) => (i === 0 ? 0 : i === 1 ? 1 : i === N - 1 ? 2 : 3);
// the drum: each word STEP degrees round from the next; the first paint already shows the first business in front
const STEP = 40;
const around = (i: number) => (i >= N / 2 ? i - N : i);
const wordStyle = (i: number, color: string) => {
  const d = around(i), a = Math.abs(d);
  return `--c:${color};--w:${Math.round(100 * Math.max(0, 1 - a * 1.4))}%;transform:rotateX(${-d * STEP}deg) translateZ(var(--r));opacity:${Math.max(0, 1 - a * 0.62).toFixed(2)};${a > 1.7 ? 'visibility:hidden;' : ''}`;
};
const title = s.home.title.replace(/\.$/, '');
---
<section class="hs" data-hs style={`--acc:${trades[0].color}`}>
  <div class="hs-wrap wrap">
    <div class="hs-top">
      <p class="eyebrow rise">{s.home.eyebrow}</p>
      <h1 class="hs-title rise rise-2">{title}<span class="hs-dot">.</span></h1>
      <p class="hs-sub rise rise-3">{H.sub}</p>

      <div class="hs-pick rise rise-4">
        <span class="hs-irun" id="hs-irun">{H.iRun}</span>
        <div class="hs-wheel" role="radiogroup" aria-labelledby="hs-irun" data-wheel style={`--step:${STEP}`}>
          <div class="hs-drum">
            {trades.map((x, i) => (
              <button type="button" role="radio" class="hs-word" data-i={i} data-url={x.url} data-demo={x.demo} data-color={x.color}
                aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} style={wordStyle(i, x.color)}><span class="t">{x.pick}</span></button>
            ))}
          </div>
          <span class="hs-line" aria-hidden="true"><i></i></span>
        </div>
      </div>
    </div>

    <div class="hs-stage" aria-hidden="true">
      <div class="hs-glow"></div>
      <span class="hs-mark"><Mark /></span>
      {trades.map((x, i) => (
        <figure class="hs-phone" data-i={i} data-rel={relOf(i)} style={`--c:${x.color}`}>
          <img src={`/images/${SHOT[x.id]}-${lang}-420.webp`} srcset={`/images/${SHOT[x.id]}-${lang}-420.webp 420w, /images/${SHOT[x.id]}-${lang}-840.webp 840w`}
               sizes="(min-width: 1024px) 250px, 48vw" width="420" height="909" alt="" decoding="async" fetchpriority={i === 0 ? 'high' : undefined} />
        </figure>
      ))}
      {trades.map((x, i) => (
        <div class:list={['hs-toast', i === 0 && 'on']} data-i={i} style={`--c:${x.color}`}>
          <span class="hs-toast-ic"><svg viewBox="0 0 16 16"><path d={ICON[x.id]} /></svg></span>
          <span><b>{x.toast[0]}</b><small>{x.toast[1]}</small></span>
        </div>
      ))}
    </div>
    <div class="hs-bot">
      <div class="hs-cta rise rise-5">
        <a class="btn hs-go" href={trades[0].url} data-go>
          {trades.map((x, i) => <span class:list={['hs-go-t', i === 0 && 'on']} aria-hidden={i === 0 ? undefined : 'true'}>{x.see}</span>)}
          <span class="arr" aria-hidden="true">→</span>
        </a>
        <a class="btn btn-secondary" href={trades[0].demo} data-try rel="noopener">{s.product.demo}</a>
      </div>

      <ul class="hs-facts rise rise-5">{H.facts.map((f) => <li>{f}</li>)}</ul>
    </div>

  </div>

  <p class="hs-else wrap rise rise-5">
    <span>{H.else}</span>
    <a href={TOOLS_URL} rel="noopener">{H.tools}</a>
    <span aria-hidden="true">·</span>
    <a href={`${studioUrl(lang)}#build`} rel="noopener">{H.studio}</a>
    <span aria-hidden="true">·</span>
    <a href="#branches">{H.all}</a>
  </p>
</section>

<script>
  function init() {
    const root = document.querySelector<HTMLElement>('[data-hs]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const words = [...root.querySelectorAll<HTMLButtonElement>('.hs-word')];
    const wheel = root.querySelector<HTMLElement>('[data-wheel]')!, line = wheel.querySelector<HTMLElement>('.hs-line')!, bar = line.querySelector('i')!;
    const N = words.length, STEP = Number(wheel.style.getPropertyValue('--step')) || 40;
    const wrap = (x: number) => { let d = ((x % N) + N) % N; if (d >= N / 2) d -= N; return d; };
    const mod = (x: number) => ((x % N) + N) % N;
    const phones = [...root.querySelectorAll<HTMLElement>('.hs-phone')];
    const toasts = [...root.querySelectorAll<HTMLElement>('.hs-toast')];
    const goT = [...root.querySelectorAll<HTMLElement>('.hs-go-t')];
    const go = root.querySelector<HTMLAnchorElement>('[data-go]')!, demo = root.querySelector<HTMLAnchorElement>("[data-try]")!;
    const data = words.map((p) => ({ url: p.dataset.url!, demo: p.dataset.demo!, color: p.dataset.color! }));
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cur = 0, auto = !still, timer = 0, seen = true;

    // ---- the drum: `p` is where it stands (a float, any number of turns), `target` where it is going ----
    let p = 0, target = 0, v = 0, raf = 0, last = 0;
    const paint = () => {
      const blur = Math.min(2.2, Math.abs(v) * 0.7);
      words.forEach((w, k) => {
        const d = wrap(k - p), a = Math.abs(d);
        w.style.transform = `rotateX(${-d * STEP}deg) translateZ(var(--r))`;
        w.style.opacity = String(Math.max(0, 1 - a * 0.62));
        w.style.setProperty('--w', `${Math.round(100 * Math.max(0, 1 - a * 1.4))}%`);
        w.style.visibility = a > 1.7 ? 'hidden' : '';
        w.style.filter = blur > 0.15 && a < 1.7 ? `blur(${blur.toFixed(2)}px)` : '';
      });
    };
    // a critically damped spring: it glides to the word and stops, no bounce
    const frame = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000 || 1 / 60); last = now;
      const k = 75, c = 2 * Math.sqrt(k);
      v += ((target - p) * k - v * c) * dt; p += v * dt;
      if (Math.abs(target - p) < 0.0008 && Math.abs(v) < 0.003) { p = target; v = 0; paint(); raf = 0; return; }
      paint(); raf = requestAnimationFrame(frame);
    };
    const run = () => { if (still) { p = target; v = 0; paint(); return; } if (!raf) { last = performance.now(); raf = requestAnimationFrame(frame); } };
    // the hairline under the front word: as wide as the word, filling while the hero turns on its own
    const measure = () => {
      const widths = words.map((w) => (w.firstElementChild as HTMLElement).offsetWidth);
      wheel.style.setProperty('--ww', `${Math.ceil(Math.max(...widths)) + 6}px`);
      line.style.setProperty('--lw', `${widths[cur]}px`);
    };

    const show = (i: number) => {
      cur = mod(i);
      root.style.setProperty('--acc', data[cur].color);
      words.forEach((w, k) => { w.setAttribute('aria-checked', String(k === cur)); w.tabIndex = k === cur ? 0 : -1; });
      const n = phones.length;
      phones.forEach((p, k) => { const d = (k - cur + n) % n; p.dataset.rel = String(d === 0 ? 0 : d === 1 ? 1 : d === n - 1 ? 2 : 3); });
      measure();
      toasts.forEach((x, k) => x.classList.toggle('on', k === cur));
      goT.forEach((x, k) => { x.classList.toggle('on', k === cur); x.toggleAttribute('aria-hidden', k !== cur); });
      go.href = data[cur].url; demo.href = data[cur].demo;
    };
    /** Turn the drum to an absolute position (any number of turns), and show that business. */
    const turnTo = (to: number) => { target = to; show(to); run(); };
    /** Turn to business i the short way round. */
    const turnToIndex = (i: number) => turnTo(target + Math.round(wrap(i - target)));
    // turning on its own: one business every few seconds, the hairline filling under the word
    const tick = () => {
      clearTimeout(timer);
      root.classList.toggle('auto', auto && seen);
      if (!auto || !seen) return;
      bar.getAnimations().forEach((a) => (a.currentTime = 0));
      timer = window.setTimeout(() => { turnTo(target + 1); tick(); }, 5200);
    };
    const pick = (i: number) => { auto = false; tick(); turnToIndex(i); };
    const nudge = (by: number) => { auto = false; tick(); turnTo(target + by); };

    let dragged = false;
    words.forEach((w, i) => w.addEventListener('click', () => { if (!dragged) pick(i); }));
    // the keyboard: a radio group, so the arrows turn it (and the focus follows the word in front)
    wheel.addEventListener('keydown', (e) => {
      const by = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
      if (!by) return;
      e.preventDefault(); nudge(by); words[cur].focus({ preventScroll: true });
    });
    // a mouse can drag the drum up and down (fingers scroll the page; they tap a word or swipe the phones)
    let y0w = 0, p0 = 0, vy = 0, ly = 0, lt = 0, held = false;
    wheel.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      held = true; dragged = false; y0w = ly = e.clientY; lt = performance.now(); p0 = p; vy = 0;
    });
    wheel.addEventListener('pointermove', (e) => {
      if (!held) return;
      const row = parseFloat(getComputedStyle(wheel).fontSize) * 1.3;
      if (!dragged && Math.abs(e.clientY - y0w) > 4) { dragged = true; wheel.setPointerCapture(e.pointerId); wheel.classList.add('grab'); cancelAnimationFrame(raf); raf = 0; auto = false; tick(); }
      if (!dragged) return;
      const now = performance.now();
      vy = (ly - e.clientY) / row / Math.max(0.008, (now - lt) / 1000); ly = e.clientY; lt = now;
      p = p0 - (e.clientY - y0w) / row; v = vy; paint();
    });
    const release = () => {
      if (!held) return;
      held = false; wheel.classList.remove('grab');
      if (dragged) { v = vy; turnTo(Math.round(p + vy * 0.12)); setTimeout(() => (dragged = false), 0); }
    };
    wheel.addEventListener('pointerup', release);
    wheel.addEventListener('pointercancel', release);
    phones.forEach((p) => p.addEventListener('click', () => pick(Number(p.dataset.i))));
    // a sideways swipe over the phones moves to the next business
    let x0 = 0, y0 = 0;
    const stage = root.querySelector<HTMLElement>('.hs-stage')!;
    stage.addEventListener('pointerdown', (e) => { x0 = e.clientX; y0 = e.clientY; });
    stage.addEventListener('pointerup', (e) => {
      const dx = e.clientX - x0, dy = e.clientY - y0;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.4) pick(cur + (dx < 0 ? 1 : -1) * (document.documentElement.dir === 'rtl' ? -1 : 1));
    });
    const io = new IntersectionObserver(([e]) => { seen = e.isIntersecting && !document.hidden; tick(); });
    io.observe(root);
    const vis = () => { seen = !document.hidden; tick(); };
    document.addEventListener('visibilitychange', vis);
    const ro = new ResizeObserver(measure);
    ro.observe(wheel);
    document.fonts?.ready.then(measure);
    document.addEventListener('astro:before-swap', () => { clearTimeout(timer); cancelAnimationFrame(raf); io.disconnect(); ro.disconnect(); document.removeEventListener('visibilitychange', vis); }, { once: true });
    measure();
    requestAnimationFrame(() => line.classList.add('ready')); // the hairline glides from now on, not on first paint
    tick();
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  @property --acc { syntax: '<color>'; inherits: true; initial-value: #E4572E; }
  .hs { position: relative; overflow: clip; padding-block: 2.5rem 1rem; transition: --acc .8s var(--ease-soft); }
  .hs-wrap { display: grid; gap: 1.75rem; }
  @media (min-width: 1024px) {
    .hs { padding-block: 4.5rem 1.5rem; }
    .hs-wrap { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); grid-template-areas: "top stage" "bot stage"; gap: 0 2rem; }
    .hs-top { grid-area: top; align-self: end; } .hs-bot { grid-area: bot; align-self: start; } .hs-stage { grid-area: stage; align-self: center; }
  }

  /* the words */
  .hs-top, .hs-bot { text-align: center; }
  @media (min-width: 1024px) { .hs-top, .hs-bot { text-align: start; } }
  .hs-title { margin-top: .7rem; font-size: clamp(2.9rem, 11vw, 6.25rem); line-height: 1.02; letter-spacing: -.045em; font-weight: 600; }
  :global(html[lang="ar"]) .hs-title { font-size: clamp(3rem, 12vw, 6rem); line-height: 1.2; letter-spacing: 0; }
  .hs-dot { color: var(--acc); }
  .hs-sub { max-width: 34rem; margin: 1.1rem auto 0; font-size: clamp(1rem, 1.6vw, 1.25rem); line-height: 1.55; color: var(--fg-2); text-wrap: pretty; }
  @media (min-width: 1024px) { .hs-sub { margin-inline: 0; } }

  /* "I run a ___": the sentence, and the blank is a wheel. A small 3D drum (the words stand on a cylinder STEP degrees
     apart, pushed out by --r), seen through a soft fade at the top and bottom; the word in front in its business's colour */
  .hs-pick { display: flex; flex-direction: column; align-items: center; gap: 0; margin-top: 1.6rem; font-size: clamp(1.7rem, 7vw, 2.3rem); }
  @media (min-width: 1024px) { .hs-pick { flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: start; column-gap: .42em; margin-top: 1.9rem; font-size: clamp(1.7rem, 2.5vw, 2.3rem); } }
  .hs-irun { font-weight: 500; color: var(--fg-2); white-space: nowrap; letter-spacing: -.02em; line-height: 1.3; }
  :global(html[lang="ar"]) .hs-irun { letter-spacing: 0; }
  .hs-wheel { --r: 1.79em; position: relative; width: 100%; height: 3.5em; perspective: 9em; touch-action: pan-y; user-select: none; -webkit-user-select: none;
    -webkit-mask-image: linear-gradient(transparent, #000 30%, #000 70%, transparent); mask-image: linear-gradient(transparent, #000 30%, #000 70%, transparent); }
  @media (min-width: 1024px) { .hs-wheel { width: var(--ww, 9em); cursor: grab; } .hs-wheel.grab { cursor: grabbing; } }
  .hs-drum { position: absolute; inset: 0; transform-style: preserve-3d; transform: translateZ(calc(var(--r) * -1)); }
  .hs-word { position: absolute; inset-inline: 0; top: 50%; height: 1.3em; margin-top: -.65em; padding: 0; line-height: 1.3em; text-align: center; white-space: nowrap;
    font-weight: 600; letter-spacing: -.03em; backface-visibility: hidden; color: color-mix(in oklab, var(--c) var(--w, 0%), var(--muted)); cursor: pointer; will-change: transform, opacity; }
  :global(html[lang="ar"]) .hs-word { letter-spacing: 0; font-weight: 700; }
  @media (min-width: 1024px) { .hs-word { text-align: start; } }
  .hs-word .t { display: inline-block; }
  .hs-word[aria-checked="true"] { cursor: default; }
  .hs-word:focus-visible { outline: none; }
  .hs-word:focus-visible .t { outline: 2px solid var(--c); outline-offset: 6px; border-radius: 6px; }
  /* the hairline under the word in front: as wide as the word, and it fills while the hero turns on its own */
  .hs-line { position: absolute; top: calc(50% + .68em); left: 50%; width: var(--lw, 3em); height: 2px; border-radius: 2px; overflow: hidden; translate: -50% 0;
    background: color-mix(in oklab, var(--acc) 20%, transparent); pointer-events: none; }
  @media (min-width: 1024px) { .hs-line { left: auto; inset-inline-start: 0; translate: none; } }
  .hs-line.ready { transition: width .55s var(--ease-soft); }
  .hs-line i { position: absolute; inset: 0; background: var(--acc); transform: scaleX(0); transform-origin: left; }
  :global(html[dir="rtl"]) .hs-line i { transform-origin: right; }
  .hs.auto .hs-line i { animation: hs-fill 5.2s linear both; }
  @keyframes hs-fill { to { transform: scaleX(1); } }

  .hs-cta { display: flex; flex-wrap: wrap; justify-content: center; gap: .75rem; }
  @media (min-width: 1024px) { .hs-cta { margin-top: 1.75rem; } }
  @media (min-width: 1024px) { .hs-cta { justify-content: start; } }
  .hs-go { position: relative; background: var(--invert); color: var(--on-invert); }
  .hs-go:hover { opacity: .88; }
  /* the three button texts share one place, so the button never jumps when the words change */
  .hs-go { display: inline-grid; grid-auto-flow: column; }
  .hs-go-t { grid-area: 1 / 1; opacity: 0; transform: translateY(6px); transition: opacity .3s, transform .4s var(--ease-soft); }
  .hs-go-t.on { opacity: 1; transform: none; }
  .hs-go .arr { grid-area: 1 / 2; margin-inline-start: .5rem; transition: transform .2s var(--ease-soft); }
  .hs-go:hover .arr { transform: translateX(3px); }
  :global(html[dir="rtl"]) .hs-go .arr { transform: scaleX(-1); }
  :global(html[dir="rtl"]) .hs-go:hover .arr { transform: scaleX(-1) translateX(3px); }

  .hs-facts { display: flex; flex-wrap: wrap; justify-content: center; gap: .4rem 1.1rem; margin-top: 1.6rem; font-size: .875rem; color: var(--muted); }
  @media (min-width: 1024px) { .hs-facts { justify-content: start; } }
  .hs-facts li { display: inline-flex; align-items: center; gap: .45rem; }
  .hs-facts li::before { content: ""; width: .4rem; height: .4rem; border-radius: 50%; background: var(--acc); }

  /* the phones: the chosen one in front, the other two leaning out behind it */
  .hs-stage { --pw: clamp(10.5rem, 42vw, 15.5rem); position: relative; height: calc(var(--pw) * 2.164 + 2rem); touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  .hs-glow { position: absolute; inset: 10% 5% 0; border-radius: 50%; background: radial-gradient(closest-side, color-mix(in oklab, var(--acc) 30%, transparent), transparent); filter: blur(24px); opacity: .8; }
  /* the founder's H, huge and faint behind the phones, in the chosen business's colour */
  .hs-mark { position: absolute; left: 50%; top: 50%; height: 104%; translate: -50% -50%; color: var(--acc); opacity: .09; }
  .hs-mark :global(svg) { display: block; height: 100%; width: auto; }
  @media (prefers-color-scheme: dark) { .hs-mark { opacity: .1; } .hs-glow { opacity: .6; } }
  .hs-phone { --x: 0; --s: 1; position: absolute; left: 50%; top: 1rem; width: var(--pw); margin: 0; cursor: pointer; border-radius: calc(var(--pw) * .15); border: calc(var(--pw) * .028) solid #0B0F16; background: #0B0F16; overflow: hidden;
    box-shadow: 0 40px 70px -30px rgb(11 15 22 / .55), 0 0 0 1px rgb(255 255 255 / .06);
    transform: translateX(calc(-50% + var(--x) * var(--s) * 58%)) scale(var(--k, 1)) rotate(calc(var(--x) * var(--s) * 6deg));
    transition: transform .9s var(--ease-soft), filter .6s, opacity .6s; }
  :global(html[dir="rtl"]) .hs-phone { --s: -1; }
  .hs-phone img { display: block; width: 100%; height: auto; border-radius: calc(var(--pw) * .12); }
  .hs-phone[data-rel="0"] { z-index: 3; cursor: default; }
  .hs-phone[data-rel="1"] { --x: 1; --k: .82; z-index: 2; filter: saturate(.7) brightness(.92); }
  .hs-phone[data-rel="2"] { --x: -1; --k: .82; z-index: 1; filter: saturate(.7) brightness(.92); }
  .hs-phone[data-rel="3"] { --k: .66; z-index: 0; opacity: 0; pointer-events: none; }
  @media (prefers-color-scheme: dark) { .hs-phone[data-rel="1"], .hs-phone[data-rel="2"] { filter: saturate(.6) brightness(.6); } }
  @media (hover: hover) { .hs-phone:not([data-rel="0"]):hover { filter: none; } }

  /* one small moment from the chosen system, floating by its phone */
  .hs-toast { position: absolute; z-index: 4; inset-inline-start: 50%; bottom: 14%; display: flex; align-items: center; gap: .65rem; white-space: nowrap; padding: .7rem 1.1rem .7rem .7rem; border-radius: 1.1rem;
    background: color-mix(in oklab, var(--surface) 88%, transparent); -webkit-backdrop-filter: blur(16px) saturate(1.4); backdrop-filter: blur(16px) saturate(1.4); border: 1px solid var(--line);
    box-shadow: 0 1px 2px rgb(14 20 32 / .06), 0 20px 40px -18px rgb(14 20 32 / .35); text-align: start;
    translate: calc(var(--pw) * -.95) 0; opacity: 0; transform: translateY(12px) scale(.96); transition: opacity .35s, transform .5s var(--ease-soft); pointer-events: none; }
  :global(html[dir="rtl"]) .hs-toast { translate: calc(var(--pw) * .95) 0; }
