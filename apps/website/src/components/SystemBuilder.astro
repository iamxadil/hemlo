  .wa b { display: block; font-size: .78em; font-weight: 600; } .wa small { display: block; font-size: .64em; color: var(--wa); }
  .chat { position: relative; flex: 1; display: flex; flex-direction: column; justify-content: flex-end; gap: .4em; padding: .6em .5em 1em; }
  .b { margin: 0; max-width: 88%; padding: .45em .6em; border-radius: .8em; font-size: .7em; line-height: 1.4; box-shadow: 0 1px 0 rgb(0 0 0 / .06); opacity: 0; transform: translateY(.5em); }
