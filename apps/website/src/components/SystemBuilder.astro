    .mbox { margin-top: .9rem; border-radius: .85rem; overflow: hidden; background: var(--canvas); box-shadow: inset 0 0 0 1px var(--line); font-size: 15px; }
    .mbar { display: flex; justify-content: center; padding: .45rem; border-bottom: 1px solid var(--line); background: var(--sunken); }
