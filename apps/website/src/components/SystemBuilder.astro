  .sbd { margin: auto; inset: 0; width: min(32rem, calc(100vw - 2rem)); max-height: calc(100dvh - 2rem); overflow: auto; padding: 1.8rem; border: 0; border-radius: 1.4rem; background: var(--surface); color: var(--fg); box-shadow: 0 40px 90px -30px rgb(14 20 32 / .5); }
  .sbd::backdrop { background: rgb(14 20 32 / .45); backdrop-filter: blur(4px); }
