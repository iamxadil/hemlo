  .b.typing i { width: .38em; height: .38em; border-radius: 50%; background: #9AA0A6; animation: sb-dot 1s ease-in-out infinite; } .b.typing i:nth-child(2) { animation-delay: .15s } .b.typing i:nth-child(3) { animation-delay: .3s }
