---
// "Build your Hemlo", for one system (an agency's, a shop's; more as the add-ons reach them): the system first, always on, and the add-ons that plug into it. Switch Website or Connect on and
// watch it attach to the system and start working (the system itself gains a line for it), while the month's total
// counts to its new figure. Connect comes in three tiers: Basic (free with the system), Pro (the AI assistant) and AI Studio
// (marketing). One request for the whole setup. Prices come from the API (as the pricing cards do), with today's list as the fallback.
// Plain CSS transitions driven by data attributes on the root, one small script; reduced motion keeps only fades.
import Mark from './Mark.astro';
import HwBadge from './HwBadge.astro';
import { API_URL, SYSTEM_URL, type Lang } from '../i18n/strings';
interface Props { lang: Lang; system?: 'realestate' | 'store' }
const { lang, system = 'realestate' } = Astro.props;
const shop = system === 'store';
const ar = lang === 'ar';

// ---- prices: the API's, or the list as of October 2026 ----
type Price = { code: string; name: Record<string, string>; priceMonth: number };
let plans: Price[] = [], addons: Price[] = [];
try {
  const [p, a] = await Promise.all([`/v1/plans?edition=${system}`, `/v1/plans/addons?edition=${system}`].map((u) => fetch(API_URL + u, { signal: AbortSignal.timeout(6000) }).then((r) => r.json())));
  plans = p.plans ?? []; addons = a.addons ?? [];
} catch { /* the fallback below */ }
const PLAN_FALLBACK = shop ? [['starter', 'البداية', 'Starter', 15000], ['growth', 'النمو', 'Growth', 29000], ['business', 'الأعمال', 'Business', 49000]] as const
  : [['office', 'المكتب', 'Office', 40000], ['agency', 'الوكالة', 'Agency', 69000], ['group', 'المجموعة', 'Group', 129000]] as const;
const PLANS = plans.length ? plans.map((p) => ({ code: p.code, name: p.name[lang] ?? p.name.en, price: p.priceMonth }))
  : PLAN_FALLBACK.map(([code, a, e, price]) => ({ code, name: ar ? a : e, price }));
const addon = (code: string, fb: number) => addons.find((x) => x.code === code)?.priceMonth ?? fb;
const PRICE = { web: addon('website', 10000), basic: addon('connect', 0), pro: addon('connect-pro', shop ? 25000 : 35000), studio: addon('ai-studio', shop ? 35000 : 50000) };
const start = Math.max(0, PLANS.findIndex((p) => p.code === (shop ? 'growth' : 'agency')));

const BASE = ar ? {
  sys: { kind: 'نظامك', name: 'Hemlo العقارات', line: 'العقارات والزبائن والمعاينات والصفقات، في مكان واحد.', always: 'يعمل دائماً', plan: 'الخطة' },
  web: { kind: 'إضافة', line: 'عقاراتك على موقعك الخاص، محدّثة وحدها.' },
  con: { kind: 'مع نظامك', line: 'واتساب يرد ويذكّر ويتابع عنك. الرسائل مشمولة.', basic: 'Basic', pro: 'Pro', studio: 'AI Studio', free: 'مجاني',
    notes: { basic: 'مجاني مع نظامك: صندوق المحادثات، والتذكيرات، وتنبيهات العقارات الجديدة', pro: 'مساعد ذكي يرد من عقاراتك ويحجز المعاينات', studio: 'كل ما في Pro، وحملات تسويقية وتصاميم وخطة محتوى بالذكاء الاصطناعي' } },
  on: 'مفعّل', add: 'أضف',
  total: 'شهرك', per: 'د.ع / شهرياً',
  trial: 'نظامك مجاني ٣٠ يوماً. الدفع شهرياً أو سنوياً (شهران مجاناً).', cta: 'ابدأ بهذا الإعداد', ctaShort: 'ابدأ', sample: 'شاهد موقعاً نموذجياً',
  already: 'مشترك في Hemlo؟ فعّل الإضافات من صفحة «الخطة» في نظامك.',
  stats: [['٢٤', 'عقاراً'], ['٧', 'زبائن جدد'], ['٣', 'معاينات اليوم']], webStat: ['١٢٨', 'زيارة لموقعك اليوم'], conStat: ['٤٢', 'رداً على واتساب'],
  url: 'nakheel.hemlohq.com', tiles: [['فيلا · دريم ستي', '$265,000'], ['شقة · عنكاوة', '$900'], ['بيت · المنصور', '$410,000']],
  webToast: 'نُشر على موقعك', conToast: 'رُدّ خلال ٣ ثوانٍ', agency: 'دار النخيل', online: 'متصل',
  q: 'هل فيلا دريم ستي ما زالت متاحة؟', a: 'نعم! ٤ غرف وحديقة، $265,000. هل يناسبك السبت الساعة ٥ للمعاينة؟', tagBasic: 'رد سريع', tagPro: '✦ المساعد · ٢٤ ساعة',
  ghostWeb: '+ Website', ghostCon: '+ Connect',
  form: { title: 'ابدأ مع Hemlo', sub: 'اترك رقمك، ويتصل بك فريق Hemlo خلال يوم عمل ليجهّزه معك.', name: 'اسمك', business: 'اسم المكتب', phone: 'رقم الهاتف', city: 'المدينة',
    send: 'أرسل الطلب', sending: 'يُرسل…', done: 'وصل طلبك. سنتصل بك قريباً.', failed: 'لم يُرسل. تأكد من الرقم وحاول مجدداً.', close: 'إغلاق' },
} : {
  sys: { kind: 'Your system', name: 'Hemlo Real Estate', line: 'Properties, leads, viewings and deals, in one place.', always: 'Always on', plan: 'Plan' },
  web: { kind: 'Add-on', line: 'Your properties on your own site, updated by themselves.' },
  con: { kind: 'With your system', line: 'WhatsApp that answers, reminds and follows up for you. Messaging included.', basic: 'Basic', pro: 'Pro', studio: 'AI Studio', free: 'Free',
    notes: { basic: 'Free with your system: the team inbox, reminders, and new-listing alerts', pro: 'An AI assistant that answers from your listings and books viewings', studio: 'Everything in Pro, plus AI campaigns, post designs and a content plan' } },
  on: 'On', add: 'Add',
  total: 'Your month', per: 'IQD / month',
  trial: 'Your system is free for 30 days. Pay monthly or yearly (two months free).', cta: 'Start with this setup', ctaShort: 'Start', sample: 'See a sample site',
  already: 'Already on Hemlo? Switch add-ons on from the Plan page in your system.',
  stats: [['24', 'properties'], ['7', 'new leads'], ['3', 'viewings today']], webStat: ['128', 'visits to your site today'], conStat: ['42', 'WhatsApp replies'],
  url: 'nakheel.hemlohq.com', tiles: [['Villa · Dream City', '$265,000'], ['Flat · Ankawa', '$900'], ['House · Mansour', '$410,000']],
  webToast: 'Published on your site', conToast: 'Replied in 3 s', agency: 'Nakheel', online: 'online',
  q: 'Is the Dream City villa still available?', a: 'Yes! 4 bedrooms and a garden, $265,000. Would Saturday at 5 suit a viewing?', tagBasic: 'Quick reply', tagPro: '✦ Assistant · 24/7',
  ghostWeb: '+ Website', ghostCon: '+ Connect',
  form: { title: 'Start with Hemlo', sub: 'Leave your number, and Hemlo’s team will call within a working day to set it up with you.', name: 'Your name', business: 'Office name', phone: 'Phone number', city: 'City',
    send: 'Send', sending: 'Sending…', done: 'Got it. We’ll call you soon.', failed: 'Not sent. Check the number and try again.', close: 'Close' },
};
// a shop's words, laid over the agency's
const SHOP_C = ar ? {
  sys: { kind: 'نظامك', name: 'Hemlo المتاجر', line: 'الكاشير والبضاعة ودفتر الديون والطلبات، في مكان واحد.', always: 'يعمل دائماً', plan: 'الخطة' },
  web: { kind: 'إضافة', line: 'متجرك على الإنترنت: منتجاتك وأسعارك، سلة ودفع عند الاستلام، والطلبات تصلك في النظام.' },
  con: { ...BASE.con, notes: { basic: 'مجاني مع نظامك: صندوق المحادثات، وتحديثات الطلبات، وتذكير الديون', pro: 'مساعد ذكي يرد من منتجاتك وأسعارك ومخزونك', studio: 'كل ما في Pro، وحملات تسويقية وتصاميم وخطة محتوى من منتجاتك' } },
  stats: [['٤٣', 'منتجاً'], ['٣٣', 'فاتورة اليوم'], ['٥', 'ديون مستحقة']], webStat: ['٦', 'طلبات من موقعك اليوم'], conStat: ['٣١', 'رداً على واتساب'],
  url: 'nafha.hemlohq.com', tiles: [['عنبر الليل', '85,000'], ['ورد الطائف', '65,000'], ['صندوق هدية', '150,000']],
  webToast: 'طلب جديد من موقعك', conToast: 'رُدّ خلال ٣ ثوانٍ', agency: 'نفحة', mono: 'ن',
  q: 'عندكم عطر عنبر الليل؟ وكم سعره؟', a: 'نعم متوفر بـ 85,000 د.ع. تقدر تطلبه من موقعنا والدفع عند الاستلام، ويوصلك اليوم داخل بغداد.',
  sample: 'شاهد متجراً نموذجياً', form: { ...BASE.form, business: 'اسم المتجر' },
} : {
  sys: { kind: 'Your system', name: 'Hemlo Stores', line: 'The till, stock, the debt book and orders, in one place.', always: 'Always on', plan: 'Plan' },
  web: { kind: 'Add-on', line: 'Your shop online: your products and prices, a cart and cash on delivery, and the orders arrive in your system.' },
  con: { ...BASE.con, notes: { basic: 'Free with your system: the team inbox, order updates and debt reminders', pro: 'An AI assistant that answers from your products, prices and stock', studio: 'Everything in Pro, plus AI campaigns, post designs and a content plan from your products' } },
  stats: [['43', 'products'], ['33', 'receipts today'], ['5', 'debts due']], webStat: ['6', 'orders from your site today'], conStat: ['31', 'WhatsApp replies'],
  url: 'nafha.hemlohq.com', tiles: [['Amber Night', '85,000'], ['Taif Rose', '65,000'], ['Gift box', '150,000']],
  webToast: 'New order from your site', conToast: 'Replied in 3 s', agency: 'Nafha', mono: 'N',
  q: 'Do you have Amber Night? How much is it?', a: 'Yes, it’s in stock at 85,000 IQD. You can order it on our website with cash on delivery, and it reaches you today in Baghdad.',
  sample: 'See a sample shop', form: { ...BASE.form, business: 'Shop name' },
};
const C = shop ? { ...BASE, ...SHOP_C } : { ...BASE, mono: ar ? 'ن' : 'N' };
const nf = new Intl.NumberFormat('en-US');
const sampleHref = shop ? `https://business.hemlohq.com/s/sample-shop${ar ? '' : '?lang=en'}` : ar ? 'https://business.hemlohq.com/s/sample' : 'https://business.hemlohq.com/s/sample?lang=en';
const tileImg = shop ? ['/images/stores/shop/amber.webp', '/images/stores/shop/rose.webp', '/images/stores/shop/gift-box.webp'] : ['villa-3', 'apartment-1', 'villa-4'].map((x) => `/images/realestate/sample/${x}.webp`);
const DATA = { plans: PLANS, price: PRICE, names: { web: 'Website', basic: 'Connect Basic', pro: 'Connect Pro', studio: 'AI Studio' }, free: C.con.free };
const plus = (n: number) => (n ? `+${nf.format(n)}` : C.con.free);
---
<div class:list={['sb', shop && 'is-shop']} data-sb data-ed={system} data-web="off" data-con="off" data-tier="basic" data-api={API_URL} data-lang={lang} data-model={JSON.stringify(DATA)} data-notes={JSON.stringify(C.con.notes)}>
  <div class="sb-grid">

    <!-- the picture: the system in the middle; what's switched on plugs into it and starts working -->
    <div class="sb-stage" aria-hidden="true">
      <svg class="sb-wires" viewBox="0 0 600 460" preserveAspectRatio="none">
        <g class="w" data-w="web"><path class="base" d="M150 168 C150 196 196 196 196 222" pathLength="100" /><path class="live" d="M150 168 C150 196 196 196 196 222" pathLength="100" /><path class="pulse" d="M196 222 C196 196 150 196 150 168" pathLength="100" /></g>
        <g class="w" data-w="con"><path class="base" d="M406 300 C424 300 420 262 436 262" pathLength="100" /><path class="live" d="M406 300 C424 300 420 262 436 262" pathLength="100" /><path class="pulse" d="M406 300 C424 300 420 262 436 262" pathLength="100" /></g>
      </svg>

      <!-- the website -->
      <button type="button" class="sb-ghost g-web" data-toggle="web" tabindex="-1"><span>{C.ghostWeb}</span></button>
      <div class="sb-web">
        <div class="bar"><i></i><i></i><i></i><span class="u" dir="ltr">{C.url}</span></div>
        <div class="tiles">{C.tiles.map(([n, p], i) => <div class="tile" style={`--i:${i}`}><span class="ph" style={`background-image:url(${tileImg[i]})`}></span><b>{n}</b><em dir="ltr">{p}</em></div>)}</div>
        <span class="toast"><i>✓</i>{C.webToast}</span>
      </div>

      <!-- the system: always there -->
      <div class="sb-sys">
        <div class="hd"><span class="mk"><Mark /></span><span><b>{C.sys.name}</b><small data-plan-name>{PLANS[start]?.name}</small></span><span class="live"><i></i></span></div>
        <ul>
          {C.stats.map(([v, l]) => <li><b>{v}</b><span>{l}</span></li>)}
          <li class="add a-web"><b>{C.webStat[0]}</b><span>{C.webStat[1]}</span></li>
          <li class="add a-con"><b>{C.conStat[0]}</b><span>{C.conStat[1]}</span></li>
        </ul>
      </div>

      <!-- WhatsApp -->
      <button type="button" class="sb-ghost g-con" data-toggle="con" tabindex="-1"><span>{C.ghostCon}</span></button>
      <div class="sb-phone">
        <div class="scr">
          <div class="wa"><span class="av">{C.mono}</span><span><b>{C.agency}</b><small>{C.online}</small></span></div>
          <div class="chat">
            <p class="b me">{C.q}</p>
            <p class="b typing"><i></i><i></i><i></i></p>
            <p class="b them"><span class="tag"><span class="t-basic">{C.tagBasic}</span><span class="t-pro">{C.tagPro}</span></span>{C.a}</p>
          </div>
        </div>
        <span class="toast"><i>✓</i>{C.conToast}</span>
      </div>
    </div>

    <!-- the choices -->
    <div class="sb-ctl">
      <div class="layer sys-l">
        <div class="lh"><span class="lk">{C.sys.kind}</span><span class="always"><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>{C.sys.always}</span></div>
        <p class="ln"><b>{C.sys.name}</b></p><p class="ld">{C.sys.line}</p>
        <div class="seg" role="radiogroup" aria-label={C.sys.plan}>
          {PLANS.map((p, i) => <button type="button" role="radio" data-plan={i} aria-checked={i === start ? 'true' : 'false'}><b>{p.name}</b><small dir="ltr">{nf.format(p.price)}</small></button>)}
        </div>
      </div>

      <div class="layer" data-layer="web">
        <div class="lh"><span class="lk">{C.web.kind}</span><button type="button" class="sw" role="switch" aria-checked="false" data-toggle="web" aria-label="Hemlo Website"><i></i></button></div>
        <p class="ln"><HwBadge /><span class="pr" dir="ltr">+{nf.format(PRICE.web)}</span></p><p class="ld">{C.web.line}</p>
        <div class="mini mini-web" aria-hidden="true"><div class="mini-in"><div class="mbox"><div class="mbar"><span class="u" dir="ltr">{C.url}</span></div><div class="tiles">{C.tiles.map(([n, p], i) => <div class="tile" style={`--i:${i}`}><span class="ph" style={`background-image:url(${tileImg[i]})`}></span><b>{n}</b><em dir="ltr">{p}</em></div>)}</div></div><p class="mnote"><i>✓</i>{C.webToast}</p></div></div>
      </div>

      <div class="layer" data-layer="con">
        <div class="lh"><span class="lk">{C.con.kind}</span><button type="button" class="sw" role="switch" aria-checked="false" data-toggle="con" aria-label="Hemlo Connect"><i></i></button></div>
        <p class="ln"><HwBadge label="Connect" /><span class="pr" dir="auto" data-con-price>{plus(PRICE.basic)}</span></p><p class="ld">{C.con.line}</p>
        <div class="tier"><div class="tier-in">
          <div class="seg three" role="radiogroup" aria-label="Connect">
            {(['basic', 'pro', 'studio'] as const).map((k, i) => <button type="button" role="radio" data-tier={k} aria-checked={i === 0 ? 'true' : 'false'}><b>{C.con[k]}</b><small dir="auto">{PRICE[k] ? nf.format(PRICE[k]) : C.con.free}</small></button>)}
          </div>
          <p class="pro-note" data-tier-note>{C.con.notes.basic}</p>
        </div></div>
        <div class="mini mini-con" aria-hidden="true"><div class="mini-in"><div class="mchat">
          <p class="b me">{C.q}</p><p class="b typing"><i></i><i></i><i></i></p>
          <p class="b them"><span class="tag"><span class="t-basic">{C.tagBasic}</span><span class="t-pro">{C.tagPro}</span></span>{C.a}</p>
        </div><p class="mnote"><i>✓</i>{C.conToast}</p></div></div>
      </div>

      <div class="sb-total">
        <p class="tl">{C.total}</p>
        <p class="tv"><b data-total dir="ltr">{nf.format(PLANS[start]?.price ?? 0)}</b><span>{C.per}</span></p>
        <p class="tb" data-breakdown dir="auto"></p>
        <button type="button" class="btn btn-primary sb-go" data-start aria-label={C.cta}><span class="full">{C.cta}</span><span class="short">{C.ctaShort}</span><span class="arr" aria-hidden="true">→</span></button>
        <p class="tnote">{C.trial} <a class="link-quiet" href={sampleHref} target="_blank" rel="noopener">{C.sample}</a></p>
        <p class="tnote">{C.already}</p>
      </div>
      <p class="sb-notes">{C.trial} <a class="link-quiet" href={sampleHref} target="_blank" rel="noopener">{C.sample}</a><br />{C.already}</p>
    </div>
  </div>

  <dialog class="sbd" data-sbd>
    <form method="dialog" class="sbd-x"><button aria-label={C.form.close}>✕</button></form>
    <h3>{C.form.title}</h3><p class="sbd-sub">{C.form.sub}</p>
    <p class="sbd-sum" data-summary></p>
    <form class="sbd-f" data-sb-form>
      <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
      <div class="two"><label>{C.form.name}<input name="name" required maxlength="80" autocomplete="name" /></label><label>{C.form.business}<input name="business" required maxlength="100" autocomplete="organization" /></label></div>
      <div class="two"><label>{C.form.phone}<input name="phone" required inputmode="tel" dir="ltr" placeholder="07xx xxx xxxx" autocomplete="tel" /></label><label>{C.form.city}<input name="city" maxlength="60" /></label></div>
      <button class="btn btn-primary sbd-send" data-label={C.form.send} data-sending={C.form.sending}>{C.form.send}</button>
      <p class="sbd-msg" data-ok={C.form.done} data-bad={C.form.failed} aria-live="polite"></p>
    </form>
  </dialog>
</div>

<script>
  type Tier = 'basic' | 'pro' | 'studio';
  type Model = { plans: { code: string; name: string; price: number }[]; price: { web: number; basic: number; pro: number; studio: number }; names: Record<string, string>; free: string };
  for (const root of document.querySelectorAll<HTMLElement>('[data-sb]')) {
    const M: Model = JSON.parse(root.dataset.model!);
    const nf = new Intl.NumberFormat('en-US');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const planBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-plan]')], tierBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-tier]')].filter((b) => b.tagName === 'BUTTON');
    let plan = planBtns.findIndex((b) => b.getAttribute('aria-checked') === 'true'), web = false, con = false, tier: Tier = 'basic', shown = M.plans[plan]?.price ?? 0, raf = 0;
    const notes = JSON.parse(root.dataset.notes ?? '{}') as Record<Tier, string>;
    const plus = (n: number) => (n ? `+${nf.format(n)}` : M.free);

    // live prices, in case they changed after the page was built
    fetch(`${root.dataset.api}/v1/plans?edition=${root.dataset.ed}`).then((r) => r.json()).then(({ plans }) => {
      for (const p of plans ?? []) { const i = M.plans.findIndex((x) => x.code === p.code); if (i >= 0) M.plans[i].price = p.priceMonth; }
      planBtns.forEach((b, i) => { const s = b.querySelector('small'); if (s) s.textContent = nf.format(M.plans[i].price); }); render();
    }).catch(() => {});
    fetch(`${root.dataset.api}/v1/plans/addons?edition=${root.dataset.ed}`).then((r) => r.json()).then(({ addons }) => {
      const code: Record<string, keyof Model['price']> = { website: 'web', connect: 'basic', 'connect-pro': 'pro', 'ai-studio': 'studio' };
      for (const a of addons ?? []) if (code[a.code] && a.priceMonth != null) M.price[code[a.code]] = a.priceMonth;
      tierBtns.forEach((b) => { const s = b.querySelector('small'); if (s) s.textContent = M.price[b.dataset.tier as Tier] ? nf.format(M.price[b.dataset.tier as Tier]) : M.free; }); render();
    }).catch(() => {});

    const total = () => {
      const base = M.plans[plan]?.price ?? 0, w = web ? M.price.web : 0, c = con ? M.price[tier] : 0;
      return { base, w, c, sum: base + w + c };
    };
    const count = (to: number) => {
      cancelAnimationFrame(raf);
      const el = $('[data-total]'), from = shown, t0 = performance.now(), dur = still ? 0 : 520;
      const step = (t: number) => {
        const k = dur ? Math.min(1, (t - t0) / dur) : 1, e = 1 - Math.pow(1 - k, 3);
        shown = Math.round(from + (to - from) * e); el.textContent = nf.format(shown);
        if (k < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };
    const summary = () => {
      const t = total(), parts = [`${M.plans[plan].name} ${nf.format(t.base)}`];
      if (web) parts.push(`${M.names.web} ${nf.format(t.w)}`);
      if (con) parts.push(`${M.names[tier]} ${t.c ? nf.format(t.c) : M.free}`);
      return { t, parts };
    };
    const render = () => {
      const { t, parts } = summary();
      Object.assign(root.dataset, { web: web ? 'on' : 'off', con: con ? 'on' : 'off', tier });
      planBtns.forEach((b, i) => b.setAttribute('aria-checked', String(i === plan)));
      tierBtns.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.tier === tier)));
      $('[data-tier-note]').textContent = notes[tier] ?? '';
      root.querySelectorAll<HTMLElement>('[role="switch"]').forEach((s) => s.setAttribute('aria-checked', String(s.dataset.toggle === 'web' ? web : con)));
      $('[data-plan-name]').textContent = M.plans[plan].name;
      $('[data-con-price]').textContent = plus(M.price[tier]);
      const bd = $('[data-breakdown]'); bd.replaceChildren(...parts.flatMap((x, i) => { const el = document.createElement('bdi'); el.textContent = x; return i ? [document.createTextNode('  +  '), el] : [el]; }));
      count(t.sum);
    };
    root.querySelectorAll<HTMLElement>('[data-toggle]').forEach((b) => b.addEventListener('click', () => { if (b.dataset.toggle === 'web') web = !web; else con = !con; navigator.vibrate?.(8); render(); }));
    planBtns.forEach((b, i) => b.addEventListener('click', () => { plan = i; render(); }));
    tierBtns.forEach((b) => b.addEventListener('click', () => { tier = b.dataset.tier as Tier; render(); }));
    // arrow keys move within each radio group
    root.querySelectorAll<HTMLElement>('[role="radiogroup"]').forEach((g) => g.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key, items = [...g.querySelectorAll<HTMLButtonElement>('[role="radio"]')], i = items.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0 || !['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(k)) return;
      e.preventDefault(); const rtl = getComputedStyle(g).direction === 'rtl', fwd = k === 'ArrowDown' || k === (rtl ? 'ArrowLeft' : 'ArrowRight');
      const n = items[(i + (fwd ? 1 : -1) + items.length) % items.length]; n.focus(); n.click();
    }));
    render();

    // one request for the whole setup: lands in Hemlo's admin with the setup written into it
    const dlg = $<HTMLDialogElement>('[data-sbd]'), f = dlg.querySelector<HTMLFormElement>('[data-sb-form]')!, msg = f.querySelector<HTMLElement>('.sbd-msg')!, btn = f.querySelector<HTMLButtonElement>('.sbd-send')!;
    $('[data-start]').addEventListener('click', () => {
      const { t, parts } = summary();
      $('[data-summary]').textContent = `${parts.join(' + ')} = ${nf.format(t.sum)} IQD`;
      msg.textContent = ''; msg.className = 'sbd-msg'; dlg.showModal();
    });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const v = Object.fromEntries(new FormData(f)) as Record<string, string>;
      // the paid Connect tier if there is one (the full setup is in the note), else the Website, else Basic
      const interest = con && tier !== 'basic' ? (tier === 'pro' ? 'connect-pro' : 'ai-studio') : web ? 'website' : con ? 'connect' : undefined;
      btn.disabled = true; btn.textContent = btn.dataset.sending!;
      try {
        const res = await fetch(`${root.dataset.api}/v1/early-access`, { method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ...v, kind: root.dataset.ed === 'store' ? 'store' : 'realestate', interest, note: `[Setup] ${$('[data-summary]').textContent}`, locale: root.dataset.lang }) });
        if (!res.ok) throw new Error();
        msg.textContent = msg.dataset.ok!; msg.className = 'sbd-msg is-ok'; f.reset();
      } catch { msg.textContent = msg.dataset.bad!; msg.className = 'sbd-msg is-bad'; }
      finally { btn.disabled = false; btn.textContent = btn.dataset.label!; }
    });
  }
</script>

<style>
