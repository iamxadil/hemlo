---
// "Is this for you?": the same three answers on every branch page, in plain words.
import { BRANCH, type BranchId } from '../brand/brand';
import { t, type Lang } from '../i18n/strings';
interface Props { branch: BranchId; lang: Lang; fit: { what: string; when: string[]; not: string } }
const { branch, lang, fit } = Astro.props;
const L = t(lang).fit;
const b = BRANCH[branch];
---
<section class="wrap pb-20 sm:pb-24">
  <div class="fit reveal" style={`--c:${b.color};--cd:${b.dark};--t:${b.tint};--td:${b.tintDark}`}>
    <div class="what">
      <p class="label">{L.what}</p>
      <p class="mt-3 text-[clamp(1.2rem,2.1vw,1.5rem)] font-medium leading-snug">{fit.what}</p>
    </div>
    <div>
      <p class="label">{L.when}</p>
      <ul class="mt-3 grid gap-2.5">{fit.when.map((w) => <li class="flex items-start gap-3"><span class="tick" aria-hidden="true">✓</span><span class="leading-relaxed">{w}</span></li>)}</ul>
    </div>
    <div class="not">
      <p class="label">{L.not}</p>
      <p class="mt-3 leading-relaxed text-fg-2">{fit.not}</p>
    </div>
  </div>
</section>

<style>
  .fit { display: grid; gap: 2rem; padding: 2rem; border-radius: var(--radius-tile); background: var(--t); }
  @media (min-width: 960px) { .fit { grid-template-columns: 1.15fr 1.2fr 1fr; gap: 2.5rem; padding: 2.5rem; } }
  @media (prefers-color-scheme: dark) { .fit { background: var(--td); } }
  .label { font-size: .8rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--c); }
  :global(html[lang="ar"]) .label { text-transform: none; letter-spacing: 0; font-size: .9rem; }
  @media (prefers-color-scheme: dark) { .label { color: var(--cd); } }
  .tick { display: grid; place-items: center; flex: none; width: 1.4rem; height: 1.4rem; margin-top: .15rem; border-radius: 999px; background: var(--c); color: #fff; font-size: .72rem; font-weight: 700; }
  @media (prefers-color-scheme: dark) { .tick { background: var(--cd); color: #0B0F16; } }
  @media (min-width: 960px) { .not { padding-inline-start: 2rem; border-inline-start: 1px solid color-mix(in oklab, var(--c) 25%, transparent); } }
</style>
