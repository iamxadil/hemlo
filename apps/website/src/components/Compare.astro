---
// The difference, at a glance: free tools, a ready-made system, or a website/app built to order. One everyday
// comparison each, then the same three facts (ready when, price, whose it is) in the same rows, so they read across.
import { BRANCH, type BranchId } from '../brand/brand';
import { href, TOOLS_URL, studioUrl, type Lang } from '../i18n/strings';
interface Props { lang: Lang; here?: BranchId; title?: boolean }
const { lang, here, title = true } = Astro.props;
const ar = lang === 'ar';
const T = ar
  ? { title: 'الفرق، بنظرة واحدة', sub: 'ثلاث طرق نخدمك بها. اختر ما يشبه حاجتك.', ready: 'متى يجهز', price: 'السعر', own: 'الملكية', here: 'أنت هنا' }
  : { title: 'The difference, at a glance', sub: 'Three ways we can help. Pick the one that sounds like you.', ready: 'Ready', price: 'Price', own: 'Ownership', here: 'You’re here' };
const cols: { id: BranchId; verb: string; name: string; like: string; ready: string; price: string; own: string; go: string; url: string; ext?: boolean }[] = ar ? [
  { id: 'tools', verb: 'استخدم', name: 'أدوات مجانية', like: 'مثل آلة حاسبة: تفتحها وتستخدمها. فاتورة، عرض سعر، والمبلغ بالحروف.', ready: 'الآن', price: 'مجاناً، دائماً', own: 'لا شيء تملكه: تستخدمه فقط', go: 'افتح الأدوات', url: TOOLS_URL, ext: true },
  { id: 'systems', verb: 'أدِر', name: 'نظام جاهز', like: 'مثل محل مؤثث للإيجار: تدخله اليوم وتبدأ العمل. البيع، المواعيد، الديون والحسابات.', ready: 'اليوم', price: 'اشتراك شهري، وتبدأ مجاناً', own: 'نحن نشغّله ونطوّره، وبياناتك لك', go: 'شاهد الأنظمة', url: here === 'systems' ? '#trades' : href(lang, 'systems') },
  { id: 'studio', verb: 'امتلك', name: 'موقع أو تطبيق حسب الطلب', like: 'مثل بيت يُبنى على مخططك: يأخذ وقتاً، ويبقى لك. موقع، متجر إلكتروني أو تطبيق.', ready: 'في موعد نتفق عليه', price: 'سعر واحد للمشروع', own: 'ملكك بالكامل', go: 'احسب السعر', url: `${studioUrl(lang)}#build`, ext: true },
] : [
  { id: 'tools', verb: 'Use', name: 'Free tools', like: 'Like a calculator: open it and use it. Invoices, quotes, the amount in words.', ready: 'Right now', price: 'Free, always', own: 'Nothing to own: just use it', go: 'Open the tools', url: TOOLS_URL, ext: true },
  { id: 'systems', verb: 'Run', name: 'A ready-made system', like: 'Like a furnished shop to rent: move in today and start working. Sales, appointments, debts and money.', ready: 'Today', price: 'A monthly plan, start free', own: 'We run and improve it; your data is yours', go: 'See the systems', url: here === 'systems' ? '#trades' : href(lang, 'systems') },
  { id: 'studio', verb: 'Own', name: 'A website or app, built for you', like: 'Like a house built to your plan: it takes time, and it’s yours. A website, an online store or an app.', ready: 'On a date we agree', price: 'One price per project', own: 'Fully yours', go: 'Work out the price', url: `${studioUrl(lang)}#build`, ext: true },
];
---
<!-- one panel, three columns: the verb large in its branch colour, then the same facts in the same rows, so they read across -->
<div class="cmp">
  {title && <div class="cmp-head reveal"><h2 class="text-[clamp(1.6rem,3.2vw,2.4rem)] font-semibold tracking-tight">{T.title}</h2><p class="mt-2 text-fg-2">{T.sub}</p></div>}
  <div class="cmp-panel reveal">
    {cols.map((c, i) => {
      const b = BRANCH[c.id];
      return (
        <a class:list={['cmp-col', here === c.id && 'is-here']} href={c.url} rel={c.ext ? 'noopener' : undefined} style={`--c:${b.color};--cd:${b.dark};--t:${b.tint};--td:${b.tintDark}`}>
          <span class="cmp-top">
            <span class="cmp-n" aria-hidden="true">{ar ? '١٢٣'[i] : `0${i + 1}`}</span>
            {here === c.id && <span class="cmp-here">{T.here}</span>}
          </span>
          <span class="cmp-verb">{c.verb}</span>
          <span class="cmp-name">{c.name}</span>
          <span class="cmp-like">{c.like}</span>
          <span class="cmp-fact"><span class="k">{T.ready}</span><span class="v">{c.ready}</span></span>
          <span class="cmp-fact"><span class="k">{T.price}</span><span class="v">{c.price}</span></span>
          <span class="cmp-fact"><span class="k">{T.own}</span><span class="v">{c.own}</span></span>
          <span class="cmp-go">{c.go}<span class="arr" aria-hidden="true">→</span></span>
        </a>
      );
    })}
  </div>
</div>

<style>
  .cmp-head { margin-bottom: 1.8rem; text-align: center; }
  .cmp-panel { display: grid; overflow: hidden; border-radius: var(--radius-tile); border: 1px solid var(--line); background: var(--surface); box-shadow: 0 1px 2px rgb(14 20 32 / .04), 0 30px 60px -44px rgb(14 20 32 / .35); }
  .cmp-col { position: relative; display: flex; flex-direction: column; padding: 1.6rem 1.6rem 1.5rem; color: var(--fg); text-align: start; transition: background-color .3s var(--ease-soft); }
  .cmp-col + .cmp-col { border-top: 1px solid var(--line); }
  /* a line of the branch colour grows along the top on hover, and stays on the column you're in */
  .cmp-col::before { content: ""; position: absolute; inset-inline: 0; top: 0; height: 3px; background: var(--c); transform: scaleX(0); transform-origin: var(--from, left); transition: transform .5s var(--ease-soft); }
  :global(html[dir="rtl"]) .cmp-col::before { --from: right; }
  @media (prefers-color-scheme: dark) { .cmp-col::before { background: var(--cd); } }
  @media (hover: hover) and (pointer: fine) { .cmp-col:hover { background: color-mix(in oklab, var(--t) 45%, var(--surface)); } .cmp-col:hover::before { transform: scaleX(1); } }
  .cmp-col.is-here { background: linear-gradient(180deg, color-mix(in oklab, var(--t) 75%, var(--surface)), var(--surface) 70%); }
  .cmp-col.is-here::before { transform: scaleX(1); }
  @media (prefers-color-scheme: dark) {
    @media (hover: hover) and (pointer: fine) { .cmp-col:hover { background: color-mix(in oklab, var(--td) 60%, var(--surface)); } }
    .cmp-col.is-here { background: linear-gradient(180deg, color-mix(in oklab, var(--td) 90%, var(--surface)), var(--surface) 70%); }
  }

  .cmp-top { display: flex; align-items: center; justify-content: space-between; gap: .5rem; min-height: 1.5rem; }
  .cmp-n { font-size: .78rem; font-weight: 500; font-variant-numeric: tabular-nums; color: var(--muted); }
  .cmp-here { padding: .2rem .65rem; border-radius: 999px; font-size: .75rem; font-weight: 600; background: var(--c); color: #fff; }
  @media (prefers-color-scheme: dark) { .cmp-here { background: var(--cd); color: #0B0F16; } }
  /* the verb is the headline: Use · Run · Own */
  .cmp-verb { margin-top: .9rem; font-size: clamp(2rem, 3.4vw, 2.6rem); font-weight: 600; line-height: 1.1; letter-spacing: -.035em; color: var(--c); }
  :global(html[lang="ar"]) .cmp-verb { letter-spacing: 0; line-height: 1.35; }
  @media (prefers-color-scheme: dark) { .cmp-verb { color: var(--cd); } }
  .cmp-name { margin-top: .35rem; font-size: 1.12rem; font-weight: 600; letter-spacing: -.01em; line-height: 1.3; }
  :global(html[lang="ar"]) .cmp-name { letter-spacing: 0; }
  .cmp-like { margin-top: .6rem; margin-bottom: 1.1rem; color: var(--fg-2); line-height: 1.6; font-size: .95rem; }
  .cmp-fact { display: grid; align-content: start; gap: .1rem; padding: .7rem 0; border-top: 1px solid var(--line); font-size: .95rem; }
  .cmp-fact .k { font-size: .78rem; color: var(--muted); }
  .cmp-fact .v { font-weight: 500; }
  .cmp-go { display: inline-flex; align-items: center; gap: .45rem; padding-top: 1rem; border-top: 1px solid var(--line); font-weight: 600; color: var(--c); }
  @media (prefers-color-scheme: dark) { .cmp-go { color: var(--cd); } }
  .cmp-go .arr { transition: transform .25s var(--ease-soft); }
  @media (hover: hover) and (pointer: fine) { .cmp-col:hover .cmp-go .arr { transform: translateX(4px); } }
  :global(html[dir="rtl"]) .cmp-go .arr { transform: scaleX(-1); }
  :global(html[dir="rtl"]) .cmp-col:hover .cmp-go .arr { transform: scaleX(-1) translateX(4px); }
  @media (prefers-reduced-motion: reduce) { .cmp-col, .cmp-col::before, .cmp-go .arr { transition: none; } }

  /* phones: three cards to swipe through, the next one peeking in */
  @media (max-width: 859px) {
    .cmp-panel { display: flex; gap: .75rem; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none;
      margin-inline: -1.25rem; padding: .25rem 1.25rem 1rem; scroll-padding-inline: 1.25rem; background: none; border: 0; border-radius: 0; box-shadow: none; }
    .cmp-panel::-webkit-scrollbar { display: none; }
    .cmp-col { flex: 0 0 min(84%, 22rem); scroll-snap-align: start; overflow: hidden; border: 1px solid var(--line); border-radius: 1.4rem; background: var(--surface); box-shadow: 0 24px 50px -40px rgb(14 20 32 / .4); }
    .cmp-col + .cmp-col { border-top: 1px solid var(--line); }
    .cmp-like { flex: 1; }
  }

  /* laptops: side by side, hairlines between, every row lined up across the three (subgrid) */
  @media (min-width: 860px) {
    .cmp-panel { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(8, auto); }
    .cmp-col { grid-row: span 8; display: grid; grid-template-rows: subgrid; padding: 2rem 2rem 1.8rem; }
    .cmp-col + .cmp-col { border-top: 0; border-inline-start: 1px solid var(--line); }
  }
</style>
