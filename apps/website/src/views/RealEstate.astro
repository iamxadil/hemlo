---
// Hemlo for real estate offices: emerald on warm paper, built around real screens of the demo agency (Al-Waha):
// a property's own page sent on WhatsApp, the leads it matches and why, the day, the deal and the commission.
// A 30-day free trial, or the demo agency in one tap.
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Pricing from '../components/Pricing.astro';
import { EMAIL, SYSTEM_URL, type Lang } from '../i18n/strings';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const ar = lang === 'ar';
const start = `${SYSTEM_URL}?start=realestate&lang=${lang}`;
const demo = `${SYSTEM_URL}?demo=realestate&lang=${lang}`;
const mail = `mailto:${EMAIL}?subject=${encodeURIComponent('Hemlo Real Estate')}`;
const num = (i: number) => (ar ? '١٢٣٤٥'[i] : String(i + 1));
// real screenshots of the demo agency, per language (apps/demo-store/scripts/re-marketing.ts)
const img = (name: string, w: number) => `/images/realestate/${name}-${lang}-${w}.webp`;
const set = (name: string) => `${img(name, 1000)} 1000w, ${img(name, 1800)} 1800w`;
const pset = (name: string) => `${img(name, 420)} 420w, ${img(name, 840)} 840w`;

// the features, as the four things that happen to every property; a line icon for each feature
const ICON: Record<string, string> = {
  pages: 'M5 3.5h14v17H5zM5 13h14M9 7.5h6',
  wa: 'M4 20l1.3-4A8 8 0 1 1 8 18.7zM9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 .8c-1-.5-1.8-1.3-2.3-2.3l.8-1-1-2z',
  qr: 'M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h2v2h-2zM18 18h2v2h-2zM14 18h2M18 14h2',
  ai: 'M12 3l1.8 4.6L18.5 9l-4.7 1.8L12 15.5l-1.8-4.7L5.5 9l4.7-1.4zM18 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z',
  match: 'M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM3 20c.8-3.3 3-5 6-5M14 17l2 2 4-4',
  collections: 'M4 7h16v13H4zM7 4h10M9 12l2 2 4-4',
  followups: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 7v5l3 2',
  viewings: 'M4 6h16v14H4zM4 10h16M8 3.5V7M16 3.5V7M9 15l2 2 4-4',
  deals: 'M3 7h18v10H3zM12 14.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM6.5 12h.01M17.5 12h.01',
  status: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM8 12l3 3 5-6',
  owners: 'M4 20V9l8-5 8 5v11M9 20v-6h6v6',
  docs: 'M7 3.5h7l4 4v13H7zM14 3.5v4h4M10 12h5M10 15.5h5',
  today: 'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM12 2.5v2M12 19.5v2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M2.5 12h2M19.5 12h2M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4',
  funnel: 'M4 5h16l-6 7v6l-4 2v-8z',
  team: 'M12 3l7 3v6c0 4-3 7.5-7 9-4-1.5-7-5-7-9V6zM9 12l2 2 4-4',
  devices: 'M3 5h13v10H3zM1.5 18h16M18.5 9h4v11h-4z',
};
const V = ar ? {
  title: 'فيلا بحديقة في دريم ستي', area: 'دريم ستي · أربيل', opened: 'أحمد فتح الصفحة · 3 مرات',
  leads: [['أحمد صالح', 100, 'السعر · المنطقة · الغرف'], ['ريم سعد', 89, 'السعر · النوع · المساحة']] as [string, number, string][],
  deal: [['سعر الطلب', '$345,000'], ['عرض المشتري', '$300,000'], ['ردّ المالك', '$335,000'], ['المتفق عليه', '$318,000']], closed: 'العمولة',
  funnel: [['مشاهدات', 380], ['استفسارات', 14], ['معاينات', 3], ['عروض', 2]] as [string, number][],
} : {
  title: 'Villa with a garden in Dream City', area: 'Dream City · Erbil', opened: 'Ahmed opened it · 3 times',
  leads: [['Ahmed Saleh', 100, 'Price · area · bedrooms'], ['Reem Saad', 89, 'Price · type · size']] as [string, number, string][],
  deal: [['Asking', '$345,000'], ['Buyer’s offer', '$300,000'], ['Owner’s counter', '$335,000'], ['Agreed', '$318,000']], closed: 'Commission',
  funnel: [['Views', 380], ['Inquiries', 14], ['Viewings', 3], ['Offers', 2]] as [string, number][],
};
type Group = { key: 'show' | 'match' | 'close' | 'run'; title: string; sub: string; items: [string, string, string][] };

const S = ar ? {
  title: 'هيملو للعقارات', live: 'متاح الآن · ٣٠ يوماً مجاناً',
  h1: ['لمكاتب العقارات.', 'كل عقار يجد زبونه.'],
  sub: 'صفحة أنيقة لكل عقار تُرسل على واتساب، وزبائن يُطابَقون مع العقارات تلقائياً مع السبب، ومعاينات ومتابعات لا تُنسى، وصفقات وعمولات واضحة. من الموبايل أو الكمبيوتر.',
  start: 'ابدأ مكتبي مجاناً', demo: 'جرّب مكتباً جاهزاً', demoNote: 'مكتب تجريبي خاص بك، فيه ١٦ عقاراً و١٢ زبوناً وشهر من الحركة. بلا تسجيل.',
  chipA: 'أحمد فتح صفحة الفيلا · ٣ مرات', chipB: 'تطابق ١٠٠٪ · السعر والمنطقة والغرف',
  show: [
    ['property', 'ملف العقار', 'كل ما يخص العقار، في صفحة واحدة.', 'الصور والسعر والحالة والمالك وحده الأدنى، ومن يهتم به، ومن عاينه، وكم مرة فُتحت صفحته. زر واحد يرسله على واتساب برسالة جاهزة بكلماتك، أو يطبع له ورقة إعلان برمز QR.'],
    ['public', 'صفحة العقار', 'الصفحة التي يفتحها زبونك.', 'صفحة سريعة وأنيقة باسم مكتبك، بالعربية والإنجليزية: الصور، السعر، المواصفات، المنطقة على الخريطة، وزر واتساب وزر "اطلب معاينة". العنوان الدقيق وملاحظاتك وحد المالك لا تظهر أبداً.'],
    ['lead', 'المطابقة', 'من يريد هذا العقار، ولماذا.', 'اكتب ما يريده الزبون مرة واحدة: النوع والميزانية والمنطقة والغرف. هيملو يجد العقارات التي تناسبه ويشرح السبب، وحين تنشر عقاراً جديداً يخبرك من من زبائنك قد يريده.'],
    ['today', 'يومك', 'صباحك، بنظرة واحدة.', 'المتابعات المتأخرة، معاينات اليوم، طلبات المعاينة الجديدة، المفاوضات التي تنتظر ردّك، والزبائن الذين لم تكلّمهم منذ مدة. تبدأ يومك وأنت تعرف ما يهم.'],
    ['deals', 'الصفقات', 'من أول عرض إلى العمولة.', 'سعر الطلب، عرض المشتري، ردّ المالك، والسعر المتفق عليه على خط واضح. حين تُغلق الصفقة يُعلَّم العقار مباعاً، وتُحسب العمولة وحصة الوسيط، وتسجّل الدفعات.'],
  ] as [string, string, string, string][],
  insideTitle: 'كل ما يحتاجه مكتب العقارات.', insideSub: 'أربع مراحل يمرّ بها كل عقار، ولكل مرحلة ما تحتاجه.',
  groups: [
    { key: 'show', title: 'اعرضه', sub: 'كل عقار بصفحته، جاهز للمشاركة.', items: [
      ['pages', 'صفحة لكل عقار', 'رابط قصير يظهر بصورة وعنوان على واتساب وفيسبوك.'],
      ['wa', 'واتساب بضغطة', 'رسالة جاهزة بقالبك، وتعرف متى فتح الزبون الرابط.'],
      ['qr', 'QR وورقة إعلان', 'ورقة للطباعة برمز يفتح الصفحة، للواجهة أو للافتة.'],
      ['ai', 'مساعد الكتابة', 'يكتب الوصف بالعربية والإنجليزية من المواصفات، وأنت تراجع.'],
    ] },
    { key: 'match', title: 'جِد من يريده', sub: 'المطابقة والمتابعة، بلا زبون منسي.', items: [
      ['match', 'مطابقة تشرح نفسها', 'لكل زبون العقارات التي تناسبه، مع الدرجة والسبب.'],
      ['collections', 'المجموعات', 'عدة عقارات في رابط واحد، ويحفظ الزبون ما يعجبه.'],
      ['followups', 'المتابعات', 'بمن تتصل اليوم، ومن تأخرت عليه، ومن أصبح هادئاً.'],
      ['viewings', 'المعاينات', 'مواعيد بلا تعارض، تأكيد وتذكير، ونتيجة كل معاينة.'],
    ] },
    { key: 'close', title: 'أغلق الصفقة', sub: 'من أول عرض إلى العمولة، والمالك على اطلاع.', items: [
      ['deals', 'العروض والعمولة', 'كل عرض وردّ على خط واحد، والعمولة والدفعات تُحسب وحدها.'],
      ['status', 'حالة تتحدّث وحدها', 'بيع العقار؟ يُبلَّغ المهتمون وتُلغى المعاينات القادمة.'],
      ['owners', 'تقرير للمالك', 'المشاهدات والمعاينات والعروض، بلا أسماء المشترين.'],
      ['docs', 'المستندات', 'السند والعقد والهوية مع العقار، داخل المكتب فقط.'],
    ] },
    { key: 'run', title: 'أدِر المكتب', sub: 'الفريق والأرقام، في مكان واحد.', items: [
      ['today', 'صباحك جاهز', 'المتأخر والمعاينات والطلبات الجديدة في قائمة واحدة.'],
      ['funnel', 'أداء كل عقار', 'من المشاهدة إلى العرض: أين يتوقف كل عقار.'],
      ['team', 'الفريق والصلاحيات', 'المدير والوسيط والاستقبال والمحاسب، كلٌّ بما يخصه.'],
      ['devices', 'الموبايل أو الكمبيوتر', 'النظام نفسه على كل جهاز، بالعربية والإنجليزية.'],
    ] },
  ] as Group[],
  howTitle: 'كيف تبدأ.',
  how: [['ادخل بحساب هيملو', 'برقم هاتفك أو بريدك. دقيقة واحدة.'], ['سمِّ مكتبك', 'الاسم والمدينة ورقم الواتساب. قالب الرسالة والعمولة جاهزان، فعدّلهما كما تريد.'], ['أضف أول عقار', 'صوره وسعره ومنطقته، وانشر صفحته. شهرك الأول مجاني بالكامل.']] as [string, string][],
  endTitle: 'افتح مكتبك على هيملو اليوم.', endSub: 'ثلاثون يوماً مجاناً، بكل المزايا. بلا بطاقة ولا التزام.',
} : {
  title: 'Hemlo Real Estate', live: 'Live now · 30 days free',
  h1: ['For real estate offices.', 'Every property finds its buyer.'],
  sub: 'A beautiful page for every property, sent on WhatsApp. Leads matched to properties automatically, with the reason. Viewings and follow-ups that never slip, and clear deals and commission. From a phone or a computer.',
  start: 'Start my agency free', demo: 'Try a ready-made agency', demoNote: 'Your own private demo agency, with 16 properties, 12 leads and a month of life. No sign-up.',
  chipA: 'Ahmed opened the villa’s page · 3×', chipB: '100% match · price, area, bedrooms',
  show: [
    ['property', 'The property file', 'Everything about a property, on one page.', 'Photos, price, status, the owner and their lowest price, who’s interested, who viewed it, and how often its page was opened. One button sends it on WhatsApp with a message in your words, or prints a flyer with a QR code.'],
    ['public', 'The property page', 'The page your customer opens.', 'A fast, beautiful page in your agency’s name, in Arabic and English: the photos, price, details, the area on a map, a WhatsApp button and “request a viewing”. The exact address, your notes and the owner’s lowest price never show.'],
    ['lead', 'Matching', 'Who wants this property, and why.', 'Write what a lead wants once: type, budget, area, bedrooms. Hemlo finds the properties that fit and explains why, and when you publish a new one, it tells you which of your leads may want it.'],
    ['today', 'Your day', 'Your morning, at a glance.', 'Overdue follow-ups, today’s viewings, new viewing requests, negotiations waiting on you, and the leads you haven’t spoken to in a while. You start the day knowing what matters.'],
    ['deals', 'Deals', 'From the first offer to the commission.', 'The asking price, the buyer’s offer, the owner’s counter and the agreed price on one clear line. Close the deal and the property is marked sold, the commission and the agent’s share are counted, and payments are logged.'],
  ] as [string, string, string, string][],
  insideTitle: 'Everything a real estate office needs.', insideSub: 'Four stages every property goes through, and what you need at each.',
  groups: [
    { key: 'show', title: 'Show it', sub: 'Every property with its own page, ready to share.', items: [
      ['pages', 'A page for every property', 'A short link that shows a photo and title on WhatsApp and Facebook.'],
      ['wa', 'WhatsApp in one tap', 'A message from your template, and you see when the link was opened.'],
      ['qr', 'QR and a flyer', 'A print-ready flyer with a code that opens the page, for a window or a sign.'],
      ['ai', 'A writing helper', 'Writes the description in Arabic and English from the details; you review it.'],
    ] },
    { key: 'match', title: 'Find who wants it', sub: 'Matching and follow-up, with no lead forgotten.', items: [
      ['match', 'Matching that explains itself', 'For every lead, the properties that fit, with a score and the reason.'],
      ['collections', 'Collections', 'Several properties in one link; the lead saves the ones they like.'],
      ['followups', 'Follow-ups', 'Who to call today, who you’re late with, and who has gone quiet.'],
      ['viewings', 'Viewings', 'No clashes, a confirm and a reminder, and the outcome of each.'],
    ] },
    { key: 'close', title: 'Close the deal', sub: 'From the first offer to the commission, with the owner kept informed.', items: [
      ['deals', 'Offers and commission', 'Every offer and counter on one line; commission and payments counted for you.'],
      ['status', 'Status that updates itself', 'Sold? Interested leads are told and upcoming viewings cancelled.'],
      ['owners', 'Owner reports', 'Views, viewings and offers, without buyers’ names.'],
      ['docs', 'Documents', 'Title deed, contract and ID with the property, inside the office only.'],
    ] },
    { key: 'run', title: 'Run the office', sub: 'Your team and your numbers, in one place.', items: [
      ['today', 'Your morning, ready', 'What’s late, today’s viewings and new requests, in one list.'],
      ['funnel', 'Every property’s funnel', 'From view to offer: where each property stalls.'],
      ['team', 'Team and permissions', 'Manager, agent, desk, accountant: each sees what’s theirs.'],
      ['devices', 'Phone or computer', 'The same system on every device, in Arabic and English.'],
    ] },
  ] as Group[],
  howTitle: 'How to start.',
  how: [['Sign in with Hemlo', 'With your phone number or email. One minute.'], ['Name your agency', 'Its name, city and WhatsApp number. The message template and commission come ready; change them as you like.'], ['Add your first property', 'Photos, price and area, and publish its page. Your first month is completely free.']] as [string, string][],
  endTitle: 'Open your agency on Hemlo today.', endSub: 'Thirty days free, with everything. No card, no commitment.',
};
const fmax = V.funnel[0][1];
---
<Base lang={lang} page="realestate" title={S.title} description={S.sub}>
  <div class="re">
    <section class="hero">
      <div class="wrap relative pt-14 pb-16 sm:pt-20">
        <div class="max-w-3xl">
          <p class="live rise"><span class="dot" aria-hidden="true"></span>{S.live}</p>
          <h1 class="mt-7 text-[clamp(2.4rem,6vw,5rem)] font-semibold leading-[1.05] tracking-tight rise rise-2"><span class="block">{S.h1[0]}</span><span class="block em">{S.h1[1]}</span></h1>
          <p class="mt-7 max-w-2xl text-lead sub rise rise-3">{S.sub}</p>
          <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4 rise rise-4">
            <a class="btn btn-em" href={start}>{S.start}<span class="arr" aria-hidden="true">→</span></a>
            <a class="btn btn-ghost" href={demo}>{S.demo}</a>
          </div>
          <p class="mt-5 max-w-md text-[.92rem] sub rise rise-4">{S.demoNote}</p>
        </div>
        <div class="devices rise rise-3" aria-hidden="true">
          <div class="laptop"><img src={img('today', 1800)} srcset={set('today')} sizes="(min-width: 1152px) 900px, 88vw" width="1800" height="1125" alt="" fetchpriority="high" decoding="async" /></div>
          <div class="phone"><img src={img('phone-public', 840)} srcset={pset('phone-public')} sizes="200px" width="840" height="1818" alt="" decoding="async" /></div>
          <div class="float chip-a"><span class="wa"></span>{S.chipA}</div>
          <div class="float chip-b"><span class="ok">✓</span>{S.chipB}</div>
        </div>
      </div>
    </section>

    {S.show.map(([key, kicker, title, body], i) => (
      <section class:list={['story', i % 2 ? 'flip' : '', key === 'public' && 'dark']}>
        <div class="wrap story-grid">
          <div class="story-text">
            <p class="reveal kicker">{kicker}</p>
            <h2 class="reveal mt-4 text-[clamp(2rem,3.9vw,3.3rem)] font-semibold leading-[1.08] tracking-tight">{title}</h2>
            <p class="reveal mt-6 text-lead sub">{body}</p>
          </div>
          {key === 'public'
            ? <div class="reveal phones"><img src={img('phone-public', 840)} srcset={pset('phone-public')} sizes="260px" width="840" height="1818" alt={title} loading="lazy" decoding="async" /><img src={img('phone-property', 840)} srcset={pset('phone-property')} sizes="260px" width="840" height="1818" alt="" loading="lazy" decoding="async" /></div>
            : <div class="reveal shot"><img src={img(key, 1800)} srcset={set(key)} sizes="(min-width: 1152px) 680px, 92vw" width="1800" height="1125" alt={title} loading="lazy" decoding="async" /></div>}
        </div>
      </section>
    ))}

    <section id="features" class="scroll-mt-24 wrap border-t border-line py-24 sm:py-32">
      <div class="feat-head">
        <h2 class="reveal text-display font-semibold tracking-tight">{S.insideTitle}</h2>
        <p class="reveal text-lead text-fg-2">{S.insideSub}</p>
      </div>
      <div class="chapters">
        {S.groups.map((g, gi) => (
          <article class="reveal chapter" style={`--d:${gi}`}>
            <header class="ch-head">
              <span class="ch-n">{num(gi)}</span>
              <div><h3>{g.title}</h3><p>{g.sub}</p></div>
            </header>
            <div class="ch-pic" aria-hidden="true">
              {g.key === 'show' && (
                <div class="p-show">
                  <div class="p-card">
                    <img src="/images/realestate/villa-1-sm.webp" width="700" height="467" alt="" loading="lazy" decoding="async" />
                    <div><b>{V.title}</b><small>{V.area}</small><em dir="ltr">$185,000</em></div>
                  </div>
                  <p class="p-seen"><span>✓✓</span> {V.opened}</p>
                </div>
              )}
              {g.key === 'match' && (
                <div class="p-list">
                  {V.leads.map(([n, p, why]) => <div><span class="p-ring" style={`--p:${p}`}><b>{p}</b></span><span class="p-who"><b>{n}</b><small>✓ {why}</small></span></div>)}
                </div>
              )}
              {g.key === 'close' && (
                <div class="p-deal">
                  {V.deal.map(([k, v], i) => <div class={`d${i}`}><i></i><span>{k}</span><b dir="ltr">{v}</b></div>)}
                  <p><span>{V.closed}</span><b dir="ltr">$6,360</b></p>
                </div>
              )}
              {g.key === 'run' && (
                <div class="p-fun">
                  {V.funnel.map(([l, n]) => <div><span>{l}</span><i style={`--w:${Math.max(5, Math.round(Math.sqrt(n / fmax) * 100))}%`}></i><b>{n}</b></div>)}
                </div>
              )}
            </div>
            <ul class="ch-items">
              {g.items.map(([k, t, b]) => (
                <li><span class="ch-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICON[k]} /></svg></span><div><h4>{t}</h4><p>{b}</p></div></li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="wrap border-t border-line py-24 sm:py-32">
      <div class="grid gap-14 lg:grid-cols-[1fr_1.3fr]">
        <h2 class="reveal text-display font-semibold tracking-tight">{S.howTitle}</h2>
        <ol class="how">
          {S.how.map(([title, body], i) => (
            <li class="reveal"><span class="n">{num(i)}</span><div><h3 class="text-lg font-medium">{title}</h3><p class="mt-1 text-fg-2">{body}</p></div></li>
          ))}
        </ol>
      </div>
    </section>

    <Pricing lang={lang} edition="realestate" color="#1F6F5C" />

    <!-- the add-on on top of this system: Hemlo Website (price: hemlo_addon, admin → Billing → Add-ons) -->
    <section class="wrap pb-16 sm:pb-24">
      <a class="reveal re-addon" href={ar ? '/hero-sample/' : '/en/hero-sample/'}>
        <img src="/images/realestate/sample/hero.webp" width="1400" height="933" alt="" loading="lazy" decoding="async" />
        <div class="re-addon-t">
          <p class="text-sm opacity-80">{ar ? 'إضافة · Hemlo Website' : 'Add-on · Hemlo Website'}</p>
          <p class="mt-2 text-xl font-semibold sm:text-2xl">{ar ? 'موقع لمكتبك على عنوانه الخاص، يعرض عقاراتك من هذا النظام مباشرة.' : 'Your office’s own website, showing your properties straight from this system.'}</p>
