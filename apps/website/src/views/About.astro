---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import { t, type Lang } from '../i18n/strings';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t(lang).about;
---
<Base lang={lang} page="about" title={t(lang).nav.about} description={s.title}>
  <section class="wrap pt-16 sm:pt-24 pb-20">
    <p class="eyebrow rise">{s.eyebrow}</p>
    <h1 class="mt-4 max-w-4xl text-hero font-semibold tracking-tight rise rise-2">{s.title}</h1>
  </section>
  <section class="wrap pb-24 grid gap-14 md:grid-cols-[1fr_16rem]">
    <div class="space-y-6 text-lead text-fg-2 max-w-2xl">
      {s.story.map((p) => <p class="reveal">{p}</p>)}
    </div>
    <div class="reveal hidden md:grid place-items-center rounded-[2rem] bg-sunken aspect-[3/4]" aria-hidden="true"><Mark class="h-1/2 w-auto text-fg" /></div>
  </section>
  <!-- the name -->
  <section class="wrap py-24 border-t border-line">
    <div class="grid items-center gap-12 md:grid-cols-[1fr_1.1fr]">
      <p class="reveal flex flex-wrap items-baseline gap-x-4 gap-y-2 text-[clamp(2.4rem,6vw,4.5rem)] font-semibold tracking-tight" dir="ltr" aria-hidden="true">
        <span>hem</span><span class="text-muted font-light">+</span><span>hello</span><span class="text-muted font-light">=</span><span class="text-brass">Hemlo</span>
      </p>
      <div class="reveal">
        <h2 class="text-title font-semibold">{s.nameTitle}</h2>
        <p class="mt-4 text-lead leading-relaxed text-fg-2">{s.nameBody}</p>
      </div>
    </div>
  </section>

  <section class="wrap py-24 border-t border-line">
    <h2 class="reveal text-display font-semibold tracking-tight">{s.principlesTitle}</h2>
    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      {s.principles.map(([title, body]) => (
        <div class="reveal card p-8">
          <h3 class="text-title font-medium">{title}</h3>
          <p class="mt-3 leading-relaxed text-fg-2">{body}</p>
        </div>
      ))}
    </div>
    <p class="reveal mt-16 text-center text-muted">{s.base}</p>
  </section>
</Base>
