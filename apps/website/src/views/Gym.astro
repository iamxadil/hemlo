    background: radial-gradient(90% 80% at 100% 0%, rgb(228 87 46 / .45), transparent 60%), linear-gradient(140deg, #22252C, #0E0F12); box-shadow: 0 24px 40px -22px rgb(14 15 18 / .7), 0 0 0 1px rgb(255 255 255 / .06) inset; transform: rotate(-3deg); transition: transform .5s var(--ease); }
