---
// Hemlo Systems for gyms: iron and ember, the gym's own look, built around real screens of the demo gym (the front desk,
// renewals, a member's progress, the door screen, the busy hours). A 30-day free trial, or the demo in one tap.
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Pricing from '../components/Pricing.astro';
import { href, EMAIL, SYSTEM_URL, type Lang } from '../i18n/strings';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const start = `${SYSTEM_URL}?start=gym&lang=${lang}`; // a 30-day free trial, started by the owner
const demo = `${SYSTEM_URL}?demo=gym&lang=${lang}`;   // a private demo gym, opened in one tap
const mail = `mailto:${EMAIL}?subject=${encodeURIComponent('Hemlo Gym')}`;
const num = (i: number) => (lang === 'ar' ? ['١', '٢', '٣', '٤', '٥'][i] : String(i + 1));
// real screenshots of the demo gym, per language (platform/scripts/marketing-gym-shots.ts → website/scripts/gym-images.mjs)
const img = (name: string, w: number) => `/images/gym/${name}-${lang}-${w}.webp`;
const set = (name: string) => `${img(name, 1000)} 1000w, ${img(name, 1800)} 1800w`;
// the "everything a gym needs" cards: one key per entry of S.inside (same order), a line icon each, and a small visual on some
const KEYS = ['members', 'plans', 'pause', 'hours', 'pt', 'classes', 'body', 'shop', 'debts', 'birthdays', 'team', 'langs'] as const;
const WIDE = ['members', 'hours', 'team', 'langs'];
const ICON: Record<string, string> = {
  members: 'M3.5 6.5h17v11h-17zM8 13.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM5.5 16c.6-1.2 1.5-1.8 2.5-1.8s1.9.6 2.5 1.8M13.5 10.5h4M13.5 13.5h3',
  plans: 'M4 6h16v14H4zM4 10h16M8 3.5V7M16 3.5V7',
  pause: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM10 9v6M14 9v6',
  hours: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 7v5l3 2',
  pt: 'M3 10v4M6 8v8M18 8v8M21 10v4M6 12h12',
  classes: 'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM3.5 19c.8-3 2.9-4.5 5.5-4.5s4.7 1.5 5.5 4.5M16 5.2a3 3 0 0 1 0 5.6M17.5 14.7c1.6.6 2.6 2 3 4.3',
  body: 'M4 19h16M5 15l4-4 3 3 6-7M15 7h3v3',
  shop: 'M5 8h14l-1 12H6zM9 8a3 3 0 0 1 6 0',
  debts: 'M4 7h15v12H4zM4 7l11-3v3M15 13h4',
  birthdays: 'M4 20h16M5 20v-7h14v7M12 13V9M12 6.5c0-1 1-1.5 1-2.5M5 16.5c1.5 0 1.5 1 3.5 1s2-1 3.5-1 1.5 1 3.5 1 2-1 3.5-1',
  team: 'M12 3l7 3v6c0 4-3 7.5-7 9-4-1.5-7-5-7-9V6zM9 12l2 2 4-4',
  langs: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3 12h18M12 3c2.5 2.7 3.6 5.7 3.6 9s-1.1 6.3-3.6 9c-2.5-2.7-3.6-5.7-3.6-9S9.5 5.7 12 3z',
};
const V = {
  ar: { name: 'زينب علي', initial: 'ز', no: '#0142 · ٣ أشهر', left: 'متبقٍ', days: '٧٨ يوماً', plans: ['شهر', '٣ أشهر', 'سنة', '١٢ زيارة'], paused: 'موقوف مؤقتاً', back: '+١٢ يوماً', men: 'رجال', women: 'سيدات', ticks: ['٦ ص', '٢ م', '٦ م', '١٢ ل'], kg: '−٤٫٢ كغ', weeks: 'خلال ١٢ أسبوعاً', pt: '٨ من ١٢ جلسة', classes: [['زومبا', '٦:٠٠ م', '٤ أماكن', false], ['كيك بوكسينغ', '٨:٠٠ م', 'ممتلئ', true]] as [string, string, string, boolean][], shop: [['بروتين واي', '45,000'], ['ماء', '500']], iqd: 'د.ع', debts: [['أحمد كريم', '25,000'], ['سارة محمد', '10,000']], owes: 'عليه', bdays: ['ر', 'ن', 'ع'], bdayN: '٣ هذا الأسبوع', wish: 'هنّئهم', roles: [['م', 'المدير', 'كل شيء'], ['س', 'الاستقبال', 'الدخول والبيع'], ['ت', 'المدرّب', 'مشتركوه وجلساته'], ['ح', 'المحاسب', 'المال والتقارير']] },
  en: { name: 'Zainab Ali', initial: 'Z', no: '#0142 · 3 months', left: 'Left', days: '78 days', plans: ['1 month', '3 months', '1 year', '12 visits'], paused: 'Paused', back: '+12 days', men: 'Men', women: 'Ladies', ticks: ['6am', '2pm', '6pm', '12am'], kg: '−4.2 kg', weeks: 'in 12 weeks', pt: '8 of 12 sessions', classes: [['Zumba', '6:00 pm', '4 left', false], ['Kickboxing', '8:00 pm', 'Full', true]] as [string, string, string, boolean][], shop: [['Whey protein', '45,000'], ['Water', '500']], iqd: 'IQD', debts: [['Ahmed Kareem', '25,000'], ['Sara Mohammed', '10,000']], owes: 'owes', bdays: ['R', 'N', 'O'], bdayN: '3 this week', wish: 'Send wishes', roles: [['M', 'Manager', 'Everything'], ['D', 'Desk', 'Check-ins and sales'], ['C', 'Coach', 'Their members'], ['A', 'Accountant', 'Money and reports']] },
}[lang];
// a member's QR card: a fixed, made-up pattern with the three corner squares, drawn at build time
const QR = (() => {
  const n = 21, cells: string[] = [];
  const finder = (x: number, y: number) => { for (let i = 0; i < 7; i++) for (let j = 0; j < 7; j++) { const edge = i === 0 || i === 6 || j === 0 || j === 6, core = i >= 2 && i <= 4 && j >= 2 && j <= 4; if (edge || core) cells.push(`M${x + i} ${y + j}h1v1h-1z`); } };
  finder(0, 0); finder(n - 7, 0); finder(0, n - 7);
  let seed = 142;
  for (let x = 0; x < n; x++) for (let y = 0; y < n; y++) {
    if ((x < 8 && y < 8) || (x > n - 9 && y < 8) || (x < 8 && y > n - 9)) continue;
    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
    if (seed % 100 < 47) cells.push(`M${x} ${y}h1v1h-1z`);
  }
  return cells.join('');
})();

const S = {
  ar: {
    title: 'هيملو للأندية الرياضية', crumb: 'هيملو للأنظمة', live: 'متاح الآن · ٣٠ يوماً مجاناً',
    h1: ['للأندية الرياضية.', 'المشترك يدخل، والتجديد لا يفوتك.'],
    sub: 'الاستقبال بمسحة بطاقة، الاشتراكات والإيقاف المؤقت، أوقات السيدات، التدريب الشخصي وحصة المدرب، الكلاسات، قياسات الجسم، والمتجر. نظام واحد، بالعربية والكوردية والإنجليزية.',
    start: 'ابدأ ناديّ مجاناً', demo: 'جرّب نادياً جاهزاً', demoNote: 'نادٍ تجريبي خاص بك، فيه ٤٢ مشتركاً وشهر من الحركة. بلا تسجيل.',
    chipIn: 'زينب دخلت · ١٣ يوماً متبقياً', chipWa: 'تذكير تجديد على واتساب',
    show: [
      ['desk', 'الاستقبال', 'مسحة واحدة: يدخل، أو تعرف السبب.', 'قارئ الباركود أو الكاميرا يقرأ بطاقة المشترك، فتظهر صورته وكم يوماً بقي له بخط كبير. انتهى اشتراكه؟ يظهر السبب بالأحمر، ومعه زر التجديد، أو "أدخله هذه المرة". والدخول مرتين في نفس الزيارة لا يُحسب مرتين.'],
      ['renewals', 'التجديدات', 'المال الذي يضيع بصمت.', 'من ينتهي اشتراكه هذا الأسبوع، ومن انتهى ولم يجدّد. لكل واحد رسالة واتساب جاهزة بكلماتك، وزر تجديد يبيع الاشتراك التالي فوراً، ويبدأ من اليوم الذي يلي انتهاء الحالي، فلا يضيع يوم.'],
      ['progress', 'التقدّم', 'ما يُبقي المشترك: أن يرى التغيير.', 'الوزن والدهون والخصر والقياسات على خط زمني واضح، يسجّلها المدرب من موبايله. والملاحظات الصحية (الظهر، الركبة، الضغط) أمام كل مدرب قبل أن يبدأ.'],
      ['door-hi', 'شاشة الباب', 'شاشة عند المدخل تعرف الجميع.', 'تلفاز أو تابلت عند الباب: يرحّب بكل من يدخل باسمه وكم بقي له، ويعرض كلاسات اليوم والأماكن المتبقية وعدد من يتمرّن الآن. وإن أردت، يمسح المشتركون بطاقاتهم بأنفسهم.'],
      ['reports', 'التقارير', 'متى يزدحم ناديك، وماذا يُباع.', 'دخل الاشتراكات والمتجر يوماً بيوم، نسبة التجديد، خريطة الزحمة حسب اليوم والساعة، أكثر الاشتراكات مبيعاً، وما كسبه كل مدرب من التدريب الشخصي.'],
    ],
    insideTitle: 'كل ما يحتاجه النادي، في مكان واحد.',
    inside: [
      ['المشتركون وبطاقاتهم', 'رقم لكل مشترك، صورة، وبطاقة QR تُرسل له على واتساب أو تُطبع.'],
      ['الاشتراكات', 'شهر، ثلاثة، سنة، أو ١٢ زيارة. خصم، دفع جزئي والباقي على الحساب.'],
      ['الإيقاف المؤقت', 'مسافر أو مريض؟ يُوقف الاشتراك، وتُضاف الأيام عند الاستئناف.'],
      ['أوقات السيدات', 'ساعات للسيدات وأخرى للرجال. الباب يردّ غير وقته، والاستقبال يقرّر.'],
      ['التدريب الشخصي', 'باقات جلسات لكل مدرب، وحصته تُحسب من كل جلسة.'],
      ['الكلاسات', 'زومبا، كيك بوكسينغ، كروس فت: جدول أسبوعي، أماكن محدودة، وحضور.'],
      ['قياسات الجسم', 'الوزن والدهون والمحيطات، وخط التقدّم أمام المشترك.'],
      ['المتجر', 'الماء والبروتين والشيكر بالباركود، على نفس الصندوق.'],
      ['الديون والصندوق', 'من عليه كم، الدفعات، وتسليم الصندوق آخر الدوام.'],
      ['أعياد الميلاد', 'تذكير بمن يحتفل هذا الأسبوع، ورسالة تهنئة بنقرة.'],
      ['الفريق والصلاحيات', 'المدير، الاستقبال، المدرب، المحاسب: كل واحد يرى ما يخصه.'],
      ['ثلاث لغات', 'العربية والكوردية والإنجليزية، على الكمبيوتر والتابلت والموبايل.'],
    ],
    howTitle: 'كيف تبدأ.',
    how: [['ادخل بحساب هيملو', 'برقم هاتفك أو بريدك. دقيقة واحدة.'], ['سمِّ ناديك', 'الاسم والمدينة ومن يتمرّن عندك. تجد الاشتراكات والأوقات جاهزة، فعدّلها كما تريد.'], ['أضف مشتركيك', 'أو دع الاستقبال يضيفهم وهم يدخلون. شهرك الأول مجاني بالكامل.']],
    endTitle: 'افتح ناديك على هيملو اليوم.', endSub: 'ثلاثون يوماً مجاناً، بكل المزايا. بلا بطاقة ولا التزام.',
  },
  en: {
    title: 'Hemlo for gyms', crumb: 'Hemlo Systems', live: 'Live now · 30 days free',
    h1: ['For gyms.', 'Members in. Renewals never missed.'],
    sub: 'Check-in with a scan, memberships and pauses, ladies’ hours, personal training and the coach’s share, classes, body measurements, and the shop. One system, in Arabic, Kurdish and English.',
    start: 'Start my gym free', demo: 'Try a ready-made gym', demoNote: 'Your own private demo gym, with 42 members and a month of life. No sign-up.',
    chipIn: 'Zainab in · 13 days left', chipWa: 'Renewal reminder on WhatsApp',
    show: [
      ['desk', 'The front desk', 'One scan: in, or the reason why.', 'A barcode scanner or the camera reads the member’s card: their photo and the days they have left, in big type. Membership over? The reason shows in red, with a renew button, or “let them in this once”. Coming back in the same visit never counts twice.'],
      ['renewals', 'Renewals', 'The money a gym loses quietly.', 'Who ends this week, and who ended and didn’t renew. Each with a WhatsApp message in your words, and a renew button that sells the next one on the spot, starting the day after the current one ends, so no day is lost.'],
      ['progress', 'Progress', 'What keeps members: seeing the change.', 'Weight, body fat, waist and the rest on a clear line over time, recorded by the coach on their phone. And the health notes (back, knee, blood pressure) in front of every coach before they start.'],
      ['door-hi', 'The door screen', 'A screen at the door that knows everyone.', 'A TV or tablet at the entrance greets everyone by name with what they have left, and shows today’s classes, the places left and how many are training now. If you like, members scan their own cards there.'],
      ['reports', 'Reports', 'When your gym is busy, and what sells.', 'Memberships and shop money day by day, the renewal rate, a map of the busy hours by day and hour, what sells most, and what each coach earned from personal training.'],
    ],
    insideTitle: 'Everything a gym needs, in one place.',
    inside: [
      ['Members and cards', 'A number for each member, a photo, and a QR card sent on WhatsApp or printed.'],
      ['Memberships', 'A month, three, a year, or 12 visits. Discounts, part payment, the rest on account.'],
      ['Pauses', 'Travelling or ill? Pause it, and the days come back when it resumes.'],
      ['Ladies’ hours', 'Hours for women and hours for men. The door turns others back; the desk decides.'],
      ['Personal training', 'Session packages per coach, and their share counted from every session.'],
      ['Classes', 'Zumba, kickboxing, CrossFit: a weekly timetable, limited places, and who came.'],
      ['Body measurements', 'Weight, fat and sizes, and a progress line the member can see.'],
      ['The shop', 'Water, protein and shakers by barcode, on the same till.'],
      ['Debts and the drawer', 'Who owes what, payments, and handing over the drawer at the end of a shift.'],
      ['Birthdays', 'Who celebrates this week, and a greeting in one tap.'],
      ['Team and permissions', 'Manager, desk, coach, accountant: each sees what’s theirs.'],
      ['Three languages', 'Arabic, Kurdish and English, on a computer, a tablet or a phone.'],
    ],
    howTitle: 'How to start.',
    how: [['Sign in with Hemlo', 'With your phone number or email. One minute.'], ['Name your gym', 'Its name, city and who trains with you. Memberships and hours come ready; change them as you like.'], ['Add your members', 'Or let the desk add them as they come in. Your first month is completely free.']],
    endTitle: 'Open your gym on Hemlo today.', endSub: 'Thirty days free, with everything. No card, no commitment.',
  },
}[lang];
---
<Base lang={lang} page="gym" title={S.title} description={S.sub}>
  <div class="gy">
    <section class="hero">
      <div class="wrap relative pt-14 pb-16 sm:pt-20">
        <div class="max-w-3xl">
          <p class="live rise"><span class="dot" aria-hidden="true"></span>{S.live}</p>
          <h1 class="mt-7 text-[clamp(2.5rem,6.2vw,5.2rem)] font-semibold leading-[1.04] tracking-tight rise rise-2"><span class="block">{S.h1[0]}</span><span class="block ember">{S.h1[1]}</span></h1>
          <p class="mt-7 max-w-2xl text-lead sub rise rise-3">{S.sub}</p>
          <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4 rise rise-4">
            <a class="btn btn-ember" href={start}>{S.start}<span class="arr" aria-hidden="true">→</span></a>
            <a class="btn btn-ghost-dark" href={demo}>{S.demo}</a>
          </div>
          <p class="mt-5 max-w-md text-[.92rem] sub rise rise-4">{S.demoNote}</p>
        </div>
        <div class="devices rise rise-3" aria-hidden="true">
          <div class="laptop"><img src={img('desk', 1800)} srcset={set('desk')} sizes="(min-width: 1152px) 900px, 88vw" width="1800" height="1125" alt="" fetchpriority="high" decoding="async" /></div>
          <div class="phone"><img src={img('phone-member', 840)} srcset={`${img('phone-member', 420)} 420w, ${img('phone-member', 840)} 840w`} sizes="200px" width="840" height="1818" alt="" decoding="async" /></div>
          <div class="tv"><img src={img('door-hi', 1000)} width="1000" height="625" alt="" loading="lazy" decoding="async" /></div>
          <div class="float chip-a"><span class="ok">✓</span>{S.chipIn}</div>
          <div class="float chip-b"><span class="wa"></span>{S.chipWa}</div>
        </div>
      </div>
    </section>

    {S.show.map(([key, kicker, title, body], i) => (
      <section class:list={['story', i % 2 ? 'flip' : '', key === 'door-hi' && 'dark']}>
        <div class="wrap story-grid">
          <div class="story-text">
            <p class="reveal kicker">{kicker}</p>
            <h2 class="reveal mt-4 text-[clamp(2rem,3.9vw,3.3rem)] font-semibold leading-[1.08] tracking-tight">{title}</h2>
            <p class="reveal mt-6 text-lead sub">{body}</p>
          </div>
          <div class="reveal shot"><img src={img(key, 1800)} srcset={set(key)} sizes="(min-width: 1152px) 680px, 92vw" width="1800" height="1125" alt={title} loading="lazy" decoding="async" /></div>
        </div>
      </section>
    ))}

    <section id="features" class="scroll-mt-24 wrap border-t border-line py-24 sm:py-32">
      <h2 class="reveal max-w-3xl text-display font-semibold tracking-tight">{S.insideTitle}</h2>
      <div class="bento mt-14">
        {S.inside.map(([title, body], i) => {
          const k = KEYS[i];
          return (
            <article class:list={['reveal card', WIDE.includes(k) && 'wide']}>
              <div class="ct">
                <span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={ICON[k]} /></svg></span>
                <h3>{title}</h3>
                <p>{body}</p>
              </div>
              {k === 'members' && (
                <div class="viz" aria-hidden="true">
                  <div class="mcard">
                    <div class="mc-top"><span class="mc-ph">{V.initial}</span><div><b>{V.name}</b><small dir="auto">{V.no}</small></div></div>
                    <div class="mc-bot"><div><small>{V.left}</small><b>{V.days}</b></div><svg class="qr" viewBox="-1 -1 23 23"><path d={QR} /></svg></div>
                  </div>
                </div>
              )}
              {k === 'plans' && <div class="viz chips" aria-hidden="true">{V.plans.map((x, j) => <span class:list={[j === 1 && 'on']}>{x}</span>)}</div>}
              {k === 'pause' && (
                <div class="viz" aria-hidden="true">
                  <div class="pbar"><i class="used"></i><i class="held"></i><i class="rest"></i></div>
                  <div class="prow"><span>{V.paused}</span><b>{V.back}</b></div>
                </div>
              )}
              {k === 'hours' && (
                <div class="viz" aria-hidden="true">
                  <div class="tl"><span style="flex:8">{V.men}</span><span class="w" style="flex:4">{V.women}</span><span style="flex:6">{V.men}</span></div>
                  <div class="ticks"><span>{V.ticks[0]}</span><span>{V.ticks[1]}</span><span>{V.ticks[2]}</span><span>{V.ticks[3]}</span></div>
                </div>
              )}
              {k === 'body' && (
                <div class="viz" aria-hidden="true">
                  <svg class="spark" viewBox="0 0 200 56" preserveAspectRatio="none"><defs><linearGradient id="gy-spark" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#E4572E" stop-opacity=".22" /><stop offset="1" stop-color="#E4572E" stop-opacity="0" /></linearGradient></defs><path d="M0 10 L22 14 L44 12 L66 22 L88 24 L110 30 L132 29 L154 38 L176 41 L200 46 L200 56 L0 56 Z" fill="url(#gy-spark)" /><path d="M0 10 L22 14 L44 12 L66 22 L88 24 L110 30 L132 29 L154 38 L176 41 L200 46" fill="none" stroke="#E4572E" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linejoin="round" stroke-linecap="round" /></svg>
                  <div class="prow"><b class="big">{V.kg}</b><span>{V.weeks}</span></div>
                </div>
              )}
              {k === 'pt' && (
                <div class="viz" aria-hidden="true">
                  <div class="dots">{Array.from({ length: 12 }, (_, j) => <i class:list={[j < 8 && 'on']}></i>)}</div>
                  <div class="prow"><span>{V.pt}</span></div>
                </div>
              )}
              {k === 'classes' && <div class="viz rows" aria-hidden="true">{V.classes.map(([c, t, left, full]) => <div><span><b>{c}</b><small>{t}</small></span><em class:list={[full && 'full']}>{left}</em></div>)}</div>}
              {k === 'shop' && <div class="viz rows" aria-hidden="true">{V.shop.map(([x, pr]) => <div><span class="bc"></span><span><b>{x}</b></span><em class="plain">{pr}</em></div>)}</div>}
              {k === 'debts' && <div class="viz rows" aria-hidden="true">{V.debts.map(([x, d]) => <div><span><b>{x}</b><small>{V.owes}</small></span><em class="plain owe">{d}</em></div>)}</div>}
              {k === 'birthdays' && (
                <div class="viz bday" aria-hidden="true">
                  <div class="stack">{V.bdays.map((x) => <span>{x}</span>)}</div>
                  <span class="bn">{V.bdayN}</span>
                  <span class="wish">{V.wish}</span>
                </div>
              )}
              {k === 'team' && <div class="viz roles" aria-hidden="true">{V.roles.map(([a, r, d]) => <div><span class="av">{a}</span><span><b>{r}</b><small>{d}</small></span></div>)}</div>}
              {k === 'langs' && <div class="viz langs" aria-hidden="true"><span lang="ar">عربي</span><span lang="ckb">کوردی</span><span lang="en">English</span></div>}
            </article>
          );
        })}
      </div>
    </section>

    <section class="wrap border-t border-line py-24 sm:py-32">
      <div class="grid gap-14 lg:grid-cols-[1fr_1.3fr]">
        <h2 class="reveal text-display font-semibold tracking-tight">{S.howTitle}</h2>
        <ol class="how">
          {S.how.map(([title, body], i) => (
            <li class="reveal"><span class="n">{num(i)}</span><div><h3 class="text-lg font-medium">{title}</h3><p class="mt-1 text-fg-2">{body}</p></div></li>
          ))}
        </ol>
      </div>
    </section>

    <Pricing lang={lang} edition="gym" color="#E4572E" dark />

    <section class="wrap pb-24 sm:pb-32">
      <div class="reveal end relative overflow-hidden rounded-[2rem] p-10 sm:p-16">
        <Mark class="end-mark" />
        <div class="relative max-w-2xl">
          <h2 class="text-display font-semibold tracking-tight">{S.endTitle}</h2>
          <p class="mt-4 text-lead sub">{S.endSub}</p>
          <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a class="btn btn-ember" href={start}>{S.start}<span class="arr" aria-hidden="true">→</span></a>
            <a class="btn btn-ghost-dark" href={demo}>{S.demo}</a>
            <a class="link-quiet" href={mail} dir="ltr">{EMAIL}</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
