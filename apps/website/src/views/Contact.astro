---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import { t, EMAIL, type Lang } from '../i18n/strings';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t(lang).contact;
---
<Base lang={lang} page="contact" title={t(lang).nav.contact} description={s.sub}>
  <section class="wrap pt-16 sm:pt-24 pb-24 text-center">
    <Mark class="mx-auto h-12 w-auto text-fg rise" />
    <p class="eyebrow mt-8 rise rise-2">{s.eyebrow}</p>
    <h1 class="mt-3 text-hero font-semibold tracking-tight rise rise-2">{s.title}</h1>
    <p class="mt-4 text-lead text-fg-2 rise rise-3">{s.sub}</p>
    <a class="mt-10 inline-block border-b-2 border-brass pb-1 text-[clamp(1.75rem,5vw,3.25rem)] font-medium tracking-tight transition-opacity hover:opacity-70 rise rise-4" href={`mailto:${EMAIL}`} dir="ltr">{EMAIL}</a>
  </section>
  <section class="wrap pb-24">
    <div class="reveal mx-auto max-w-2xl card p-8 sm:p-10">
      <h2 class="text-xl font-medium">{s.tellTitle}</h2>
      <ol class="mt-6 space-y-4">
        {s.tell.map((x, i) => <li class="flex gap-4 text-fg-2"><span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-sunken text-sm tabular-nums">{i + 1}</span><span class="pt-0.5">{x}</span></li>)}
      </ol>
      <p class="mt-8 border-t border-line pt-6 text-sm text-muted">{s.where}</p>
    </div>
  </section>
</Base>
