  stores: { points: ['كاشير بالباركود: القطعة والكارتون والميزان', 'دفتر الديون مع تذكير واتساب', 'البضاعة والموردون والمصاريف والصندوق', 'يعمل بدون إنترنت'], page: href(lang, 'stores'), demo: `${SYSTEM_URL}?demo=1&lang=ar`, pic: '/images/stores/sell-ar-1000.webp' },
  gym: { points: ['الاستقبال بمسحة بطاقة، وأوقات السيدات', 'الاشتراكات والإيقاف المؤقت والتجديد بالواتساب', 'التدريب الشخصي وحصة المدرب، والكلاسات', 'شاشة عند الباب ترحّب بكل مشترك'], page: href(lang, 'gym'), demo: `${SYSTEM_URL}?demo=gym&lang=ar`, pic: '/images/gym/desk-ar-1000.webp' },
  realestate: { points: ['صفحة لكل عقار تُرسل على واتساب', 'مطابقة الزبائن مع العقارات، مع السبب', 'المعاينات والمتابعات في يومك', 'الصفقات والعروض والعمولة'], page: href(lang, 'realestate'), demo: `${SYSTEM_URL}?demo=realestate&lang=ar`, pic: '/images/realestate/property-ar-1000.webp' },
  'phone-repair': { points: ['بطاقة لكل جهاز: العطل والحالة', 'القطع والأجرة في فاتورة واحدة', 'رسالة للزبون حين يجهز جهازه'] },
  'clinic-salon': { points: ['المواعيد حسب الموظف', 'الخدمات والباقات', 'ملف لكل زبون'] },
  'cafe-restaurant': { points: ['الطاولات والطلبات', 'شاشة للمطبخ', 'المنيو والأسعار'] },
  other: { points: ['الغرف والحجوزات', 'الدخول والخروج', 'فاتورة الإقامة'] },
} : {
  dental: { points: ['Appointments and a live board of the day', 'Tooth chart and treatment plans in dinars and dollars', 'The lab and dentists’ shares', 'A waiting-room screen for patients'], page: href(lang, 'dental'), demo: `${SYSTEM_URL}?demo=dental&lang=en`, pic: '/images/dental/chart-en-1000.webp' },
  stores: { points: ['A barcode till: piece, carton and scale', 'The debt book, with WhatsApp reminders', 'Stock, suppliers, expenses and the drawer', 'Keeps working without internet'], page: href(lang, 'stores'), demo: `${SYSTEM_URL}?demo=1&lang=en`, pic: '/images/stores/sell-en-1000.webp' },
  gym: { points: ['Check-in with a scan, and ladies’ hours', 'Memberships, pauses, renewals on WhatsApp', 'Personal training with the coach’s share, and classes', 'A screen at the door that greets every member'], page: href(lang, 'gym'), demo: `${SYSTEM_URL}?demo=gym&lang=en`, pic: '/images/gym/desk-en-1000.webp' },
  realestate: { points: ['A page for every property, sent on WhatsApp', 'Leads matched to properties, with the reason', 'Viewings and follow-ups in your day', 'Deals, offers and commission'], page: href(lang, 'realestate'), demo: `${SYSTEM_URL}?demo=realestate&lang=en`, pic: '/images/realestate/property-en-1000.webp' },
  'phone-repair': { points: ['A job card for every device: fault and status', 'Parts and labour on one bill', 'A message to the customer when it’s ready'] },
  'clinic-salon': { points: ['Appointments by staff member', 'Services and packages', 'A file for every client'] },
  'cafe-restaurant': { points: ['Tables and orders', 'A screen for the kitchen', 'The menu and prices'] },
  other: { points: ['Rooms and bookings', 'Check-in and check-out', 'The stay’s bill'] },
