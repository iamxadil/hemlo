  { kind: 'dental', color: '#B38B3A', title: L2('عيادة أسنان', 'Dental clinic'), need: L2('أستقبل المرضى بمواعيد', 'I see patients by appointment'), demo: SYS.dental.demo!, page: SYS.dental.page!,
