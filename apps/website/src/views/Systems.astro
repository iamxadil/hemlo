const ORDER = ['dental', 'stores', 'gym', 'realestate', 'phone-repair', 'clinic-salon', 'cafe-restaurant', 'other'];
const systems = ORDER.map((k) => s.trades.find(([, , , kind]) => kind === k)!).filter(Boolean);
const L = L2({ open: 'صفحة النظام', demo: 'جرّبه الآن', ask: 'أريده لعملي', soon: 'ما سيفعله' }, { open: 'See the system', demo: 'Try it now', ask: 'I want this', soon: 'What it will do' });

