// Hemlo Systems: what the business does → its system, shown working (a short story per trade, with the AI moments
// marked), how it works in three steps, what the AI does in each system, then every system in one list.
// The hero is plain HTML and CSS (no 3D, no library): light on any phone.
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Compare from '../components/Compare.astro';
import HwBadge from '../components/HwBadge.astro';
import { BRANCH } from '../brand/brand';
import { t, href, EMAIL, SYSTEM_URL, type Lang } from '../i18n/strings';
interface Props { lang: Lang; }
const { lang } = Astro.props;
