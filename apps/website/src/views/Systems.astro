TRADES.push({ kind: 'realestate', color: '#1F6F5C', title: L2('مكتب عقارات', 'Real estate office'), need: L2('أبيع وأؤجّر العقارات لزبائني', 'I sell and rent property for clients'), demo: SYS.realestate.demo!, page: SYS.realestate.page!,
