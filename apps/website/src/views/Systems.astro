const H = L2({
  eyebrow: 'هيملو · الأنظمة', title: ['أدِر عملك كله', 'من مكان واحد.'],
  sub: 'اختر ما تعمله وشاهد يوماً يمرّ. بالعربي، بالدينار، ويعمل حين ينقطع الإنترنت. ويقرأ حتى فواتير مورّديك عنك.',
  pick: 'ماذا يعمل عملك؟', play: 'تشغيل', pause: 'إيقاف مؤقت', step: 'الخطوة',
}, {
  eyebrow: 'Hemlo Systems', title: ['Run your whole business', 'from one place.'],
  sub: 'Pick what you do and watch a day go by. In Arabic, in dinars, still working when the internet drops. It even reads your supplier’s invoices for you.',
  pick: 'What does your business do?', play: 'Play', pause: 'Pause', step: 'Step',
});
