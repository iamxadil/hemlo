const b = BRANCH.systems;
const ask = (kind: string) => `${href(lang, 'earlyAccess')}?kind=${kind}`;
const mail = `mailto:${EMAIL}?subject=${encodeURIComponent('Hemlo Systems')}`;
const L2 = <T,>(a: T, e: T) => (ar ? a : e);

