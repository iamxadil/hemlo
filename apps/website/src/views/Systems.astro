const TRADES = [
  { kind: 'stores', color: '#A8532E', title: L2('متجر أو ماركت', 'Shop or market'), need: L2('أبيع بضاعة على الكاونتر', 'I sell products at a counter'), demo: SYS.stores.demo!, page: SYS.stores.page!,
    scenes: [
      { title: L2('صوّر فاتورة المورّد', 'Photograph the supplier’s invoice'), line: L2('يقرؤها هيملو ويملأ البضاعة والأسعار والمورّد. تلقي نظرة، وتحفظ.', 'Hemlo reads it and fills in the products, prices and supplier. You glance, and save.') },
      { title: L2('بِع بضغطة', 'Sell with a beep'), line: L2('باركود القطعة والكارتون والميزان. المخزون والربح والصندوق تتحدث وحدها.', 'Piece, carton and scale barcodes. Stock, profit and the drawer update themselves.') },
