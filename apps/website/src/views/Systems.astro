  sub: 'Website يضع عملك على الإنترنت، وConnect يرد على واتساب ويتابع عنك، وAI Studio يسوّق لك. تتّصل كلها بنظامك وتعمل من سجلاته نفسها، فلا شيء يُكتب مرتين. اختر نظامك، وفعّل ما تريد، وشاهد ما يتغيّر.',
  pick: 'نظامك', systems: [['realestate', 'العقارات'], ['store', 'المتاجر']],
  roadmap: 'أين وصلت الإضافات', rows: [['العقارات', 1], ['المتاجر', 1], ['العيادات', 0], ['الأندية', 0], ['المدارس', 0]] as [string, number][],
  trustTitle: 'تثق بها، ويثق بها زبائنك',
  trust: [['lock', 'عنوان خاص وآمن', 'باسم عملك على hemlohq.com، ومشفّر بـ HTTPS.'], ['wa', 'واتساب الرسمي', 'عبر منصة واتساب للأعمال من Meta: لا حظر، ولا تطبيقات وسيطة.'], ['spark', 'ذكاء لا يخترع', 'المساعد يرد من منتجاتك أو عقاراتك فقط، ولا يذكر سعراً لم تضعه.'], ['shield', 'بياناتك تبقى لك', 'كل شيء في نظامك، ويستطيع أي زبون إيقاف الرسائل بكلمة.']],
  more: 'العيادات والأندية والمدارس تأتي تباعاً.', soon: 'قريباً', on: 'متاح الآن',
}, {
  eyebrow: 'Build your Hemlo', live: 'Now for Real Estate and Stores · the rest are next',
  title: ['Any Hemlo system.', 'Add what it needs.'],
  sub: 'Website puts your business online, Connect answers and follows up on WhatsApp, and AI Studio markets for you. They plug into your system and work from its own records, so nothing is typed twice. Pick your system, switch on what you want, and watch what changes.',
  pick: 'Your system', systems: [['realestate', 'Real estate'], ['store', 'Stores']],
  roadmap: 'Where the add-ons are', rows: [['Real estate', 1], ['Stores', 1], ['Clinics', 0], ['Gyms', 0], ['Schools', 0]] as [string, number][],
  trustTitle: 'You can trust them, and so can your clients',
  trust: [['lock', 'Your own secure address', 'yourname.hemlohq.com, encrypted with HTTPS.'], ['wa', 'Official WhatsApp', 'Through Meta’s WhatsApp Business Platform: no bans, no middlemen.'], ['spark', 'AI that doesn’t invent', 'The assistant answers only from your own products or listings, and never quotes a price you didn’t set.'], ['shield', 'Your data stays yours', 'It all lives in your system, and any customer can stop messages with one word.']],
  more: 'Clinics, gyms and schools are next.', soon: 'Soon', on: 'Live now',
});
// ---------- what agencies ask before they buy the add-ons ----------
const FAQ = L2({ title: 'أسئلة قبل الاشتراك', items: [
  ['هل أحتاج رقم واتساب جديداً؟', 'الأفضل رقم مخصّص لعملك. قاعدة Meta: الرقم المستخدم الآن في تطبيق واتساب على الموبايل يجب أن يُحذف منه أولاً قبل ربطه، لذلك يختار أغلب أصحاب الأعمال شريحة جديدة لـ Connect ويبقون أرقامهم الشخصية كما هي.'],
  ['هل يمكن أن يُحظر رقمي؟', 'Connect يعمل عبر منصة واتساب للأعمال الرسمية من Meta، لا عبر تطبيقات وسيطة. الحظر يأتي عادة من الرسائل المزعجة، وConnect لا يراسل تلقائياً إلا من كتب لك أو وافق على العروض، ويوقف الرسائل فوراً لمن يكتب «إيقاف».'],
  ['هل رسائل واتساب عليّ؟', 'لا شيء عليك: رسائل واتساب مشمولة في خطتك وتدفعها Hemlo. الرصيد الشهري يكفي المحادثات اليومية والتذكيرات والتنبيهات المفيدة؛ أما الحملات الترويجية الكبيرة فلها حصة منه، لأن Meta تسعّر الرسالة الترويجية أعلى بكثير.'],
  ['هل يخترع المساعد الذكي أسعاراً أو وعوداً؟', 'لا. يرد من منتجاتك أو عقاراتك المنشورة فقط، والأسعار والروابط تضيفها Hemlo من نظامك لا الذكاء الاصطناعي، وأي رد فيه رقم لم يُعطَ له لا يُرسل. وتستطيع إيقافه بزر واحد.'],
  ['وإن أراد الزبون أن يكلّم شخصاً؟', 'يحوّل المساعد المحادثة إلى «تنتظرك» ويُبلّغ الموظف المسؤول عن الزبون، ويتوقف عن الرد فيها حتى تعيدها إليه.'],
  ['هل أحتاج Hemlo Website لأستخدم Connect؟', 'لا، كل إضافة تعمل وحدها. لكن معاً يكتمل الطريق: كل استفسار أو طلب من موقعك يصله رد على واتساب خلال ثوانٍ، ويُسجَّل في نظامك.'],
  ['هل أستطيع التجربة قبل الدفع؟', 'نعم. في نظامك وضع تجربة لـ Connect تكتب فيه كأنك زبون وترى كيف يرد، ولا تخرج أي رسالة. ولـ Website موقع نموذجي حي تفتحه الآن.'],
  ['كيف أدفع، وهل أستطيع الإلغاء؟', 'شهرياً أو سنوياً (شهران مجاناً)، بـ FIB أو زين كاش أو نقداً أو بتحويل. وتلغي متى شئت من صفحة «الخطة»، ويبقى المدفوع فعّالاً حتى نهاية مدته.'],
] }, { title: 'Questions before you subscribe', items: [
  ['Do I need a new WhatsApp number?', 'A number dedicated to your business is best. Meta’s rule: a number currently used in the WhatsApp app on a phone has to be removed from it before it can be connected, so most businesses get a new SIM for Connect and keep their personal numbers as they are.'],
  ['Can my number get banned?', 'Connect runs on Meta’s official WhatsApp Business Platform, not on unofficial apps. Bans usually come from spam, and Connect only messages people who wrote to you or agreed to offers, and stops at once for anyone who writes “stop”.'],
  ['Do I pay for WhatsApp messages?', 'Nothing for you: WhatsApp messaging is included in your plan, and Hemlo pays for it. The monthly allowance covers everyday conversations, reminders and useful alerts; big promotional blasts get a share of it, because Meta prices a promotional message far higher.'],
  ['Does the AI assistant make up prices or promises?', 'No. It answers only from your own products or published listings; prices and links are added by Hemlo from your system, not by the AI, and any reply with a number it wasn’t given is not sent. And one switch turns it off.'],
  ['What if a customer wants to talk to a person?', 'The assistant moves the chat to “Waiting on you”, tells the agent who looks after that customer, and stays quiet there until you hand it back.'],
  ['Do I need Hemlo Website to use Connect?', 'No, each works on its own. Together the path is complete: every inquiry or order from your website gets a WhatsApp reply within seconds, and lands in your system.'],
  ['Can I try before paying?', 'Yes. Your system has a Connect sandbox where you write as a customer and watch it answer, with no message leaving Hemlo. And Website has a live sample site you can open now.'],
  ['How do I pay, and can I cancel?', 'Monthly or yearly (two months free), by FIB, Zain Cash, cash or transfer. Cancel any time from the Plan page; what you paid for stays on until its end.'],
] });
const TRUST_ICON: Record<string, string> = {
  lock: '<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  spark: '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/>',
  wa: '<path d="M3 21l1.65-4.94A9 9 0 1 1 7.9 19.3L3 21Z"/><path d="M9 10c.5 2 2 3.5 4 4l1.2-1.2a1 1 0 0 1 1-.25l1.8.6"/>',
};
const END = L2(
  { title: 'نظام لمهنتك، لا العكس.', sub: 'المتاجر والعيادات والأندية الرياضية ومكاتب العقارات متاحة الآن. ولكل مهنة أخرى، أخبرنا كيف يسير عملك ونبني إصدارها.' },
  { title: 'A system for your trade, not the other way round.', sub: 'Shops, clinics, gyms and real estate offices are live now. For any other trade, tell us how your work runs and we’ll build its edition.' });
const num = (i: number) => (ar ? '١٢٣٤٥٦٧٨٩'[i] : String(i + 1));
---
<Base lang={lang} page="systems" title={t(lang).nav.systems} description={s.sub}>
  <div class="sys" style={`--c:${b.color};--cd:${b.dark};--t:${b.tint};--td:${b.tintDark}`}>

    <!-- the hero: pick what the business does, and watch its system work -->
    <section class="hx" data-hx data-trade="stores" style={`--acc:${TRADES[0].color}`}>
      <div class="hx-glow" aria-hidden="true"></div>
      <div class="wrap hx-grid">
        <div class="hx-copy">
          <a class="hx-news rise" href="#addons"><span class="n">{H.news[0]}</span><span class="t">{H.news[1]}</span><span class="arr" aria-hidden="true">→</span></a>
          <p class="mt-5 font-medium accent rise">{H.eyebrow}</p>
          <h1 class="mt-5 text-[clamp(2.3rem,4.6vw,3.9rem)] font-semibold leading-[1.05] tracking-tight rise rise-2"><span class="block">{H.title[0]}</span><span class="block hx-acc">{H.title[1]}</span></h1>
          <p class="mt-6 max-w-xl text-lead text-fg-2 rise rise-3">{H.sub}</p>
          <p class="mt-9 text-sm font-semibold text-fg-2 rise rise-4">{H.pick}</p>
          <div class="hx-pick rise rise-4" role="tablist" aria-label={H.pick}>
            <span class="hx-hl" aria-hidden="true"></span>
            {TRADES.map((x, i) => (
              <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-pick={x.kind} style={`--k:${x.color}`}>
                <span class="hx-n" aria-hidden="true">{ar ? '١٢٣٤٥'[i] : `0${i + 1}`}</span>
                <span class="hx-t"><b>{x.title}{x.scenes.some((sc) => sc.addon) && <span class="hx-plus">+ Website · Connect</span>}</b><span>{x.need}</span></span>
                <svg class="hx-ch" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" /></svg>
              </button>
            ))}
          </div>
          <a class="hx-other rise rise-5" href="#trades"><span>{L2('شيء آخر؟', 'Something else?')}</span> <b>{L2('ورشة، صالون، مقهى، فندق…', 'A workshop, salon, café, hotel…')}</b><span class="arr" aria-hidden="true">→</span></a>
        </div>

        <!-- one stage per trade; three scenes each, playing in turn (tap a step to jump) -->
        <div class="hx-side rise rise-3">
          <span class="hx-bigh" aria-hidden="true"><Mark /></span>
          {TRADES.map((x, ti) => (
            <div class="hx-stage" data-stage={x.kind} hidden={ti !== 0} style={`--k:${x.color}`}>
              <div class="hx-bar">
                <span class="hx-logo" aria-hidden="true"><Mark /></span>
                <span class="hx-name"><b>Hemlo</b> <span>{x.title}</span></span>
                <span class="hx-steps" role="tablist">
                  {x.scenes.map((_, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-step={i} aria-label={`${H.step} ${i + 1}`}><span class="hx-prog"></span></button>)}
                </span>
              </div>
              <div class="hx-view">
                {x.kind === 'stores' ? <>
                  <!-- 1 · the invoice photo, read by AI -->
                  <div class="sc sc-inv" data-scene="0">
                    <div class="inv-photo"><img src="/images/stores/invoice-photo.webp" width="560" height="493" alt="" loading="eager" decoding="async" /><i class="beam" aria-hidden="true"></i></div>
                    <div class="inv-out">
                      <p class="inv-head"><span class="spark" aria-hidden="true">✦</span><span class="text-xs text-fg-2">{SC.invRead}</span></p>
                      <p class="inv-sup">{SC.invSupplier} · INV-4200</p>
                      <ul>{SC.inv.map(([n, q, v], i) => <li style={`--i:${i}`}><span class="ok">✓</span><span class="flex-1 truncate">{n}</span><span class="text-fg-2" dir="ltr">{q}</span><b dir="ltr">{v}</b></li>)}</ul>
                      <p class="inv-total"><span>{SC.total}</span><b dir="ltr">84,200</b></p>
                    </div>
                  </div>
                  <!-- 2 · the till -->
                  <div class="sc sc-till" data-scene="1">
                    <div class="till">
                      <p class="scan"><span class="barcode" aria-hidden="true"></span><span dir="ltr">6281036001017</span><span class="beep">✓</span></p>
                      <ul>{SC.till.map(([n, q, v], i) => <li style={`--i:${i}`}><span class="flex-1 truncate">{n}</span><span class="text-fg-2" dir="ltr">{q}</span><b dir="ltr">{v}</b></li>)}</ul>
                      <p class="till-total"><span>{SC.total}</span><b dir="ltr">16,000</b></p>
                    </div>
                    <div class="fx">{SC.effects.map((e, i) => <span style={`--i:${i}`}>{e}</span>)}</div>
                  </div>
                  <!-- 3 · ask your shop -->
                  <div class="sc sc-ask" data-scene="2">
                    <p class="bubble q">{SC.q}</p>
                    <div class="bubble a"><p>{SC.a[0]} <b dir="ltr">{SC.a[1]}</b> {SC.a[2]} <b dir="ltr">{SC.a[3]}</b> {SC.a[4]}</p></div>
                  </div>
                  <!-- + Website · the online shop, and an order arriving -->
                  <div class="sc sc-site" data-scene="3" data-addon="web">
                    <div class="site"><p class="site-bar"><i></i><i></i><i></i><span dir="ltr">{SC.sUrl}</span></p>
                      <div class="site-grid">{SC.sTiles.map(([n, p], i) => <div class="st" style={`--i:${i}`}><span class="ph" style={`background-image:url(/images/stores/shop/${['amber', 'rose', 'gift-box'][i]}.webp)`}></span><b>{n}</b><em dir="ltr">{p}</em><span class="plus">+</span></div>)}</div>
                      <p class="site-cod">{SC.sCod}</p></div>
                    <p class="toast"><span class="ok">✓</span>{SC.sOrder}</p>
                  </div>
                  <!-- + Connect · WhatsApp: the order's update, and the assistant -->
                  <div class="sc sc-wa" data-scene="4" data-addon="con">
                    <div class="wchat">{SC.sWa.map(([who, t], i) => <p class:list={['wb', who]} style={`--i:${i}`}>{who === 'ai' && <span class="by">✦ Connect</span>}{t}</p>)}</div>
                  </div>
                  <!-- + AI Studio · a campaign from the product -->
                  <div class="sc sc-camp" data-scene="5" data-addon="studio">
                    <div class="camp"><span class="cimg" style="background-image:url(/images/stores/shop/amber.webp)"></span><div class="ct"><small>{SC.campByShop}</small><b>{SC.sCamp.h}</b><p>{SC.sCamp.p}</p><span class="tags">{SC.sCamp.tags.map((x) => <i>#{x}</i>)}</span></div></div>
                  </div>
                </> : x.kind === 'realestate' ? <>
                  <!-- 1 · the property, sent on WhatsApp, and opened -->
                  <div class="sc sc-rwa" data-scene="0">
                    <div class="rchat">
                      <div class="rcard">
                        <img src="/images/realestate/villa-1-sm.webp" width="700" height="467" alt="" loading="lazy" decoding="async" />
                        <div class="rcard-t"><b>{SC.rTitle}</b><small>{SC.rArea}</small><em dir="ltr">$185,000</em><span dir="ltr">hemlohq.com/p/villa-…</span></div>
                      </div>
                      <p class="rseen"><span aria-hidden="true">✓✓</span> {SC.rOpened}</p>
                    </div>
                  </div>
                  <!-- 2 · who wants it, and why -->
                  <div class="sc sc-rmatch" data-scene="1">
                    <div class="till"><ul>{SC.rLeads.map(([n, p, why], i) => <li style={`--i:${i}`}><span class="rring" style={`--p:${p}`}><b>{p}</b></span><span class="min-w-0 flex-1"><b class="block truncate">{n}</b><small class="rwhy">✓ {why}</small></span><b class="gwa rsend">{SC.rSend}</b></li>)}</ul></div>
                  </div>
                  <!-- 3 · the negotiation, closed -->
                  <div class="sc sc-rdeal" data-scene="2">
                    <div class="till">
                      <ul>{SC.rDeal.map(([k, v], i) => <li style={`--i:${i}`}><span class:list={['rdot', `rd${i}`]} aria-hidden="true"></span><span class="flex-1">{k}</span><b dir="ltr">{v}</b></li>)}</ul>
                      <p class="till-total rclosed"><span>{SC.rClosed}</span><b dir="ltr">$6,360</b></p>
                    </div>
                  </div>
                  <!-- + Website · the office's site, and an inquiry -->
                  <div class="sc sc-site" data-scene="3" data-addon="web">
                    <div class="site"><p class="site-bar"><i></i><i></i><i></i><span dir="ltr">{SC.rUrl}</span></p>
                      <div class="site-grid">{[['villa-3', '$265,000'], ['apartment-1', '$900'], ['villa-4', '$410,000']].map(([img, p], i) => <div class="st" style={`--i:${i}`}><span class="ph" style={`background-image:url(/images/realestate/sample/${img}.webp)`}></span><b>{SC.rTitle.split(' ').slice(0, 2).join(' ')}</b><em dir="ltr">{p}</em></div>)}</div></div>
                    <p class="toast"><span class="ok">✓</span>{SC.rInq}</p>
                  </div>
                  <!-- + Connect · the reply, and the viewing -->
                  <div class="sc sc-wa" data-scene="4" data-addon="con">
                    <div class="wchat">{SC.rWa.map(([who, t], i) => <p class:list={['wb', who]} style={`--i:${i}`}>{who === 'ai' && <span class="by">✦ Connect</span>}{t}</p>)}<p class="wbook" style="--i:3">{SC.rBooked}</p></div>
                  </div>
                  <!-- + AI Studio · a campaign from the property -->
                  <div class="sc sc-camp" data-scene="5" data-addon="studio">
                    <div class="camp"><span class="cimg" style="background-image:url(/images/realestate/sample/villa-3.webp)"></span><div class="ct"><small>{SC.campBy}</small><b>{SC.rCamp.h}</b><p>{SC.rCamp.p}</p><span class="tags">{SC.rCamp.tags.map((x) => <i>#{x}</i>)}</span></div></div>
                  </div>
                </> : x.kind === 'gym' ? <>
                  <!-- 1 · the desk: a scan, and the pass -->
                  <div class="sc sc-gpass" data-scene="0">
                    <div class="till gpass">
                      <p class="scan"><span class="barcode" aria-hidden="true"></span><span dir="ltr">HEMLO-GYM:WJ23N26MZC</span><span class="beep">✓</span></p>
                      <div class="gp"><span class="gp-face">{SC.gName.slice(0, 1)}</span><div class="min-w-0 flex-1"><p class="gp-in">✓ {SC.gIn}</p><b>{SC.gName}</b><small>{SC.gNo} · {SC.gMs}</small></div><span class="gp-days"><b>13</b><small>{SC.gDays}</small></span></div>
                    </div>
                  </div>
                  <!-- 2 · renewals, each a WhatsApp away -->
                  <div class="sc sc-grenew" data-scene="1">
                    <div class="till"><ul>{SC.gRenew.map(([n, w], i) => <li style={`--i:${i}`}><span class="flex-1 truncate">{n}</span><span class="text-fg-2">{w}</span><b class="gwa">{SC.gRemind}</b></li>)}</ul></div>
                  </div>
                  <!-- 3 · the door screen -->
                  <div class="sc sc-tv" data-scene="2">
                    <div class="tv gtv"><i class="ring" aria-hidden="true"></i><b>{SC.gDoor}</b><em>{SC.gDoorDays}</em></div>
                  </div>
                </> : <>
                  <!-- 1 · today's board -->
                  <div class="sc sc-board" data-scene="0">
                    {SC.cols.map((c, i) => <div class="col"><p>{c}</p>{i === 0 && <span class="card">{SC.p1}<small>15:00</small></span>}{i === 1 && <span class="card mover">{SC.p2}<small>14:30</small></span>}{i === 2 && <span class="card on">{SC.p3}<small>{SC.tvChair}</small></span>}</div>)}
                  </div>
                  <!-- 2 · the chart -->
                  <div class="sc sc-chart" data-scene="1">
                    <div class="chart-box">
                      <img src="/images/dental/chart-closeup-1100.webp" srcset="/images/dental/chart-closeup-640.webp 640w, /images/dental/chart-closeup-1100.webp 1100w" sizes="(min-width: 1024px) 420px, 80vw" width="1100" height="894" alt="" loading="lazy" decoding="async" />
                      <p class="pin"><i class="dot-r" aria-hidden="true"></i><b>{SC.plan}</b><span dir="ltr">{SC.price}</span></p>
                    </div>
                    <p class="wa"><span class="dotg"></span>{SC.sent}</p>
                  </div>
                  <!-- 3 · the waiting-room TV -->
                  <div class="sc sc-tv" data-scene="2">
                    <div class="tv"><i class="ring" aria-hidden="true"></i><b>{SC.tvName}</b><span>{SC.tvGo}</span><em>{SC.tvChair}</em></div>
                  </div>
                </>}
              </div>
              <div class="hx-add" role="group" aria-label={SC.add}>
                <span class="hx-add-k">{SC.add}</span>
                {([['web', 'Website', 'globe'], ['con', 'Connect', 'wa'], ['studio', 'AI Studio', 'spark']] as const).map(([k, label, ic]) => {
                  const at = x.scenes.findIndex((sc) => sc.addon === k);
                  return <button type="button" class:list={['hx-chip', `c-${k}`]} data-jump={at} disabled={at < 0} aria-pressed="false"><span class="ci" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={TRUST_ICON[ic]} /></span><b>{label}</b><small>{at < 0 ? SC.soon : SC.live}</small></button>;
                })}
              </div>
              <div class="hx-caps">
                {x.scenes.map((sc, i) => (
                  <div class="hx-cap" data-cap={i} hidden={i !== 0}>
                    <p class="hx-cap-k">{sc.addon ? `Hemlo ${sc.addon === 'web' ? 'Website' : sc.addon === 'con' ? 'Connect' : 'AI Studio'}` : ar ? `الخطوة ${num(i)} من ${'٣٤٥٦'[x.scenes.length - 3]}` : `Step ${i + 1} of ${x.scenes.length}`}</p><p class="hx-cap-t">{sc.title}</p>
                    <p class="hx-cap-l">{sc.line}</p>
                  </div>
                ))}
              </div>
              <div class="hx-go">
                <a class="btn btn-k" href={x.demo}>{L.demo}<span class="arr" aria-hidden="true">→</span></a>
                <a class="link-quiet" href={x.page}>{L.open}</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- how it works -->
    <section class="wrap border-t border-line py-20 sm:py-24" id="how">
      <h2 class="reveal text-[clamp(1.8rem,3.6vw,2.8rem)] font-semibold tracking-tight">{HOW.title}</h2>
      <ol class="how3 mt-10">
