      { title: L2('سجّل على مخطط الأسنان', 'Mark it on the tooth chart'), line: L2('خطة علاج بسعر واضح، تصل المريض على الواتساب.', 'A treatment plan with a clear price, sent to the patient on WhatsApp.') },
      { title: L2('شاشة الانتظار تنادي المريض', 'The waiting room calls them in'), line: L2('تلفزيون يعرض من التالي، ويناديه باسمه بنغمة هادئة.', 'A TV shows who’s next and calls them by name with a soft chime.') },
    ] as Scene[] },
  { kind: 'gym', color: '#E4572E', title: L2('نادٍ رياضي', 'Gym'), need: L2('مشتركون باشتراكات شهرية', 'Members on monthly memberships'), demo: SYS.gym.demo!, page: SYS.gym.page!,
    scenes: [
      { title: L2('مسحة واحدة عند الاستقبال', 'One scan at the desk'), line: L2('يدخل ويظهر كم بقي له. أو يظهر السبب بالأحمر، ومعه زر التجديد.', 'In, with the days left. Or the reason in red, with a renew button.') },
      { title: L2('التجديدات على الواتساب', 'Renewals on WhatsApp'), line: L2('من ينتهي هذا الأسبوع، برسالة جاهزة بكلماتك. لا اشتراك يفوتك.', 'Who ends this week, each with a message in your words. No renewal slips by.') },
      { title: L2('شاشة الباب ترحّب', 'The door says hello'), line: L2('تلفزيون عند المدخل يرحّب بكل مشترك باسمه، ويعرض كلاسات اليوم.', 'A TV at the entrance greets every member by name and shows today’s classes.') },
    ] as Scene[] },
