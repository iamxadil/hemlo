---
<Base lang={lang} page="systems" title={t(lang).nav.systems} description={s.sub}>
  <div class="sys" style={`--c:${b.color};--cd:${b.dark};--t:${b.tint};--td:${b.tintDark}`}>

    <!-- the hero: pick what the business does, and watch its system work -->
    <section class="hx" data-hx data-trade="stores" style={`--acc:${TRADES[0].color}`}>
      <div class="hx-glow" aria-hidden="true"></div>
      <div class="wrap hx-grid">
        <div class="hx-copy">
          <p class="font-medium accent rise">{H.eyebrow}</p>
          <h1 class="mt-5 text-[clamp(2.3rem,4.6vw,3.9rem)] font-semibold leading-[1.05] tracking-tight rise rise-2"><span class="block">{H.title[0]}</span><span class="block hx-acc">{H.title[1]}</span></h1>
          <p class="mt-6 max-w-xl text-lead text-fg-2 rise rise-3">{H.sub}</p>
          <p class="mt-9 text-sm font-semibold text-fg-2 rise rise-4">{H.pick}</p>
          <div class="hx-pick rise rise-4" role="tablist" aria-label={H.pick}>
            <span class="hx-hl" aria-hidden="true"></span>
            {TRADES.map((x, i) => (
              <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-pick={x.kind} style={`--k:${x.color}`}>
                <span class="hx-n" aria-hidden="true">{ar ? '١٢٣٤٥'[i] : `0${i + 1}`}</span>
                <span class="hx-t"><b>{x.title}</b><span>{x.need}</span></span>
                <svg class="hx-ch" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" /></svg>
              </button>
            ))}
          </div>
          <a class="hx-other rise rise-5" href="#trades"><span>{L2('شيء آخر؟', 'Something else?')}</span> <b>{L2('ورشة، صالون، مقهى، فندق…', 'A workshop, salon, café, hotel…')}</b><span class="arr" aria-hidden="true">→</span></a>
        </div>

        <!-- one stage per trade; three scenes each, playing in turn (tap a step to jump) -->
        <div class="hx-side rise rise-3">
          <span class="hx-bigh" aria-hidden="true"><Mark /></span>
          {TRADES.map((x, ti) => (
            <div class="hx-stage" data-stage={x.kind} hidden={ti !== 0} style={`--k:${x.color}`}>
              <div class="hx-bar">
                <span class="hx-logo" aria-hidden="true"><Mark /></span>
                <span class="hx-name"><b>Hemlo</b> <span>{x.title}</span></span>
                <span class="hx-steps" role="tablist">
                  {x.scenes.map((_, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-step={i} aria-label={`${H.step} ${i + 1}`}><span class="hx-prog"></span></button>)}
                </span>
              </div>
              <div class="hx-view">
                {x.kind === 'stores' ? <>
                  <!-- 1 · the invoice photo, read by AI -->
                  <div class="sc sc-inv" data-scene="0">
                    <div class="inv-photo"><img src="/images/stores/invoice-photo.webp" width="560" height="493" alt="" loading="eager" decoding="async" /><i class="beam" aria-hidden="true"></i></div>
                    <div class="inv-out">
                      <p class="inv-head"><span class="spark" aria-hidden="true">✦</span><span class="text-xs text-fg-2">{SC.invRead}</span></p>
                      <p class="inv-sup">{SC.invSupplier} · INV-4200</p>
                      <ul>{SC.inv.map(([n, q, v], i) => <li style={`--i:${i}`}><span class="ok">✓</span><span class="flex-1 truncate">{n}</span><span class="text-fg-2" dir="ltr">{q}</span><b dir="ltr">{v}</b></li>)}</ul>
                      <p class="inv-total"><span>{SC.total}</span><b dir="ltr">84,200</b></p>
                    </div>
                  </div>
                  <!-- 2 · the till -->
                  <div class="sc sc-till" data-scene="1">
                    <div class="till">
                      <p class="scan"><span class="barcode" aria-hidden="true"></span><span dir="ltr">6281036001017</span><span class="beep">✓</span></p>
                      <ul>{SC.till.map(([n, q, v], i) => <li style={`--i:${i}`}><span class="flex-1 truncate">{n}</span><span class="text-fg-2" dir="ltr">{q}</span><b dir="ltr">{v}</b></li>)}</ul>
                      <p class="till-total"><span>{SC.total}</span><b dir="ltr">16,000</b></p>
                    </div>
                    <div class="fx">{SC.effects.map((e, i) => <span style={`--i:${i}`}>{e}</span>)}</div>
                  </div>
                  <!-- 3 · ask your shop -->
                  <div class="sc sc-ask" data-scene="2">
                    <p class="bubble q">{SC.q}</p>
                    <div class="bubble a"><p>{SC.a[0]} <b dir="ltr">{SC.a[1]}</b> {SC.a[2]} <b dir="ltr">{SC.a[3]}</b> {SC.a[4]}</p></div>
                  </div>
                </> : x.kind === 'realestate' ? <>
                  <!-- 1 · the property, sent on WhatsApp, and opened -->
                  <div class="sc sc-rwa" data-scene="0">
                    <div class="rchat">
                      <div class="rcard">
                        <img src="/images/realestate/villa-1-sm.webp" width="700" height="467" alt="" loading="lazy" decoding="async" />
                        <div class="rcard-t"><b>{SC.rTitle}</b><small>{SC.rArea}</small><em dir="ltr">$185,000</em><span dir="ltr">hemlohq.com/p/villa-…</span></div>
                      </div>
                      <p class="rseen"><span aria-hidden="true">✓✓</span> {SC.rOpened}</p>
                    </div>
                  </div>
                  <!-- 2 · who wants it, and why -->
                  <div class="sc sc-rmatch" data-scene="1">
                    <div class="till"><ul>{SC.rLeads.map(([n, p, why], i) => <li style={`--i:${i}`}><span class="rring" style={`--p:${p}`}><b>{p}</b></span><span class="min-w-0 flex-1"><b class="block truncate">{n}</b><small class="rwhy">✓ {why}</small></span><b class="gwa rsend">{SC.rSend}</b></li>)}</ul></div>
                  </div>
                  <!-- 3 · the negotiation, closed -->
                  <div class="sc sc-rdeal" data-scene="2">
                    <div class="till">
                      <ul>{SC.rDeal.map(([k, v], i) => <li style={`--i:${i}`}><span class:list={['rdot', `rd${i}`]} aria-hidden="true"></span><span class="flex-1">{k}</span><b dir="ltr">{v}</b></li>)}</ul>
                      <p class="till-total rclosed"><span>{SC.rClosed}</span><b dir="ltr">$6,360</b></p>
                    </div>
                  </div>
                </> : x.kind === 'gym' ? <>
                  <!-- 1 · the desk: a scan, and the pass -->
                  <div class="sc sc-gpass" data-scene="0">
                    <div class="till gpass">
                      <p class="scan"><span class="barcode" aria-hidden="true"></span><span dir="ltr">HEMLO-GYM:WJ23N26MZC</span><span class="beep">✓</span></p>
                      <div class="gp"><span class="gp-face">{SC.gName.slice(0, 1)}</span><div class="min-w-0 flex-1"><p class="gp-in">✓ {SC.gIn}</p><b>{SC.gName}</b><small>{SC.gNo} · {SC.gMs}</small></div><span class="gp-days"><b>13</b><small>{SC.gDays}</small></span></div>
                    </div>
                  </div>
                  <!-- 2 · renewals, each a WhatsApp away -->
                  <div class="sc sc-grenew" data-scene="1">
                    <div class="till"><ul>{SC.gRenew.map(([n, w], i) => <li style={`--i:${i}`}><span class="flex-1 truncate">{n}</span><span class="text-fg-2">{w}</span><b class="gwa">{SC.gRemind}</b></li>)}</ul></div>
                  </div>
                  <!-- 3 · the door screen -->
                  <div class="sc sc-tv" data-scene="2">
                    <div class="tv gtv"><i class="ring" aria-hidden="true"></i><b>{SC.gDoor}</b><em>{SC.gDoorDays}</em></div>
                  </div>
                </> : <>
                  <!-- 1 · today's board -->
                  <div class="sc sc-board" data-scene="0">
                    {SC.cols.map((c, i) => <div class="col"><p>{c}</p>{i === 0 && <span class="card">{SC.p1}<small>15:00</small></span>}{i === 1 && <span class="card mover">{SC.p2}<small>14:30</small></span>}{i === 2 && <span class="card on">{SC.p3}<small>{SC.tvChair}</small></span>}</div>)}
                  </div>
                  <!-- 2 · the chart -->
                  <div class="sc sc-chart" data-scene="1">
                    <div class="chart-box">
                      <img src="/images/dental/chart-closeup-1100.webp" srcset="/images/dental/chart-closeup-640.webp 640w, /images/dental/chart-closeup-1100.webp 1100w" sizes="(min-width: 1024px) 420px, 80vw" width="1100" height="894" alt="" loading="lazy" decoding="async" />
                      <p class="pin"><i class="dot-r" aria-hidden="true"></i><b>{SC.plan}</b><span dir="ltr">{SC.price}</span></p>
                    </div>
                    <p class="wa"><span class="dotg"></span>{SC.sent}</p>
                  </div>
                  <!-- 3 · the waiting-room TV -->
                  <div class="sc sc-tv" data-scene="2">
                    <div class="tv"><i class="ring" aria-hidden="true"></i><b>{SC.tvName}</b><span>{SC.tvGo}</span><em>{SC.tvChair}</em></div>
                  </div>
                </>}
              </div>
              <div class="hx-caps">
                {x.scenes.map((sc, i) => (
                  <div class="hx-cap" data-cap={i} hidden={i !== 0}>
                    <p class="hx-cap-k">{ar ? `الخطوة ${num(i)} من ٣` : `Step ${i + 1} of 3`}</p><p class="hx-cap-t">{sc.title}</p>
                    <p class="hx-cap-l">{sc.line}</p>
                  </div>
                ))}
              </div>
              <div class="hx-go">
                <a class="btn btn-k" href={x.demo}>{L.demo}<span class="arr" aria-hidden="true">→</span></a>
                <a class="link-quiet" href={x.page}>{L.open}</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- how it works -->
    <section class="wrap border-t border-line py-20 sm:py-24" id="how">
      <h2 class="reveal text-[clamp(1.8rem,3.6vw,2.8rem)] font-semibold tracking-tight">{HOW.title}</h2>
      <ol class="how3 mt-10">
        {HOW.steps.map(([title, body], i) => (
          <li class="reveal"><span class="n">{num(i)}</span><h3 class="mt-4 text-xl font-medium tracking-tight">{title}</h3><p class="mt-2 leading-relaxed text-fg-2">{body}</p></li>
        ))}
      </ol>
      <p class="reveal helper"><span class="spark" aria-hidden="true">✦</span><span><b>{HELPER.lead}</b> {HELPER.body}</span></p>
    </section>

    <!-- features in every plan, and the add-ons on top: Hemlo Website is part of Hemlo Systems, not another branch -->
    <section class="wrap border-t border-line py-20 sm:py-28 web" id="addons">
      <!-- what it is, in one line -->
      <div class="web-head">
        <p class="reveal web-eyebrow"><HwBadge size="lg" tone="ink" /><span class="web-tag">{ADD.eyebrow}</span><span class="web-live"><span class="dot" aria-hidden="true"></span>{ADD.live}</span></p>
        <h2 class="reveal mt-5 text-[clamp(2rem,4.2vw,3.3rem)] font-semibold leading-[1.08] tracking-tight"><span class="block">{ADD.title[0]}</span><span class="block web-acc">{ADD.title[1]}</span></h2>
        <p class="reveal mt-5 text-lead text-fg-2">{ADD.sub}</p>
      </div>

      <!-- what it looks like: the sample site, in a browser, on its own address -->
      <a class="reveal web-shot" href={sampleHref} aria-label={ADD.sample} target="_blank" rel="noopener">
        <span class="web-chrome" aria-hidden="true"><i></i><i></i><i></i><span class="web-url" dir="ltr"><svg viewBox="0 0 16 16"><path d="M4.5 7V5.5a3.5 3.5 0 0 1 7 0V7M3.5 7h9v6.5h-9z" /></svg>{ADD.addr}</span></span>
        <img src={`/images/realestate/sample/site-${lang}-1400.webp`} srcset={`/images/realestate/sample/site-${lang}-800.webp 800w, /images/realestate/sample/site-${lang}-1400.webp 1400w`} sizes="(min-width: 1200px) 1100px, 92vw" width="1400" height="809" alt="" loading="lazy" decoding="async" />
        <span class="web-sync" aria-hidden="true"><span class="ok">✓</span><span><b>{ADD.synced}</b><small>{ADD.syncedSub}</small></span></span>
      </a>

      <!-- why it can be trusted: four plain facts -->
      <div class="reveal web-trust">
        <p class="text-sm font-semibold text-fg-2">{ADD.trustTitle}</p>
        <ul>{ADD.trust.map(([i, h, p]) => <li><span class="ti" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={TRUST_ICON[i]} /></span><span><b>{h}</b><span>{p}</span></span></li>)}</ul>
      </div>

      <!-- how it works, and the price -->
      <div class="web-grid">
        <div class="reveal">
          <p class="text-sm font-semibold text-fg-2">{ADD.how}</p>
          <ol class="web-steps">{ADD.steps.map(([h, p], i) => <li><span class="n">{num(i)}</span><span><b>{h}</b><span>{p}</span></span></li>)}</ol>
          <p class="mt-5 text-sm text-fg-2">{ADD.more}</p>
        </div>
        <article class="reveal web-price">
          <HwBadge />
          <p class="web-amount"><b dir="ltr">{ADD.price}</b><span>{ADD.per}</span></p>
          <p class="web-ontop">{ADD.onTop}</p>
          <p class="web-year">{ADD.year}</p>
          <ul class="web-inc">{ADD.included.map((x) => <li>{x}</li>)}</ul>
          <div class="web-cta">
            <a class="btn web-btn" href={sampleHref} target="_blank" rel="noopener">{ADD.sample}<span class="arr" aria-hidden="true">→</span></a>
            <a class="btn btn-secondary" href={ask('realestate')}>{L.ask}</a>
          </div>
          <p class="web-note">{ADD.turnOn}</p>
        </article>
      </div>

      <!-- the core plans, quietly: every feature in every plan -->
      <div class="reveal web-plans">
        <p><b>{ADD.plansTitle}</b> <span>{ADD.plansSub}</span></p>
        <ul>{ADD.plans.map((x) => <li>{x}</li>)}</ul>
      </div>
    </section>

    <!-- a system, or a website built for you? the difference at a glance -->
    <section class="wrap py-20 sm:py-24" id="compare"><Compare lang={lang} here="systems" /></section>

    <!-- every system -->
    <section class="wrap border-t border-line py-20 sm:py-24" id="trades">
      <div class="max-w-3xl">
        <h2 class="reveal text-[clamp(1.8rem,3.6vw,2.8rem)] font-semibold tracking-tight">{s.pickTitle}</h2>
        <p class="reveal mt-4 text-lead text-fg-2">{s.pickSub}</p>
      </div>
      <!-- every system, one line each; open one to see what it does (native exclusive accordion: no script) -->
      <div class="mt-10 acc">
        {systems.map(([name, examples, status, kind], i) => {
          const d = SYS[kind], live = !!d.page;
          return (
            <details name="systems" class:list={['reveal sys-item', `sys-${kind}`, live && 'is-live']} open={i === 0}>
              <summary>
                <span class="sys-n" aria-hidden="true">{ar ? num(i) : String(i + 1).padStart(2, '0')}</span>
                <span class="sys-name">{name}</span>
                <span class="sys-ex">{examples}</span>
                <span class="sys-status">{live && <span class="dot" aria-hidden="true"></span>}{status}</span>
                <span class="sys-chev" aria-hidden="true"></span>
              </summary>
              <div class="sys-body">
                <div class="sys-text">
                  {!live && <p class="sys-soon">{L.soon}</p>}
                  <ul class="sys-points">{d.points.map((p) => <li>{p}</li>)}</ul>
                  <div class="sys-go">
                    {live ? <>
                      <a class="btn btn-sys" href={d.page}>{L.open}<span class="arr" aria-hidden="true">→</span></a>
                      <a class="btn btn-secondary" href={d.demo}>{L.demo}</a>
                    </> : <a class="btn btn-secondary" href={ask(kind)}>{L.ask}<span class="arr" aria-hidden="true">→</span></a>}
                  </div>
                </div>
                {d.pic && <a class="sys-pic" href={d.page} tabindex="-1" aria-hidden="true"><img src={d.pic} width="1000" height="625" alt="" loading="lazy" decoding="async" /></a>}
              </div>
            </details>
          );
        })}
      </div>
      <p class="reveal mt-8 text-fg-2">{s.otherTrade} <a class="link-arrow" href={ask('other')}>{s.tellUs} <span class="arr">→</span></a></p>
    </section>

    <!-- the end -->
    <section class="wrap pb-24 sm:pb-32">
      <div class="reveal end relative overflow-hidden rounded-[2rem] p-10 sm:p-16">
        <Mark class="end-mark" />
        <div class="relative max-w-2xl">
          <h2 class="text-display font-semibold tracking-tight">{END.title}</h2>
          <p class="mt-4 text-lead text-fg-2">{END.sub}</p>
          <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a class="btn btn-sys" href="#trades">{s.heroCta}<span class="arr" aria-hidden="true">→</span></a>
            <a class="btn btn-secondary" href={ask('other')}>{s.tellUs}</a>
            <a class="link-quiet" href={mail} dir="ltr">{EMAIL}</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  // The hero's story: scenes play in turn (4.8 s each) while the hero is on screen and not being touched; a step or a
  // trade can be picked by hand. With reduced motion, nothing plays by itself.
  const STEP_MS = 4800;
  let stop: (() => void) | null = null;
  const init = () => {
    const root = document.querySelector<HTMLElement>('[data-hx]');
    if (!root) return;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let trade = root.dataset.trade!, step = 0, timer = 0, visible = true, held = false;
    const stage = () => root.querySelector<HTMLElement>(`[data-stage="${trade}"]`)!;
    const show = (i: number) => {
      const st = stage(), n = st.querySelectorAll('[data-scene]').length;
      step = (i + n) % n;
      st.querySelectorAll<HTMLElement>('[data-scene]').forEach((el) => { el.classList.remove('on'); });
      void st.offsetWidth; // restart the scene's animations
      st.querySelector<HTMLElement>(`[data-scene="${step}"]`)!.classList.add('on');
      st.querySelectorAll<HTMLElement>('[data-cap]').forEach((el) => { el.hidden = Number(el.dataset.cap) !== step; });
      st.querySelectorAll<HTMLElement>('[data-step]').forEach((el) => { const k = Number(el.dataset.step); el.setAttribute('aria-selected', String(k === step)); el.classList.toggle('done', k < step); });
      schedule();
    };
    const schedule = () => {
      clearTimeout(timer);
      root.classList.toggle('playing', !reduced && visible && !held);
      if (!reduced && visible && !held) timer = window.setTimeout(() => show(step + 1), STEP_MS);
    };
    const pickTrade = (k: string) => {
      trade = k; root.dataset.trade = k;
      const x = root.querySelector<HTMLElement>(`[data-pick="${k}"]`)!;
      root.style.setProperty('--acc', x.style.getPropertyValue('--k'));
      root.querySelectorAll('[data-pick]').forEach((b) => b.setAttribute('aria-selected', String(b === x)));
      place();
      root.querySelectorAll<HTMLElement>('[data-stage]').forEach((s) => { s.hidden = s.dataset.stage !== k; });
      show(0);
    };
    const hl = root.querySelector<HTMLElement>('.hx-hl')!;
    const place = () => { const x = root.querySelector<HTMLElement>(`[data-pick="${trade}"]`)!; hl.style.height = `${x.offsetHeight}px`; hl.style.transform = `translateY(${x.offsetTop}px)`; };
    place(); document.fonts?.ready.then(place); addEventListener('resize', place);
    root.querySelectorAll<HTMLElement>('[data-pick]').forEach((b) => b.addEventListener('click', () => pickTrade(b.dataset.pick!)));
    root.querySelectorAll<HTMLElement>('[data-step]').forEach((b) => b.addEventListener('click', () => show(Number(b.dataset.step))));
    const side = root.querySelector<HTMLElement>('.hx-side')!;
    const hold = (on: boolean) => () => { held = on; schedule(); };
    side.addEventListener('pointerenter', hold(true)); side.addEventListener('pointerleave', hold(false));
    side.addEventListener('focusin', hold(true)); side.addEventListener('focusout', hold(false));
    const io = new IntersectionObserver(([e]) => { visible = e.isIntersecting; schedule(); }, { threshold: 0.25 });
    io.observe(side);
    const vis = () => { visible = !document.hidden; schedule(); };
    document.addEventListener('visibilitychange', vis);
    show(0);
    stop = () => { clearTimeout(timer); io.disconnect(); document.removeEventListener('visibilitychange', vis); removeEventListener('resize', place); };
  };
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => { stop?.(); stop = null; });
</script>

<style>
  .accent { color: var(--c); }
  @media (prefers-color-scheme: dark) { .accent { color: var(--cd); } }
  .spark { color: var(--acc, var(--c)); font-size: .9em; line-height: 1; }
  /* motion: a strong ease-out for things arriving, a strong ease-in-out for things moving across the screen */
  .hx { --out: cubic-bezier(.23, 1, .32, 1); --io: cubic-bezier(.77, 0, .175, 1); }

  /* ---------- the hero ---------- */
  .hx { --acc: #A8532E; position: relative; overflow: hidden; padding: 3rem 0 4rem; }
  @media (min-width: 640px) { .hx { padding: 4.5rem 0 5.5rem; } }
  .hx-glow { position: absolute; inset: 0; pointer-events: none; transition: background .8s ease;
    background: radial-gradient(46% 52% at 78% 42%, color-mix(in oklab, var(--acc) 14%, transparent), transparent 70%); }
  :global(html[dir="rtl"]) .hx-glow { transform: scaleX(-1); }
  .hx-grid { position: relative; display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 1024px) { .hx-grid { grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: 3rem; } }
  .hx-acc { color: var(--acc); transition: color .5s ease; }
  /* the picker: a numbered index; a soft highlight slides to the chosen trade, with its colour on the edge */
  .hx-pick { position: relative; display: grid; margin-top: .9rem; border-top: 1px solid var(--line); }
  .hx-pick button { position: relative; z-index: 1; display: grid; grid-template-columns: 2.4rem minmax(0, 1fr) auto; align-items: center; gap: .2rem .6rem; padding: 1rem .9rem; border-bottom: 1px solid var(--line); text-align: start; color: var(--fg-2); transition: color .25s ease; }
  .hx-pick button:active { transform: scale(.99); }
  .hx-n { font-size: .78rem; font-weight: 500; font-variant-numeric: tabular-nums; color: var(--muted); transition: color .25s ease; }
  .hx-t { display: grid; gap: .1rem; min-width: 0; }
  .hx-t b { font-size: 1.08rem; font-weight: 600; color: var(--fg); letter-spacing: -.01em; transition: color .25s ease; }
  :global(html[lang="ar"]) .hx-t b { letter-spacing: 0; }
  .hx-t span { font-size: .88rem; color: var(--muted); }
  .hx-ch { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; opacity: 0; transform: translateX(-4px); transition: opacity .25s, transform .35s var(--out); }
  :global(html[dir="rtl"]) .hx-ch { scale: -1 1; }
  .hx-pick button[aria-selected="true"] .hx-n, .hx-pick button[aria-selected="true"] .hx-t b { color: var(--k); }
  .hx-pick button[aria-selected="true"] .hx-ch { opacity: 1; transform: none; color: var(--k); }
  @media (hover: hover) and (pointer: fine) { .hx-pick button:hover .hx-ch { opacity: .6; transform: none; } }
  [data-pick="dental"][aria-selected="true"] .hx-t b, [data-pick="dental"][aria-selected="true"] .hx-n { color: #8A6A22; }
  @media (prefers-color-scheme: dark) { [data-pick="dental"][aria-selected="true"] .hx-t b, [data-pick="dental"][aria-selected="true"] .hx-n { color: #D7B46A; } }
  .hx-hl { position: absolute; z-index: 0; inset-inline: 0; top: 0; height: 0; background: linear-gradient(to right, color-mix(in oklab, var(--acc) 10%, transparent), transparent 90%); pointer-events: none; transition: transform .55s var(--out), height .55s var(--out); }
  :global(html[dir="rtl"]) .hx-hl { background: linear-gradient(to left, color-mix(in oklab, var(--acc) 10%, transparent), transparent 90%); }
  .hx-hl::before { content: ""; position: absolute; inset-block: 0; inset-inline-start: 0; width: 2px; background: var(--acc); }
  .hx-other { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: .35rem; margin-top: 1rem; padding-inline: .9rem; font-size: .92rem; color: var(--muted); }
  .hx-other b { font-weight: 500; color: var(--fg); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 4px; transition: text-decoration-color .2s; }
  .hx-other:hover b { text-decoration-color: currentColor; }
  .hx-other .arr { color: var(--fg); }
  :global(html[dir="rtl"]) .hx-other .arr { transform: scaleX(-1); }

  .hx-side { position: relative; min-width: 0; }
  /* the founder's H, huge and faint behind the window, in the chosen trade's colour */
  .hx-bigh { position: absolute; left: 50%; top: 50%; height: 118%; translate: -50% -50%; color: var(--acc); opacity: .07; pointer-events: none; }
  .hx-bigh :global(svg) { display: block; height: 100%; width: auto; }
  @media (prefers-color-scheme: dark) { .hx-bigh { opacity: .1; } }
  .hx-stage { position: relative; border-radius: 1.6rem; background: var(--surface); border: 1px solid var(--line); overflow: hidden;
    box-shadow: 0 1px 2px rgb(14 20 32 / .05), 0 50px 100px -50px color-mix(in oklab, var(--acc) 55%, rgb(14 20 32 / .6)); }
  .hx-stage[hidden] { display: none; }
  /* the title bar: ink, like the brand, with the H in the trade's colour */
  .hx-bar { display: flex; align-items: center; gap: .6rem; padding: .75rem 1rem; background: #0E1420; color: #F2F1EC; }
  .hx-logo { display: grid; place-items: center; width: 1.7rem; height: 1.7rem; border-radius: .5rem; background: rgb(255 255 255 / .07); color: var(--k); }
  .hx-logo :global(svg) { height: .95rem; width: auto; }
  .hx-name { flex: 1; display: inline-flex; align-items: baseline; gap: .4rem; font-size: .82rem; }
  .hx-name b { font-weight: 600; }
  .hx-name span { color: rgb(242 241 236 / .6); font-weight: 300; }
  [data-stage="dental"] .hx-logo { color: #D7B46A; }
  .hx-steps { display: inline-flex; gap: .35rem; }
  .hx-steps button { position: relative; width: 2.1rem; height: .3rem; border-radius: 999px; background: rgb(255 255 255 / .14); overflow: hidden; cursor: pointer; }
  .hx-steps button::before { content: ""; position: absolute; inset: -.6rem -.1rem; } /* a bigger tap target */
  .hx-prog { position: absolute; inset: 0; background: var(--acc); transform-origin: left; transform: scaleX(0); }
  :global(html[dir="rtl"]) .hx-prog { transform-origin: right; }
  .hx-steps button.done .hx-prog { transform: scaleX(1); }
  .hx-steps button[aria-selected="true"] .hx-prog { transform: scaleX(1); }
  .hx.playing .hx-steps button[aria-selected="true"] .hx-prog { animation: prog 4.8s linear both; }
  @keyframes prog { from { transform: scaleX(0); } }

  .hx-view { position: relative; aspect-ratio: 16 / 10.5; background: color-mix(in oklab, var(--acc) 5%, var(--canvas)); overflow: hidden; }
  @media (max-width: 520px) { .hx-view { aspect-ratio: 1 / .95; } }
  .sc { position: absolute; inset: 0; display: grid; place-items: center; padding: 1.2rem; opacity: 0; visibility: hidden; transform: scale(.98); filter: blur(3px);
    transition: opacity .35s var(--out), transform .35s var(--out), filter .35s var(--out), visibility 0s .35s; }
  .sc.on { opacity: 1; visibility: visible; transform: none; filter: none; transition: opacity .5s var(--out), transform .5s var(--out), filter .5s var(--out); }
  .hx-caps { padding: 1.1rem 1.3rem .3rem; min-height: 6.6rem; border-top: 1px solid var(--line); }
  .hx-cap-k { font-size: .75rem; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: var(--acc); }
  :global(html[lang="ar"]) .hx-cap-k { letter-spacing: 0; font-size: .8rem; }
  [data-stage="dental"] .hx-cap-k { color: #8A6A22; }
  @media (prefers-color-scheme: dark) { [data-stage="dental"] .hx-cap-k { color: #D7B46A; } }
  .hx-cap-t { margin-top: .25rem; font-weight: 600; font-size: 1.1rem; letter-spacing: -.01em; }
  :global(html[lang="ar"]) .hx-cap-t { letter-spacing: 0; }
  .hx-cap-l { margin-top: .35rem; color: var(--fg-2); line-height: 1.5; font-size: .95rem; }
  .hx-go { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1.2rem; padding: .8rem 1.3rem 1.3rem; }
  .btn-k { background: var(--k); color: #fff; padding: .75rem 1.2rem; transition: transform .16s var(--out), filter .2s ease; }
  .btn-k:hover { filter: brightness(1.07); }
  [data-stage="dental"] .btn-k { color: #0B1019; } /* ink on brass reads; white doesn't */
  :global(html[dir="rtl"]) .btn-k .arr { transform: scaleX(-1); }
  .ok { display: grid; place-items: center; width: 1.1rem; height: 1.1rem; border-radius: 999px; background: color-mix(in oklab, #1F9D5B 16%, transparent); color: #1F9D5B; font-size: .65rem; flex: none; }

  /* shop 1 · the invoice, read */
  .sc-inv { grid-template-columns: .9fr 1.1fr; gap: 1rem; align-items: center; }
  .inv-photo { position: relative; border-radius: .7rem; overflow: hidden; box-shadow: 0 18px 30px -16px rgb(0 0 0 / .45); transform: rotate(-3deg); }
  :global(html[dir="rtl"]) .inv-photo { transform: rotate(3deg); }
  .inv-photo img { display: block; width: 100%; height: auto; }
  .beam { position: absolute; inset-inline: 0; top: 0; height: 26%; background: linear-gradient(180deg, transparent, color-mix(in oklab, var(--acc) 45%, transparent), transparent); opacity: 0; }
  .on .beam { animation: beam 1.3s ease-in-out 2 alternate both; }
  @keyframes beam { from { opacity: 1; transform: translateY(-30%); } to { opacity: 1; transform: translateY(300%); } }
  .inv-out { display: grid; gap: .45rem; padding: .8rem; border-radius: .9rem; background: var(--surface); border: 1px solid var(--line); font-size: .8rem; }
  .inv-head { display: flex; align-items: center; justify-content: space-between; gap: .4rem; }
  .inv-sup { font-weight: 600; }
  .inv-out ul { display: grid; gap: .25rem; }
  .inv-out li { display: flex; align-items: center; gap: .45rem; padding: .3rem .4rem; border-radius: .45rem; background: var(--sunken); }
  .on .inv-out li { animation: pop .4s var(--out) both; animation-delay: calc(1.4s + var(--i) * .12s); }
  .inv-total { display: flex; justify-content: space-between; font-weight: 600; padding-top: .3rem; border-top: 1px dashed var(--line-strong); }
  .on .inv-total, .on .inv-head, .on .inv-sup { animation: pop .4s var(--out) both 1.2s; }
  @keyframes pop { from { opacity: 0; transform: translateY(6px); } }
  @media (max-width: 520px) { .sc-inv { grid-template-columns: 1fr; } .inv-photo { display: none; } }

  /* shop 2 · the till */
  .sc-till { grid-template-rows: auto auto; gap: .9rem; }
  .till { width: min(22rem, 100%); padding: .9rem; border-radius: 1rem; background: var(--surface); border: 1px solid var(--line); display: grid; gap: .5rem; font-size: .85rem; }
  .scan { display: flex; align-items: center; gap: .55rem; padding: .45rem .6rem; border-radius: .6rem; border: 1.5px solid var(--acc); font-family: ui-monospace, monospace; font-size: .78rem; }
  .barcode { width: 1.4rem; height: .9rem; background: repeating-linear-gradient(90deg, var(--fg) 0 1px, transparent 1px 3px, var(--fg) 3px 5px, transparent 5px 6px); }
  .beep { margin-inline-start: auto; color: #1F9D5B; font-weight: 700; opacity: 0; }
  .on .beep { animation: pop .3s both .5s; }
  .till ul { display: grid; gap: .3rem; }
  .till li { display: flex; gap: .6rem; padding: .35rem .2rem; border-bottom: 1px solid var(--line); }
  .on .till li { animation: pop .35s var(--out) both; animation-delay: calc(.7s + var(--i) * .5s); }
  .till-total { display: flex; justify-content: space-between; font-size: 1.05rem; font-weight: 700; }
  .fx { display: flex; flex-wrap: wrap; justify-content: center; gap: .45rem; }
  .fx span { padding: .3rem .7rem; border-radius: 999px; font-size: .78rem; font-weight: 600; background: var(--surface); border: 1px solid color-mix(in oklab, var(--acc) 35%, var(--line)); color: var(--acc); }
  .on .fx span { animation: pop .4s var(--out) both; animation-delay: calc(2s + var(--i) * .25s); }

  /* shop 3 · ask */
  .sc-ask { align-content: center; gap: .8rem; justify-items: stretch; padding-inline: clamp(1rem, 6%, 3rem); }
  .bubble { max-width: 85%; padding: .7rem 1rem; border-radius: 1.1rem; font-size: .95rem; line-height: 1.5; }
  .bubble.q { justify-self: end; background: var(--acc); color: #fff; border-end-end-radius: .3rem; }
  .bubble.a { justify-self: start; display: grid; gap: .4rem; background: var(--surface); border: 1px solid var(--line); border-end-start-radius: .3rem; }
  .on .bubble.q { animation: pop .4s var(--out) both .2s; }
  .on .bubble.a { animation: pop .45s var(--out) both 1.3s; }

  /* clinic 1 · the board */
  .sc-board { grid-template-columns: repeat(3, minmax(0, 1fr)); place-items: stretch; gap: .6rem; padding: 1rem; }
  .col { display: flex; flex-direction: column; gap: .5rem; padding: .6rem; border-radius: .9rem; background: var(--surface); border: 1px solid var(--line); }
  .col p { font-size: .72rem; font-weight: 600; color: var(--fg-2); text-transform: uppercase; letter-spacing: .06em; }
  :global(html[lang="ar"]) .col p { letter-spacing: 0; font-size: .8rem; }
  .card { display: grid; gap: .1rem; padding: .5rem .6rem; border-radius: .6rem; background: var(--canvas); border: 1px solid var(--line); border-inline-start: 3px solid var(--acc); font-size: .8rem; font-weight: 600; }
  .card small { font-weight: 400; color: var(--fg-2); }
  .card.on { background: color-mix(in oklab, var(--acc) 12%, var(--surface)); }
  .card.mover { position: relative; z-index: 1; }
  .on .card.mover { animation: move 1.1s var(--io) both 1.2s; }
  /* one column across (its width + the column's padding and border + the gap), and down below the patient already seated */
  @keyframes move { 40% { transform: translate(0, -.3rem) scale(1.04); box-shadow: 0 14px 24px -12px rgb(0 0 0 / .35); } to { transform: translate(calc(100% + 1.85rem), calc(100% + .5rem)); background: color-mix(in oklab, var(--acc) 12%, var(--surface)); } }
  :global(html[dir="rtl"]) .on .card.mover { animation-name: move-rtl; }
  @keyframes move-rtl { 40% { transform: translate(0, -.3rem) scale(1.04); box-shadow: 0 14px 24px -12px rgb(0 0 0 / .35); } to { transform: translate(calc(-100% - 1.85rem), calc(100% + .5rem)); background: color-mix(in oklab, var(--acc) 12%, var(--surface)); } }

  /* clinic 2 · the chart */
  /* a close-up of one side of the jaw, on paper: an existing filling (blue), a crown planned on 46 (red), a filling done (green) */
  .sc-chart { background: #FAF8F6; padding: 3rem 1rem 3.4rem; }
  .chart-box { position: relative; width: 100%; height: 100%; min-height: 0; }
  .chart-box img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; } /* always whole, never cropped */
  .on .chart-box img { animation: settle 1.1s var(--out) both; }
  @keyframes settle { from { opacity: 0; transform: scale(1.04); } }
  .pin, .wa { position: absolute; display: flex; align-items: center; gap: .5rem; padding: .45rem .75rem; border-radius: .8rem; background: #fff; color: #0E1420; font-size: .8rem;
    border: 1px solid rgb(14 20 32 / .08); box-shadow: 0 10px 24px -12px rgb(14 20 32 / .35); white-space: nowrap; }
  .pin { top: -2.2rem; left: 50%; translate: -50% 0; } /* above tooth 46 (the chart is drawn left to right in every language) */
  .pin span { color: #6B7280; }
  .dot-r { width: .5rem; height: .5rem; border-radius: 999px; background: #D23C4B; }
  .wa { bottom: .7rem; left: 50%; translate: -50% 0; }
  .dotg { width: .55rem; height: .55rem; border-radius: 999px; background: #25D366; }
  .on .pin { animation: pop .4s var(--out) both .8s; }
  .on .wa { animation: pop .4s var(--out) both 2.2s; }

  /* clinic 3 · the TV */
  .sc-tv { padding: 1.4rem; }
  /* the real estate office's scenes */
  .rchat { width: min(21rem, 100%); display: grid; gap: .45rem; padding: .9rem; border-radius: 1.1rem; background: #E6EFE8; }
  .rcard { justify-self: end; width: 86%; overflow: hidden; border-radius: .9rem .9rem .25rem .9rem; background: #fff; color: #0E1420; box-shadow: 0 10px 24px -14px rgb(14 20 32 / .35); }
  :global(html[dir="rtl"]) .rcard { justify-self: start; border-radius: .9rem .9rem .9rem .25rem; }
  .rcard img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .rcard-t { display: grid; gap: .1rem; padding: .55rem .7rem .65rem; }
  .rcard-t b { font-size: .86rem; font-weight: 600; }
  .rcard-t small { font-size: .72rem; color: #5B6472; }
  .rcard-t em { font-style: normal; font-size: .95rem; font-weight: 700; }
  .rcard-t span { font-size: .68rem; color: #1F6F5C; }
  .on .rcard { animation: pop .45s var(--out) both .25s; }
  .rseen { justify-self: end; font-size: .74rem; font-weight: 600; color: #1F6F5C; }
  .rseen span { color: #34B7F1; letter-spacing: -.15em; margin-inline-end: .2rem; }
  :global(html[dir="rtl"]) .rseen { justify-self: start; }
  .on .rseen { animation: pop .4s var(--out) both 1.8s; }
  .sc-rmatch .till li, .sc-rdeal .till li { align-items: center; }
  .rring { display: grid; place-items: center; flex: none; width: 2.3rem; height: 2.3rem; border-radius: 999px; background: conic-gradient(var(--k) calc(var(--p) * 1%), var(--line) 0); }
  .rring b { display: grid; place-items: center; width: 1.8rem; height: 1.8rem; border-radius: 999px; background: var(--surface); font-size: .68rem; font-weight: 700; }
  .rwhy { display: block; font-size: .72rem; color: var(--k); }
  .rsend { background: #1E8E50; }
  .rdot { flex: none; width: .6rem; height: .6rem; border-radius: 999px; border: 2px solid var(--muted); }
  .rd1 { border-color: #2F6FB0; } .rd2 { border-color: #C77D16; } .rd3 { border-color: var(--k); background: var(--k); }
  .rclosed { color: var(--k); }
  .on .rclosed { animation: pop .45s var(--out) both 2.6s; }
  @media (prefers-color-scheme: dark) {
    [data-stage="realestate"], [data-pick="realestate"] { --k: #5CC4A2 !important; }
    [data-stage="realestate"] .btn-k { color: #08130F; }
    .rchat { background: #1B2A24; }
  }
  /* the gym's scenes */
  .gp { display: flex; align-items: center; gap: .8rem; padding: .7rem; border-radius: .9rem; background: color-mix(in oklab, #1E8E50 8%, var(--surface)); border-inline-start: 4px solid #1E8E50; }
  .on .gp { animation: pop .45s var(--out) both .7s; }
  .gp-face { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 999px; background: var(--sunken); box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px #1E8E50; font-weight: 700; flex: none; }
  .gp-in { font-size: .7rem; font-weight: 700; color: #1E8E50; }
  .gp b { display: block; font-size: 1rem; }
  .gp small { color: var(--fg-2); font-size: .74rem; }
  .gp-days { display: grid; justify-items: center; line-height: 1; }
  .gp-days b { font-size: 1.7rem; font-weight: 750; }
  .gp-days small { font-size: .62rem; }
  .gwa { padding: .15rem .55rem; border-radius: 999px; background: #1E8E50; color: #fff; font-size: .72rem; font-weight: 600; }
  .gtv { background: radial-gradient(70% 70% at 80% 0%, rgb(228 87 46 / .3), transparent 70%), #0E0F12 !important; }
  .gtv em { color: #7FE0AB !important; }
  .tv { position: relative; display: grid; place-content: center; justify-items: center; gap: .2rem; width: 100%; height: 100%; border-radius: 1rem; overflow: hidden; color: #F4F1EA; text-align: center;
    background: radial-gradient(60% 60% at 50% 50%, rgb(201 165 90 / .25), #0B1019 75%); box-shadow: 0 0 0 .5rem #1A202C, 0 24px 50px -20px rgb(0 0 0 / .6); }
  .tv b { font-size: clamp(1.8rem, 5vw, 2.8rem); font-weight: 600; }
  .tv span { color: rgb(244 241 234 / .7); font-size: .9rem; }
  .tv em { font-style: normal; font-size: 1.4rem; color: #E3C88A; font-weight: 500; }
  .ring { position: absolute; width: 40%; aspect-ratio: 1; border-radius: 999px; border: 2px solid rgb(227 200 138 / .7); opacity: 0; }
  .on .ring { animation: ring 2.2s var(--ease-soft) infinite .3s; }
  @keyframes ring { from { transform: scale(.6); opacity: .8; } to { transform: scale(2.4); opacity: 0; } }
  .on .tv > :not(.ring) { animation: pop .5s var(--out) both .3s; }

  /* ---------- how it works, and the quiet helper ---------- */
  .helper { display: flex; gap: .75rem; align-items: baseline; max-width: 46rem; margin-top: 2.5rem; padding-top: 1.4rem; border-top: 1px solid var(--line); color: var(--fg-2); line-height: 1.6; }
  .helper b { color: var(--fg); font-weight: 600; }
  .helper .spark { color: var(--c); font-size: 1.1rem; }
  @media (prefers-color-scheme: dark) { .helper .spark { color: var(--cd); } }
  /* ---------- Hemlo Website: what it is, what it looks like, how it works, what it costs ---------- */
  .web { --re: #1F6F5C; --re-soft: color-mix(in oklab, #1F6F5C 10%, transparent); }
  @media (prefers-color-scheme: dark) { .web { --re: #5FBF9F; --re-soft: color-mix(in oklab, #5FBF9F 14%, transparent); } }
  .web-head { max-width: 46rem; }
  .web-eyebrow { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .9rem; font-size: .88rem; }
  .web-tag { padding: .28rem .7rem; border-radius: 999px; border: 1px solid var(--line-strong); font-weight: 500; color: var(--fg); }
  .web-live { display: inline-flex; align-items: center; gap: .55rem; color: var(--fg-2); }
  .web-live .dot, .web-live .dot::after { background: var(--re); }
  .web-acc { color: var(--re); }

  /* the sample site, framed as a browser on its own address */
  .web-shot { position: relative; display: block; margin-top: 3rem; border-radius: 1.1rem; border: 1px solid var(--line); background: var(--surface); overflow: hidden;
    box-shadow: 0 1px 2px rgb(14 20 32 / .05), 0 60px 110px -60px color-mix(in oklab, var(--re) 60%, rgb(14 20 32 / .55)); transition: transform .5s cubic-bezier(.23, 1, .32, 1), box-shadow .5s ease; }
  @media (hover: hover) and (pointer: fine) { .web-shot:hover { transform: translateY(-3px); } }
  .web-shot:focus-visible { outline: 2px solid var(--re); outline-offset: 4px; }
  .web-chrome { display: flex; align-items: center; gap: .4rem; padding: .7rem .9rem; border-bottom: 1px solid var(--line); background: var(--sunken); }
  .web-chrome i { width: .62rem; height: .62rem; border-radius: 999px; background: var(--line-strong); }
  .web-url { display: inline-flex; align-items: center; gap: .4rem; margin-inline: auto; padding: .3rem 1rem; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); font-size: .82rem; color: var(--fg-2); }
  .web-url svg { width: .8rem; height: .8rem; fill: none; stroke: var(--re); stroke-width: 1.5; stroke-linejoin: round; }
  .web-shot img { display: block; width: 100%; height: auto; }
  .web-sync { position: absolute; inset-inline-end: 1.2rem; bottom: 1.2rem; display: flex; align-items: center; gap: .7rem; max-width: calc(100% - 2.4rem); padding: .75rem 1rem .75rem .8rem; border-radius: .9rem;
    background: color-mix(in oklab, var(--surface) 92%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid var(--line); box-shadow: 0 18px 40px -20px rgb(14 20 32 / .45); }
  .web-sync .ok { width: 1.6rem; height: 1.6rem; font-size: .8rem; background: var(--re-soft); color: var(--re); }
  .web-sync b { display: block; font-size: .88rem; font-weight: 600; }
  .web-sync small { display: block; font-size: .8rem; color: var(--fg-2); }
  @media (max-width: 560px) { .web-sync { position: static; margin: .8rem; max-width: none; box-shadow: none; } }

  /* how it works · the price */
  .web-grid { display: grid; gap: 2.5rem; margin-top: 3.5rem; align-items: start; }
  @media (min-width: 960px) { .web-grid { grid-template-columns: 1fr minmax(0, 25rem); gap: 4rem; } }
