---
import '../styles/global.css';

interface Props { lang: 'ar' | 'en' }
const { lang } = Astro.props;
const ar = lang === 'ar';
const copy = ar ? {
  preview: 'معاينة Hemlo Website', template: 'عقارات · عرض مميز', back: 'Hemlo', language: 'EN',
  brand: 'دار النخيل', brandSub: 'عقارات مختارة', homes: 'العقارات', about: 'عن دار النخيل', explore: 'اكتشف المنزل',
  eyebrow: 'دريم سيتي · أربيل', tag: 'مساحة تنتمي إليك', title: 'مساحة للحياة،', accent: 'ومجالٌ للنمو.',
  intro: 'منزل عائلي بحديقة خاصة ومساحات مشرقة صُمّمت لتعيش فيها على مهل.',
  details: 'تفاصيل المنزل', sample: 'عينة للمعاينة', imageLabel: ['الواجهة الخارجية', 'غرفة المعيشة', 'الحديقة'],
  saved: 'أُضيف إلى المحفوظات', save: 'احفظ هذا العقار', unsave: 'أزل من المحفوظات',
  share: 'مشاركة', shared: 'تم نسخ الرابط', shareError: 'تعذّرت مشاركة الرابط',
  openGallery: 'افتح معرض الصور', previous: 'الصورة السابقة', next: 'الصورة التالية', close: 'إغلاق المعرض',
  dayMode: 'التبديل إلى المعاينة الفاتحة', nightMode: 'التبديل إلى المعاينة الداكنة',
  beds: 'غرف نوم', baths: 'حمّامات', size: 'المساحة', garden: 'حديقة', gardenValue: 'خاصة',
  scroll: 'مرّر', storyHeading: 'منزل يأخذ اليوم على مراحل.',
  storyIntro: 'ثلاثة فصول: البوابة، والضوء، والأرض. كل فصل يهيّئ المزاج قبل أن يبدأ الذي بعده.',
  chapters: [
    { title: 'البوابة', body: 'التفاتة هادئة في دريم سيتي، وعتبة من الحجر — يبتعد المنزل عن الشارع ليحتفظ بلحظة سكون قبل أن تدخل.' },
    { title: 'الضوء', body: 'ساحات تفتح نحو الشمال تُبقي الغرف مشرقةً ومعتدلة: صباحٌ في المطبخ، وعصرٌ لا يخفت.' },
    { title: 'الأرض', body: 'حديقة خاصة تكفي لطاولة طويلة ومشواة وأمسية تمتد طويلاً. المدينة تبقى خارجها.' },
  ],
  gardenLabel: 'الحديقة', gardenQuote: 'مساحة تنمو — دون أن تغادر المنزل.', gardenMeta: 'أبوابٌ نحو الحديقة · خاصة',
  previewNote: 'بيانات تجريبية لعرض التصميم فقط · ليس إعلاناً عقارياً فعلياً.',
  connected: 'موقعك، متصل بعملك', connectedBody: 'هذه التفاصيل نموذجية. العقارات المنشورة في موقعك تأتي من مساحة Hemlo الخاصة بك.',
  photoCount: 'صور المنزل',
} : {
  preview: 'Hemlo Website preview', template: 'Real estate · Showcase', back: 'Hemlo', language: 'عربي',
  brand: 'NAKHIL', brandSub: 'REAL ESTATE, CONSIDERED', homes: 'Homes', about: 'Our approach', explore: 'Discover the home',
  eyebrow: 'DREAM CITY · ERBIL', tag: 'A HOME, IN ITS ELEMENT', title: 'Room for living,', accent: 'space to grow.',
  intro: 'A family home with a private garden and light-filled spaces made for slower mornings.',
  details: 'THE PROPERTY', sample: 'SAMPLE HOME', imageLabel: ['The exterior', 'The living room', 'The garden'],
  saved: 'Saved to your homes', save: 'Save this home', unsave: 'Remove saved home',
  share: 'Share home', shared: 'Link copied', shareError: 'Could not share the link',
  openGallery: 'Open photo gallery', previous: 'Previous photo', next: 'Next photo', close: 'Close gallery',
  dayMode: 'Switch to light preview', nightMode: 'Switch to dark preview',
  beds: 'Bedrooms', baths: 'Bathrooms', size: 'Living area', garden: 'Garden', gardenValue: 'Private',
  scroll: 'SCROLL', storyHeading: 'A home that takes the day in stages.',
  storyIntro: 'Three chapters: the approach, the light, the ground. Each sets the mood for the one that follows.',
  chapters: [
    { title: 'The approach', body: 'A quiet turning in Dream City, a stone threshold — the house steps back from the street to hold a moment of calm before you enter.' },
    { title: 'The light', body: 'Courtyards drawn to the north keep the rooms bright and even: mornings in the kitchen, an afternoon that never turns flat.' },
    { title: 'The ground', body: 'A private garden with room for a long table, a grill and an evening that runs late. The city stays out of it.' },
  ],
  gardenLabel: 'THE GARDEN', gardenQuote: 'Space to grow — without leaving home.', gardenMeta: 'Doors to the garden · PRIVATE',
  previewNote: 'Sample details for design preview only · Not an active listing.',
  connected: 'Your website, connected to your work', connectedBody: 'These details are a sample. Your published properties come from your Hemlo workspace.',
  photoCount: 'HOME / 01',
};
const switchTo = ar ? '/en/hero-sample/' : '/hero-sample/';
const gallery = [
  { src: '/images/realestate/villa-1-sm.webp', alt: ar ? 'الواجهة الخارجية للفيلا' : 'The villa exterior' },
  { src: '/images/realestate/sample/living.webp', alt: ar ? 'غرفة المعيشة' : 'The living room' },
  { src: '/images/realestate/sample/garden.webp', alt: ar ? 'الحديقة' : 'The garden' },
];
const facts = [
  { key: 'beds', count: 4, pad: 2 },
  { key: 'baths', count: 3, pad: 2 },
  { key: 'size', count: 320, pad: 0, suffix: ar ? 'م²' : 'm²' },
  { key: 'garden', text: copy.gardenValue },
];
---

<html lang={lang} dir={ar ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FAFAF7" />
    <title>{ar ? 'معاينة موقع عقاري' : 'Real estate website preview'} · Hemlo Website</title>
    <meta name="description" content={copy.intro} />
    <link rel="canonical" href={`https://hemlohq.com${ar ? '/hero-sample/' : '/en/hero-sample/'}`} />
    <link rel="preload" href={ar ? '/fonts/vazirmatn-arabic.woff2' : '/fonts/readex-pro-latin.woff2'} as="font" type="font/woff2" crossorigin />
  </head>
  <body class="sample-page" data-theme="day">
    <div class="preview-bar">
      <a class="preview-brand" href="/" aria-label={copy.back}><span class="preview-mark" aria-hidden="true">h</span><span>HEMLO <i>WEBSITE</i></span></a>
      <span class="preview-center"><span class="preview-dot"></span>{copy.preview}<i>/</i>{copy.template}</span>
      <div class="preview-actions">
        <button class="theme-toggle" type="button" data-theme-toggle aria-label={copy.nightMode} title={copy.nightMode}><span class="theme-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.6 6.6 0 0 0 9.8 9.8Z"/></svg></span><span class="theme-label">{ar ? 'ليلي' : 'Dark'}</span></button>
        <a class="preview-language" href={switchTo} lang={ar ? 'en' : 'ar'}>{copy.language}</a>
        <a class="preview-exit" href="/">{copy.back}<span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <header class="site-nav" id="site-nav" data-nav>
      <a class="agency" href="#top" aria-label={ar ? 'الصفحة الرئيسية' : 'Home'}>
        <span class="agency-symbol" aria-hidden="true">{ar ? 'ن' : 'N'}</span>
        <span class="agency-name"><b>{copy.brand}</b><small>{copy.brandSub}</small></span>
      </a>
      <nav aria-label={ar ? 'التنقل الرئيسي' : 'Main navigation'}>
        <a href="#story">{copy.homes}</a>
        <a href="#connected">{copy.about}</a>
      </nav>
      <a class="nav-cta" href="#story">{copy.explore}<span aria-hidden="true">{ar ? '←' : '↗'}</span></a>
    </header>

    <main>
      <section class="hero" id="top" aria-labelledby="hero-title" data-hero data-gallery>
        <div class="hero-views" data-parallax aria-hidden="false">
          {gallery.map((photo, i) => <img class:list={['hero-image', i === 0 && 'is-active']} data-gallery-image data-ken={i === 0 ? 'on' : undefined} src={photo.src} alt={photo.alt} width="1400" height="900" fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />)}
          <div class="hero-scrim" aria-hidden="true"></div>
          <div class="hero-grain" aria-hidden="true"></div>
        </div>

        <div class="hero-topline">
          <span class="location-chip"><span class="location-dot" aria-hidden="true"></span>{copy.eyebrow}</span>
          <div class="hero-tools">
            <span class="sample-chip">{copy.sample}</span>
            <button class="hero-icon" type="button" data-save aria-pressed="false" aria-label={copy.save} title={copy.save}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 8.8c0 5.2-8.8 10-8.8 10s-8.8-4.8-8.8-10a4.8 4.8 0 0 1 8.8-2.7 4.8 4.8 0 0 1 8.8 2.7Z" /></svg>
            </button>
            <button class="hero-icon" type="button" data-open-gallery aria-label={copy.openGallery} title={copy.openGallery}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m20.5 15-5-5-10 10" /></svg>
            </button>
          </div>
        </div>

        <div class="hero-content" data-hero-copy>
          <p class="hero-tag"><span></span>{copy.tag}</p>
          <h1 class="hero-title" id="hero-title">
            <span class="line"><span class="line-in">{copy.title}</span></span>
            <span class="line"><span class="line-in is-accent">{copy.accent}</span></span>
          </h1>
          <p class="hero-intro">{copy.intro}</p>
          <div class="hero-actions">
            <a class="button-primary" href="#story">{copy.explore}<span aria-hidden="true">{ar ? '←' : '↗'}</span></a>
            <button class="share-link" type="button" data-share><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 5.5 15 3m0 0-2.5-2.5M15 3H8.5a5 5 0 0 0-5 5v.5M7.5 14.5 5 17m0 0 2.5 2.5M5 17h6.5a5 5 0 0 0 5-5v-.5" /></svg>{copy.share}</button>
          </div>
        </div>

        <div class="hero-bottom">
          <a class="scroll-cue" href="#story" aria-label={ar ? 'انزل إلى التفاصيل' : 'Scroll to details'}><span class="cue-label">{copy.scroll}</span><span class="cue-line" aria-hidden="true"><i></i></span></a>
          <div class="photo-controls" role="group" aria-label={copy.openGallery}>
            <button type="button" data-prev aria-label={copy.previous}><span aria-hidden="true">{ar ? '→' : '←'}</span></button>
            <span class="photo-count"><b data-count>01</b><i>/</i>03</span>
            <button type="button" data-next aria-label={copy.next}><span aria-hidden="true">{ar ? '←' : '→'}</span></button>
          </div>
        </div>
      </section>

      <section class="facts" aria-label={copy.details} data-facts>
        <div class="facts-heading"><span class="facts-mark" aria-hidden="true">{ar ? 'ن' : 'N'}</span><span>{copy.photoCount}</span></div>
        <dl class="facts-list">
          {facts.map((fact) => (
            <div class="fact">
              <dt>{copy[fact.key as 'beds' | 'baths' | 'size' | 'garden']}</dt>
              <dd data-reveal>{fact.text ? fact.text : <><span data-count-value={fact.count} data-pad={fact.pad}>{String(fact.count).padStart(fact.pad || 1, '0')}</span>{fact.suffix ? <i>{fact.suffix}</i> : null}</>}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="story" id="story" aria-labelledby="story-title">
        <div class="story-head" data-reveal>
          <p class="section-label"><span></span>{copy.details}</p>
          <h2 id="story-title">{copy.storyHeading}</h2>
          <p>{copy.storyIntro}</p>
        </div>

        <div class="story-body">
          <div class="story-visual">
            <div class="story-frame" data-open-gallery role="button" tabindex="0" aria-label={copy.openGallery}>
              {gallery.map((photo, i) => <img class:list={['story-image', i === 0 && 'is-active']} data-story-image data-index={i} src={photo.src} alt={photo.alt} width="700" height="467" loading="lazy" decoding="async" />)}
              <span class="story-index" aria-hidden="true"><b data-story-index>01</b><i>/</i>03</span>
              <span class="story-zoom" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7"/></svg></span>
            </div>
          </div>
          <ol class="chapters">
            {copy.chapters.map((chapter, i) => (
              <li class="chapter" data-chapter={i} data-reveal>
                <span class="chapter-no" aria-hidden="true">0{i + 1}</span>
                <h3>{chapter.title}</h3>
                <p>{chapter.body}</p>
              </li>
            ))}
          </ol>
        </div>

        <p class="demo-note" data-reveal><span aria-hidden="true">✳</span>{copy.previewNote}</p>
      </section>

      <section class="garden" id="garden" aria-label={copy.gardenLabel}>
        <div class="garden-frame" data-parallax-wrap>
          <img class="garden-image" data-parallax src={gallery[2].src} alt={gallery[2].alt} width="700" height="463" loading="lazy" decoding="async" data-gallery-image />
          <div class="garden-scrim" aria-hidden="true"></div>
        </div>
        <figure class="garden-quote" data-reveal>
          <span class="garden-label">{copy.gardenLabel}</span>
          <blockquote>{copy.gardenQuote}</blockquote>
          <figcaption>{copy.gardenMeta}</figcaption>
        </figure>
      </section>

      <footer class="connected" id="connected">
        <a class="connected-brand" href="/" aria-label="Hemlo"><span class="connected-mark" aria-hidden="true">h</span><span>HEMLO <i>WEBSITE</i></span></a>
        <div class="connected-copy"><p>{copy.connected}</p><span>{copy.connectedBody}</span></div>
        <a class="connected-link" href="/systems/" aria-label={ar ? 'اكتشف أنظمة هيملو' : 'Explore Hemlo Systems'}><span aria-hidden="true">↗</span></a>
      </footer>
    </main>

    <dialog class="lightbox" data-lightbox aria-label={copy.openGallery}>
      <div class="lightbox-bar"><span>{copy.openGallery}<i>/</i><b data-lightbox-count>01 / 03</b></span><button class="lightbox-close" type="button" data-close aria-label={copy.close}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5 5 15"/></svg></button></div>
      <div class="lightbox-stage"><button class="lightbox-arrow" type="button" data-lightbox-prev aria-label={copy.previous}>←</button><img data-lightbox-image src={gallery[0].src} alt={gallery[0].alt} /><button class="lightbox-arrow" type="button" data-lightbox-next aria-label={copy.next}>→</button></div>
      <p class="lightbox-caption" data-lightbox-caption>{copy.imageLabel[0]}</p>
    </dialog>
    <div class="toast" data-toast role="status" aria-live="polite"></div>

    <script define:vars={{ gallery, labels: copy.imageLabel, words: { saved: copy.saved, save: copy.save, unsave: copy.unsave, shared: copy.shared, shareError: copy.shareError, dayMode: copy.dayMode, nightMode: copy.nightMode, light: ar ? 'نهاري' : 'Light', dark: ar ? 'ليلي' : 'Dark' }, ar }}>
      const root = document.querySelector('.sample-page');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const images = [...document.querySelectorAll('.hero-views [data-gallery-image]')];
      const storyImages = [...document.querySelectorAll('[data-story-image]')];
      const chapters = [...document.querySelectorAll('[data-chapter]')];
      const counter = document.querySelector('[data-count]');
      const storyIndex = document.querySelector('[data-story-index]');
      const dialog = document.querySelector('[data-lightbox]');
      const dialogImage = document.querySelector('[data-lightbox-image]');
      const dialogCount = document.querySelector('[data-lightbox-count]');
      const dialogCaption = document.querySelector('[data-lightbox-caption]');
      const storyFrame = document.querySelector('.story-frame');
      const save = document.querySelector('[data-save]');
      const theme = document.querySelector('[data-theme-toggle]');
      const toast = document.querySelector('[data-toast]');
      let current = 0, toastTimer = 0;
      const key = 'hemlo-hero-sample-saved';
      try {
        if (localStorage.getItem('hemlo-hero-sample-saved') === 'true') {
          save?.setAttribute('aria-pressed', 'true'); save?.setAttribute('aria-label', words.unsave); if (save) save.title = words.unsave;
        }
        if (localStorage.getItem('hemlo-hero-sample-theme') === 'night') setTheme(true, false);
      } catch { /* Preview works for this visit even when storage is disabled. */ }
      const setSlide = (index) => {
        current = (index + gallery.length) % gallery.length;
        images.forEach((image, i) => image.classList.toggle('is-active', i === current));
        if (counter) counter.textContent = String(current + 1).padStart(2, '0');
        if (dialog?.open) syncDialog();
      };
      const syncDialog = () => {
        const photo = gallery[current];
        if (dialogImage) { dialogImage.src = photo.src; dialogImage.alt = photo.alt; }
        if (dialogCount) dialogCount.textContent = `${String(current + 1).padStart(2, '0')} / ${String(gallery.length).padStart(2, '0')}`;
        if (dialogCaption) dialogCaption.textContent = labels[current];
      };
      const showToast = (message) => {
        if (!toast) return;
        toast.textContent = message; toast.classList.add('is-visible');
        window.clearTimeout(toastTimer); toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 2200);
      };
      const setTheme = (night, persist = true) => {
        root?.setAttribute('data-theme', night ? 'night' : 'day');
        theme?.setAttribute('aria-label', night ? words.dayMode : words.nightMode);
        if (theme) theme.title = night ? words.dayMode : words.nightMode;
        const text = theme?.querySelector('.theme-label');
        if (text) text.textContent = night ? words.light : words.dark;
        if (persist) { try { localStorage.setItem('hemlo-hero-sample-theme', night ? 'night' : 'day'); } catch { /* keep this visit's theme */ } }
      };
      document.querySelector('[data-prev]')?.addEventListener('click', () => setSlide(current - 1));
      document.querySelector('[data-next]')?.addEventListener('click', () => setSlide(current + 1));
      document.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => setSlide(current - 1));
      document.querySelector('[data-lightbox-next]')?.addEventListener('click', () => setSlide(current + 1));
      document.querySelector('[data-open-gallery]')?.addEventListener('click', () => { syncDialog(); dialog?.showModal(); });
      storyFrame?.addEventListener('click', () => { setSlide(storyImages.findIndex((image) => image.classList.contains('is-active'))); syncDialog(); dialog?.showModal(); });
      storyFrame?.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); storyFrame.click(); } });
      document.querySelector('[data-close]')?.addEventListener('click', () => dialog?.close());
      dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
      dialog?.addEventListener('keydown', (event) => { if (event.key === 'ArrowRight') setSlide(current + (ar ? -1 : 1)); if (event.key === 'ArrowLeft') setSlide(current + (ar ? 1 : -1)); });
      save?.addEventListener('click', () => {
        const next = save.getAttribute('aria-pressed') !== 'true';
        save.setAttribute('aria-pressed', String(next)); save.setAttribute('aria-label', next ? words.unsave : words.save); save.title = next ? words.unsave : words.save;
        try { localStorage.setItem(key, String(next)); } catch { /* keep the current state in memory */ }
        showToast(next ? words.saved : words.save);
      });
      document.querySelector('[data-share]')?.addEventListener('click', async () => {
        try {
          if (navigator.share) await navigator.share({ title: document.title, url: location.href });
          else { await navigator.clipboard.writeText(location.href); showToast(words.shared); }
        } catch (error) { if (!(error && typeof error === 'object' && 'name' in error && error.name === 'AbortError')) showToast(words.shareError); }
      });
      theme?.addEventListener('click', () => setTheme(root?.getAttribute('data-theme') !== 'night'));

      let storyActive = -1;
      const setStory = (index) => {
        if (index === storyActive) return;
        storyActive = index;
        storyImages.forEach((image, i) => image.classList.toggle('is-active', i === index));
        if (storyIndex) storyIndex.textContent = String(index + 1).padStart(2, '0');
      };
      if ('IntersectionObserver' in window && !reduce) {
        const storyObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => { if (entry.isIntersecting) setStory(Number(entry.target.dataset.chapter)); });
        }, { rootMargin: '-45% 0px -45% 0px' });
        chapters.forEach((chapter) => storyObserver.observe(chapter));
      } else { setStory(0); }

      if ('IntersectionObserver' in window) {
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-in'); observer.unobserve(entry.target); } });
        }, { rootMargin: '0px 0px -12% 0px', threshold: 0.15 });
        document.querySelectorAll('[data-reveal]').forEach((el) => revealObserver.observe(el));

        const countEl = document.querySelector('[data-count-value]');
        const facts = document.querySelector('[data-facts]');
        if (countEl && facts) {
          const nums = [...facts.querySelectorAll('[data-count-value]')];
          const factsObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              observer.unobserve(entry.target);
              if (reduce) return;
              nums.forEach((el) => {
                const target = Number(el.dataset.countValue); const pad = Number(el.dataset.pad) || 1;
                const start = performance.now(); const span = 950;
                const step = (now) => {
                  const t = Math.min(1, (now - start) / span);
                  const eased = 1 - Math.pow(1 - t, 3);
                  el.textContent = String(Math.round(target * eased)).padStart(pad, '0');
                  if (t < 1) requestAnimationFrame(step); else el.textContent = String(target).padStart(pad, '0');
                };
                requestAnimationFrame(step);
              });
            });
          }, { threshold: 0.4 });
          factsObserver.observe(facts);
        }
      }

      const nav = document.querySelector('[data-nav]');
      const hero = document.querySelector('[data-hero]');
      let ticking = false;
      const onScroll = () => {
        if (ticking) return; ticking = true;
        requestAnimationFrame(() => {
          const y = window.scrollY;
          nav?.classList.toggle('is-stuck', y > 8);
          if (hero && !reduce) hero.classList.toggle('is-past', y > hero.offsetHeight * 0.6);
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      let entered = false;
      const enter = () => { if (entered) return; entered = true; document.body.classList.add('is-entered'); };
      requestAnimationFrame(() => requestAnimationFrame(enter));
      window.addEventListener('load', enter, { once: true });
      setTimeout(enter, 900);

      const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (fine && !reduce) {
        const parallax = [...document.querySelectorAll('[data-parallax]')];
