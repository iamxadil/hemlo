---
// /hero-sample: what a Hemlo Website looks like, shown as the real thing. It mirrors the template every business site
// renders (platform/apps/api/src/routes/website/theme.ts): warm paper, one serif for headings, hairlines, a photograph
// that settles and words that rise. Sample words and photos only; a real site reads its properties from Hemlo.
// Photos: Unsplash (WILLIAN REIS, VJ Von Art, Daniel Brubaker, Hardik Panchal), credited in platform/apps/system/public/demo/re/credits.json.
interface Props { lang: 'ar' | 'en' }
const { lang } = Astro.props;
const ar = lang === 'ar';
const c = ar ? {
  title: 'معاينة موقع عقاري · Hemlo Website', desc: 'هكذا يبدو موقع مكتب عقارات على Hemlo Website: عقاراته من نظامه مباشرة، بعنوانه الخاص.',
  bar: 'معاينة', barSub: 'Hemlo Website · قالب العقارات', back: 'العودة إلى Hemlo', switchLabel: 'English',
  brand: 'دار النخيل', nav: ['الرئيسية', 'عقاراتنا', 'من نحن', 'تواصل معنا'], other: 'English',
  cities: 'أربيل · بغداد', h1: 'دار النخيل للعقارات', lead: 'بيوت مختارة في أربيل وبغداد، بأسعار واضحة ومواعيد معاينة تناسبك.',
  browse: 'تصفّح العقارات', wa: 'واتساب', count: '24 عقاراً متاحاً الآن', phone: '+964 770 123 4567',
  listingsLabel: 'عقاراتنا', listingsLine: 'بيوت اخترناها بعناية.', all: 'كل العقارات',
  cards: [
    { img: 'villa-3', badge: 'للبيع', where: 'دريم سيتي · أربيل', type: 'فيلا', title: 'فيلا بحديقة خاصة في دريم سيتي', facts: '4 غرف · 3 حمّام · 320 م²', price: '$265,000' },
    { img: 'apartment-1', badge: 'للإيجار', where: 'عنكاوة · أربيل', type: 'شقة', title: 'شقة مشرقة بإطلالة مفتوحة', facts: '2 غرف · 2 حمّام · 140 م²', price: '$900 / شهرياً' },
    { img: 'villa-4', badge: 'قيد التفاوض', held: true, where: 'المنصور · بغداد', type: 'فيلا', title: 'بيت بطابقين وسطح مزروع', facts: '5 غرف · 4 حمّام · 410 م²', price: '$410,000' },
  ],
  aboutLabel: 'من نحن', aboutLine: 'مكتب يعرف مدينته.', about: 'مكتب عائلي منذ 2009. لا نعرض إلا ما زرناه بأنفسنا، ونقول السعر كما هو، ونرتّب المعاينة في الوقت الذي يناسبك.',
  contactLabel: 'تواصل معنا', contactLine: 'لنتحدث عن بيتك القادم.', call: 'اتصال', inquire: 'أرسل استفساراً',
  dl: [['الهاتف', '+964 770 123 4567'], ['البريد', 'hello@nakheel.iq'], ['العنوان', 'شارع 100، أربيل']],
  powered: 'موقع من هيملو', note: 'نموذج للمعاينة: الأسماء والأسعار تجريبية. في موقعك، تأتي العقارات من نظام Hemlo العقاري مباشرة.',
  notePlan: 'أضِف Hemlo Website إلى نظامك',
} : {
  title: 'Real estate website preview · Hemlo Website', desc: 'What a real estate office’s Hemlo Website looks like: its properties straight from its system, on its own address.',
  bar: 'Preview', barSub: 'Hemlo Website · Real estate template', back: 'Back to Hemlo', switchLabel: 'عربي',
  brand: 'Nakheel', nav: ['Home', 'Properties', 'About', 'Contact'], other: 'العربية',
  cities: 'Erbil · Baghdad', h1: 'Nakheel Real Estate', lead: 'Considered homes in Erbil and Baghdad, honestly priced, shown when it suits you.',
  browse: 'Browse properties', wa: 'WhatsApp', count: '24 homes available now', phone: '+964 770 123 4567',
  listingsLabel: 'Properties', listingsLine: 'Homes we chose with care.', all: 'All properties',
  cards: [
    { img: 'villa-3', badge: 'For sale', where: 'Dream City · Erbil', type: 'Villa', title: 'A villa with a private garden', facts: '4 bed · 3 bath · 320 m²', price: '$265,000' },
    { img: 'apartment-1', badge: 'For rent', where: 'Ankawa · Erbil', type: 'Apartment', title: 'A bright flat with an open view', facts: '2 bed · 2 bath · 140 m²', price: '$900 / month' },
    { img: 'villa-4', badge: 'Negotiating', held: true, where: 'Mansour · Baghdad', type: 'Villa', title: 'Two floors and a planted roof', facts: '5 bed · 4 bath · 410 m²', price: '$410,000' },
  ],
  aboutLabel: 'About', aboutLine: 'An office that knows its city.', about: 'A family office since 2009. We only show homes we have walked through ourselves, we tell you the price as it is, and we arrange viewings when it suits you.',
  contactLabel: 'Contact', contactLine: 'Let’s talk about your next home.', call: 'Call', inquire: 'Send an inquiry',
  dl: [['Phone', '+964 770 123 4567'], ['Email', 'hello@nakheel.iq'], ['Visit', '100 Street, Erbil']],
  powered: 'A Hemlo site', note: 'A sample for preview: names and prices are made up. On your site, properties come straight from your Hemlo Real Estate system.',
  notePlan: 'Add Hemlo Website to your system',
};
const switchTo = ar ? '/en/hero-sample/' : '/hero-sample/';
const systemsHref = ar ? '/systems/#addons' : '/en/systems/#addons';
const arrow = '<span class="arrow" aria-hidden="true">→</span>';
---
<html lang={lang} dir={ar ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#F6F4EF" />
    <meta name="robots" content="noindex" />
    <title>{c.title}</title>
    <meta name="description" content={c.desc} />
    <link rel="canonical" href={`https://hemlohq.com${ar ? '/hero-sample/' : '/en/hero-sample/'}`} />
    <link rel="preload" href="/images/realestate/sample/hero.webp" as="image" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class="on-photo">
    <div class="pbar">
      <span><i class="pdot" aria-hidden="true"></i><b>{c.bar}</b><span class="psub">{c.barSub}</span></span>
      <span class="pacts"><a href={switchTo} lang={ar ? 'en' : 'ar'}>{c.switchLabel}</a><a href={systemsHref}>{c.back}<Fragment set:html={arrow} /></a></span>
    </div>

    <header class="wtop">
      <div class="wwrap">
        <a class="wbrand" href="#top"><span class="mono">{ar ? 'ن' : 'N'}</span><span>{c.brand}</span></a>
        <nav class="wnav">{c.nav.map((x, i) => <a href={['#top', '#homes', '#about', '#contact'][i]} aria-current={i === 0 ? 'page' : undefined}>{x}</a>)}</nav>
        <a class="wlang" href={switchTo} lang={ar ? 'en' : 'ar'}>{c.other}</a>
      </div>
    </header>

    <main id="top">
      <section class="hero photo">
        <img class="bgimg" src="/images/realestate/sample/hero.webp" alt="" fetchpriority="high" decoding="async" />
        <div class="wwrap">
          <p class="eyebrow rise" style="--i:0">{c.cities}</p>
          <h1 class="display rise" style="--i:1;margin-top:18px">{c.h1}</h1>
          <p class="lead rise" style="--i:2">{c.lead}</p>
          <div class="acts rise" style="--i:3">
            <a class="btn light" href="#homes">{c.browse}<Fragment set:html={arrow} /></a>
            <a class="btn ghost-light" href="#contact">{c.wa}</a>
          </div>
          <div class="foot rise" style="--i:4"><span>{c.count}</span><span class="num" dir="ltr">{c.phone}</span></div>
        </div>
      </section>

      <div class="wwrap"><aside class="pnote" role="note"><p>{c.note}</p><a class="link" href={systemsHref}>{c.notePlan}<Fragment set:html={arrow} /></a></aside></div>

      <section class="wsec" id="homes">
        <div class="wwrap">
          <div class="sh rv"><div><p class="eyebrow"><span class="idx num">01</span>{c.listingsLabel}</p><h2 class="display">{c.listingsLine}</h2></div><a class="link" href="#homes">{c.all}<Fragment set:html={arrow} /></a></div>
          <div class="lgrid">
            {c.cards.map((x, i) => (
              <a class="lc rv" style={`--i:${i}`} href="#homes">
                <figure><img src={`/images/realestate/sample/${x.img}.webp`} alt="" loading="lazy" decoding="async" /><span class:list={['badge', x.held && 'warn']}><i class="dot"></i>{x.badge}</span></figure>
                <div><div class="meta"><span>{x.where}</span><span>{x.type}</span></div><h3><span>{x.title}</span></h3></div>
                <div class="row"><span class="facts">{x.facts}</span><span class="pr num" dir="ltr">{x.price}</span></div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="wsec" id="about">
        <div class="wwrap about">
          <div class="rv"><p class="eyebrow"><span class="idx num">02</span>{c.aboutLabel}</p><h2 class="display" style="font-size:clamp(28px,3.6vw,44px);margin-top:14px">{c.aboutLine}</h2></div>
          <div class="body rv" style="--i:1"><p>{c.about}</p></div>
        </div>
      </section>

      <section class="wsec band" id="contact">
        <div class="wwrap">
          <p class="eyebrow rv"><span class="idx num">03</span>{c.contactLabel}</p>
          <h2 class="display rv" style="margin-top:16px">{c.contactLine}</h2>
          <div class="acts rv"><a class="btn wa" href="#contact">{c.wa}</a><a class="btn" href="#contact">{c.call}</a><a class="btn light" href="#contact">{c.inquire}</a></div>
          <dl class="rv">{c.dl.map(([k, v], i) => <div><dt>{k}</dt><dd dir={i < 2 ? 'ltr' : undefined} style="text-align:start">{v}</dd></div>)}</dl>
        </div>
      </section>
    </main>

    <footer class="wfoot">
      <div class="wwrap">
        <div class="top"><div><p class="name" style="margin:0">{c.brand}</p><p style="margin:10px 0 0;max-width:46ch">{c.lead}</p></div></div>
        <div class="bot"><span>© 2026 {c.brand}</span><a href={ar ? '/systems/' : '/en/systems/'}>{c.powered}</a></div>
      </div>
    </footer>

    <script is:inline>
      (function(){var h=document.querySelector('header.wtop');var f=function(){h.classList.toggle('is-stuck',scrollY>24)};f();addEventListener('scroll',f,{passive:true});
      var els=document.querySelectorAll('.rv');if('IntersectionObserver' in window){var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{rootMargin:'0px 0px -8% 0px'});els.forEach(function(e){io.observe(e)})}else els.forEach(function(e){e.classList.add('in')})})();
    </script>
  </body>
</html>

<style is:global>
  /* the template's tokens and pieces (keep in step with platform/apps/api/src/routes/website/theme.ts) */
  :root{--bg:#F6F4EF;--surface:#EEEBE4;--card:#FBFAF7;--ink:#1B1A17;--ink2:#57534B;--muted:#8A857B;--line:#E2DDD2;--accent:#2F4A3A;--ring:color-mix(in oklab,var(--accent) 55%,transparent);--wa:#1E8E50;--r:10px;
    --text:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,"Noto Sans Arabic","Noto Sans",sans-serif;
    --display:"Iowan Old Style","Palatino Linotype",Palatino,"Book Antiqua","Noto Naskh Arabic","Amiri","Traditional Arabic",Georgia,serif;--ease:cubic-bezier(.22,.7,.18,1);color-scheme:light}
  *{box-sizing:border-box}html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--text);font-size:16px;line-height:1.65;-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}img{display:block;max-width:100%}
  :focus-visible{outline:2px solid var(--ring);outline-offset:3px;border-radius:4px}
  .wwrap{width:100%;max-width:1200px;margin:0 auto;padding:0 20px}@media (min-width:768px){.wwrap{padding:0 40px}}
  .num{font-variant-numeric:tabular-nums}
  .eyebrow{display:flex;align-items:center;gap:10px;margin:0;font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}
  html[lang=ar] .eyebrow{font-size:13px;letter-spacing:0;text-transform:none}
  .eyebrow .idx{color:var(--ink2)}.eyebrow .idx::after{content:"";display:inline-block;width:28px;height:1px;margin-inline-start:10px;vertical-align:middle;background:currentColor;opacity:.5}
  .display{font-family:var(--display);font-weight:400;letter-spacing:-.015em;line-height:1.08;margin:0}html[lang=ar] .display{letter-spacing:0;line-height:1.35}
  /* the preview strip: Hemlo's, not the agency's */
  .pbar{position:relative;z-index:40;display:flex;justify-content:space-between;align-items:center;gap:12px;height:40px;padding:0 20px;background:#1B1A17;color:rgba(246,244,239,.82);font-size:13px}
  .pbar b{font-weight:500;color:#F6F4EF}.psub{margin-inline-start:10px;opacity:.6}.pdot{display:inline-block;width:6px;height:6px;margin-inline-end:10px;border-radius:50%;background:#7FB08F;vertical-align:middle}
  .pacts{display:flex;gap:18px}.pacts a{display:inline-flex;align-items:center;gap:6px;opacity:.85}.pacts a:hover{opacity:1}
  @media (max-width:560px){.psub{display:none}}
  header.wtop{position:fixed;top:40px;inset-inline:0;z-index:30;color:#fff;border-bottom:1px solid transparent;transition:background-color .45s var(--ease),border-color .45s var(--ease),color .45s var(--ease),top .45s var(--ease)}
  header.wtop.is-stuck{top:0;background:color-mix(in oklab,var(--bg) 86%,transparent);border-color:var(--line);color:var(--ink);backdrop-filter:blur(14px) saturate(1.3);-webkit-backdrop-filter:blur(14px) saturate(1.3)}
  header.wtop .wwrap{display:flex;align-items:center;gap:20px;height:68px}
  .wbrand{display:flex;align-items:center;gap:12px;min-width:0}
  .wbrand .mono{display:grid;place-items:center;width:34px;height:34px;border-radius:999px;border:1px solid currentColor;font-family:var(--display);font-size:16px;opacity:.9}
  .wbrand span:last-child{font-family:var(--display);font-size:20px;white-space:nowrap}
  .wnav{margin-inline-start:auto;display:flex;gap:2px}
  .wnav a{position:relative;padding:8px 12px;font-size:14.5px;white-space:nowrap;opacity:.78;transition:opacity .2s}
  .wnav a::after{content:"";position:absolute;inset-inline:12px;bottom:4px;height:1px;background:currentColor;transform:scaleX(0);transform-origin:var(--from,left);transition:transform .45s var(--ease)}
  html[dir=rtl] .wnav a{--from:right}.wnav a:hover,.wnav a[aria-current]{opacity:1}.wnav a:hover::after,.wnav a[aria-current]::after{transform:scaleX(1)}
  .wlang{font-size:13px;padding:6px 12px;border-radius:999px;border:1px solid color-mix(in oklab,currentColor 30%,transparent);white-space:nowrap}
  @media (max-width:640px){.wnav{display:none}.wlang{margin-inline-start:auto}}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 20px;border-radius:var(--r);border:1px solid var(--line);background:transparent;font-size:15px;font-weight:500;white-space:nowrap;transition:background-color .2s,transform .2s var(--ease)}
  .btn:hover{background:var(--surface)}.btn:active{transform:scale(.98)}
  .btn.wa{background:var(--wa);border-color:var(--wa);color:#fff}.btn.light{background:#F6F4EF;border-color:#F6F4EF;color:#1B1A17}.btn.light:hover{background:#fff}
  .btn.ghost-light{border-color:rgba(255,255,255,.4);color:#fff}.btn.ghost-light:hover{background:rgba(255,255,255,.12)}
  .arrow{display:inline-block;transition:transform .45s var(--ease)}a:hover .arrow{transform:translateX(4px)}html[dir=rtl] .arrow{transform:scaleX(-1)}html[dir=rtl] a:hover .arrow{transform:scaleX(-1) translateX(4px)}
  .link{display:inline-flex;align-items:center;gap:8px;font-size:15px;border-bottom:1px solid var(--line);padding-bottom:3px;transition:border-color .3s}.link:hover{border-color:var(--ink)}
  .badge{display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 10px;border-radius:999px;font-size:12px;font-weight:500;background:color-mix(in oklab,var(--card) 92%,transparent);border:1px solid var(--line)}
  .badge .dot{width:6px;height:6px;border-radius:50%;background:var(--accent)}.badge.warn .dot{background:#B7791F}
  .hero{position:relative}
  .hero .lead{max-width:560px;margin:22px 0 0;font-size:clamp(17px,2vw,20px);line-height:1.6}
  .hero h1{font-size:clamp(42px,7.2vw,96px);max-width:14ch}
  .hero .acts{display:flex;flex-wrap:wrap;gap:10px;margin-top:34px}
  .hero.photo{display:flex;align-items:flex-end;min-height:min(94svh,880px);padding:160px 0 48px;color:#fff;overflow:hidden;isolation:isolate}
  .hero.photo .bgimg{position:absolute;inset:0;z-index:-2;width:100%;height:100%;object-fit:cover;animation:settle 2.8s var(--ease) both}
  .hero.photo::before{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(14,13,11,.45) 0%,rgba(14,13,11,0) 24%,rgba(14,13,11,.18) 50%,rgba(14,13,11,.78) 100%),linear-gradient(var(--side,90deg),rgba(14,13,11,.5) 0%,rgba(14,13,11,0) 62%)}
  html[dir=rtl] .hero.photo{--side:270deg}.hero.photo h1,.hero.photo .lead{text-shadow:0 1px 28px rgba(0,0,0,.28)}
  .hero.photo .lead{color:rgba(255,255,255,.86)}.hero.photo .eyebrow{color:rgba(255,255,255,.78)}
  .hero .foot{display:flex;flex-wrap:wrap;justify-content:space-between;gap:24px;margin-top:56px;padding-top:20px;border-top:1px solid rgba(255,255,255,.22);font-size:14px;opacity:.85}
  .hero .rise{animation:rise 1.1s var(--ease) both;animation-delay:calc(.25s + var(--i,0) * .12s)}
  @keyframes settle{from{transform:scale(1.08);filter:saturate(.85)}to{transform:none;filter:none}}
  @keyframes rise{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
  section.wsec{padding:72px 0 88px;border-top:1px solid var(--line)}@media (max-width:640px){section.wsec{padding:64px 0}}
  .sh{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:16px 32px;margin-bottom:44px}
  .sh h2{font-size:clamp(30px,4.4vw,52px);margin-top:14px}
  .about{display:grid;gap:28px 64px}@media (min-width:900px){.about{grid-template-columns:5fr 7fr}}
  .about .body{font-family:var(--display);font-size:clamp(21px,2.4vw,28px);line-height:1.5}.about .body p{margin:0}html[lang=ar] .about .body{line-height:1.8}
  .lgrid{display:grid;gap:44px 28px;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr))}
  .lc{display:flex;flex-direction:column;gap:16px}
  .lc figure{position:relative;margin:0;aspect-ratio:4/5;border-radius:var(--r);overflow:hidden;background:var(--surface)}
  .lc figure img{width:100%;height:100%;object-fit:cover;transition:transform 1.4s var(--ease)}.lc:hover figure img{transform:scale(1.045)}
  .lc figure .badge{position:absolute;top:14px;inset-inline-start:14px}
  .lc .meta{display:flex;justify-content:space-between;gap:12px;font-size:13px;color:var(--muted)}
  .lc h3{font-family:var(--display);font-weight:400;font-size:23px;line-height:1.25;margin:4px 0 0}html[lang=ar] .lc h3{line-height:1.5}
  .lc h3 span{background:linear-gradient(currentColor,currentColor) no-repeat var(--from,0) 100%/0 1px;transition:background-size .5s var(--ease)}html[dir=rtl] .lc h3 span{--from:100%}.lc:hover h3 span{background-size:100% 1px}
  .lc .row{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding-top:12px;border-top:1px solid var(--line)}
  .lc .facts{font-size:14px;color:var(--ink2)}.lc .pr{font-size:17px;font-weight:600}
  .band{background:#1B1A17;color:#F1EDE5;border-top:0!important}
  .band .eyebrow{color:rgba(241,237,229,.6)}.band .eyebrow .idx{color:rgba(241,237,229,.85)}
  .band h2{font-size:clamp(34px,5.6vw,72px);max-width:16ch}
  .band .acts{display:flex;flex-wrap:wrap;gap:10px;margin-top:36px}
  .band .btn:not(.wa):not(.light){border-color:rgba(241,237,229,.28);color:#F1EDE5}.band .btn:not(.wa):not(.light):hover{background:rgba(241,237,229,.08)}
  .band dl{display:grid;gap:24px;margin:64px 0 0;padding-top:28px;border-top:1px solid rgba(241,237,229,.16);grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}
  .band dt{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:rgba(241,237,229,.55)}html[lang=ar] .band dt{letter-spacing:0;font-size:13px}
  .band dd{margin:6px 0 0;font-size:17px}
  footer.wfoot{padding:64px 0 40px;border-top:1px solid var(--line);color:var(--ink2);font-size:14px}
  footer.wfoot .top{padding-bottom:40px}footer.wfoot .name{font-family:var(--display);font-size:clamp(28px,4vw,44px);color:var(--ink);line-height:1.2}
  footer.wfoot .bot{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px 24px;padding-top:20px;border-top:1px solid var(--line);color:var(--muted);font-size:13px}
  /* the sample note, docked at the bottom */
  .pnote{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px 20px;margin:28px 0;padding:14px 18px;border:1px dashed var(--line);border-radius:12px;font-size:13.5px;color:var(--ink2)}
  .pnote p{margin:0;flex:1 1 320px}.pnote .link{font-size:13.5px;color:var(--ink)}
  html.js .rv{opacity:0;transform:translateY(18px);transition:opacity 1s var(--ease),transform 1s var(--ease);transition-delay:calc(var(--i,0) * 80ms)}
  html.js .rv.in{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}html.js .rv{opacity:1;transform:none}}
</style>
