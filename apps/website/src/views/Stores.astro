---
// Hemlo Systems for stores and markets: the first edition, free for the first shops, by application. Its own page (not
// featured on /systems yet): paper and terracotta, the look of a receipt, built around real screens of the demo shop.
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Pricing from '../components/Pricing.astro';
import { BRANCH } from '../brand/brand';
import { t, href, EMAIL, SYSTEM_URL, type Lang } from '../i18n/strings';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t(lang).systems;
const b = BRANCH.systems;
const apply = `${SYSTEM_URL}?start=store&lang=${lang}`; // a 7-day free trial, started by the owner
const demo = `${SYSTEM_URL}?demo=1&lang=${lang}`; // a private demo shop, opened in one tap
const film = { src: `/video/demo-shop-${lang}-v1.mp4`, poster: `/video/demo-shop-${lang}-v1.jpg` }; // a minute of the real demo shop
const mail = `mailto:${EMAIL}?subject=${encodeURIComponent('Hemlo Stores')}`;
const [t1, t2] = s.title.split(/(?<=\.)\s+/);
const num = (i: number) => (lang === 'ar' ? ['١', '٢', '٣', '٤', '٥'][i] : String(i + 1));
// real screenshots of the shop, per language (platform/scripts/marketing-store-shots.ts)
const img = (name: string, w: number) => `/images/stores/${name}-${lang}-${w}.webp`;
const set = (name: string) => `${img(name, 1000)} 1000w, ${img(name, 1800)} 1800w`;

const S = {
  ar: {
    title: 'هيملو للمتاجر والماركتات',
    show: [
      ['sell', 'الكاشير', 'امسح، اقبض، التالي.', 'باركود القطعة والكارتون وملصق الميزان، كلها تُقرأ من المسح. نقداً أو بطاقة أو FIB أو على الحساب. يعمل حتى لو انقطع الإنترنت، ويرسل البيع عند عودته.'],
      ['home', 'لصاحب المحل', 'يومك بالأرقام، لا بالتخمين.', 'المبيعات والربح والديون وما في الصندوق، والأكثر مبيعاً، وما الذي قارب على النفاد. من أي مكان، على موبايلك.'],
      ['debts', 'الدفتر', 'دفتر الديون، بلا دفتر.', 'من عليه كم، ومنذ متى. تذكير واتساب بنقرة، والدفعة تُسجّل وتنقص من الحساب وحدها.'],
    ],
  },
  en: {
    title: 'Hemlo for stores and markets',
    show: [
      ['sell', 'The till', 'Scan, pay, next.', 'Piece and carton barcodes and scale labels are all read from a scan. Cash, card, FIB or on account. It keeps selling when the internet drops, and sends the sales when it’s back.'],
      ['home', 'For the owner', 'Your day in numbers, not guesses.', 'Sales, profit, debts and what’s in the drawer, the best sellers, and what’s about to run out. From anywhere, on your phone.'],
      ['debts', 'The debt book', 'The debt book, without the book.', 'Who owes what, and since when. A WhatsApp reminder in one tap, and a payment comes off the account by itself.'],
    ],
  },
}[lang];
---
<Base lang={lang} page="stores" title={S.title} description={s.sub}>
  <div class="st" style={`--c:${b.color};--cd:${b.dark};--t:${b.tint};--td:${b.tintDark}`}>

    <!-- the hero: warm paper, the till on a laptop, a receipt coming off it -->
    <section class="hero">
      <div class="wrap relative pt-14 pb-12 sm:pt-20">
        <div class="max-w-3xl">
          <p class="live rise"><span class="dot" aria-hidden="true"></span>{s.storesLabel}</p>
          <h1 class="mt-7 text-[clamp(2.5rem,6.2vw,5.2rem)] font-semibold leading-[1.04] tracking-tight rise rise-2"><span class="block">{t1}</span><span class="block accent">{t2}</span></h1>
          <p class="mt-7 max-w-2xl text-lead text-fg-2 rise rise-3">{s.sub}</p>
          <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-4 rise rise-4">
            <a class="btn btn-sys" href={apply}>{s.apply}<span class="arr" aria-hidden="true">→</span></a>
            <a class="btn btn-secondary" href={demo}>{s.demo}</a>
            <a class="link-quiet inline-flex items-center gap-2" href="#film"><svg width="12" height="14" viewBox="0 0 12 14" aria-hidden="true"><path d="M1 1.5v11l10-5.5z" fill="currentColor" /></svg>{s.film.title}</a>
          </div>
          <p class="mt-5 max-w-md text-[.92rem] text-fg-2 rise rise-4">{s.demoNote}</p>
        </div>

        <div class="devices rise rise-3" aria-hidden="true">
          <div class="laptop"><img src={img('sell', 1800)} srcset={set('sell')} sizes="(min-width: 1152px) 900px, 88vw" width="1800" height="1125" alt="" fetchpriority="high" decoding="async" /></div>
          <div class="phone"><img src={img('phone-sell', 840)} srcset={`${img('phone-sell', 420)} 420w, ${img('phone-sell', 840)} 840w`} sizes="200px" width="840" height="1818" alt="" decoding="async" /></div>
          <div class="paper">
            <div class="receipt">
              <div class="flex items-center justify-center gap-2"><span style={`color:${b.color}`}><Mark class="h-5 w-auto" /></span><b class="text-[1.05rem]">{s.receipt.shop}</b></div>
              <p class="mt-1 text-center text-[.78rem] text-[#6b6358]">{s.receipt.no} · 29/09 · 20:42</p>
              <hr />
              <table><tbody>
                {s.receipt.lines.map(([name, q, amount]) => <tr><td>{name}<span class="block text-[.72rem] text-[#8a8176]" dir="ltr">× {q}</span></td><td>{amount}</td></tr>)}
              </tbody></table>
              <hr />
              <div class="flex items-baseline justify-between text-[1.15rem] font-bold"><span>{s.receipt.total}</span><span dir="ltr">{s.receipt.sum} <small class="text-[.7rem] font-medium">IQD</small></span></div>
              <p class="mt-4 text-center text-[.78rem] text-[#6b6358]">{s.receipt.thanks}</p>
            </div>
          </div>
          <div class="float chip-a"><span class="ok">✓</span>{s.receipt.drawer}</div>
          <div class="float chip-b"><span class="av">UZ</span>{s.receipt.debt}<span class="wa"></span></div>
        </div>
      </div>
    </section>

    <!-- three stories, each with the real screen -->
    {S.show.map(([key, kicker, title, body], i) => (
      <section class:list={['story', i % 2 ? 'flip' : '']}>
        <div class="wrap story-grid">
          <div class="story-text">
            <p class="reveal kicker">{kicker}</p>
            <h2 class="reveal mt-4 text-[clamp(2rem,3.9vw,3.3rem)] font-semibold leading-[1.08] tracking-tight">{title}</h2>
            <p class="reveal mt-6 text-lead text-fg-2">{body}</p>
          </div>
          <div class="reveal shot"><img src={img(key, 1800)} srcset={set(key)} sizes="(min-width: 1152px) 680px, 92vw" width="1800" height="1125" alt={title} loading="lazy" decoding="async" /></div>
        </div>
      </section>
    ))}

    <!-- the film: a minute of the real demo shop (loads only when played) -->
    <section class="wrap py-20 sm:py-28 scroll-mt-24" id="film">
      <div class="reveal film" data-film>
        <video preload="none" playsinline poster={film.poster} aria-label={s.film.label}><source src={film.src} type="video/mp4" /></video>
        <button class="film-play" type="button" aria-label={s.film.play}>
          <span class="film-btn"><svg width="18" height="20" viewBox="0 0 12 14" aria-hidden="true"><path d="M1 1.5v11l10-5.5z" fill="currentColor" /></svg></span>
          <span class="film-cap"><b>{s.film.title}</b><span class="tabular-nums">{s.film.len}</span></span>
        </button>
      </div>
    </section>

    <!-- free for now -->
    <section class="wrap pb-24 sm:pb-32">
      <div class="reveal free rounded-[2rem] p-8 sm:p-14">
        <h2 class="text-display font-semibold tracking-tight">{s.freeTitle}</h2>
        <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-0">
          {s.free.map(([title, body], i) => (
            <div class="free-col">
              <p class="text-sm font-medium tabular-nums free-num">{num(i)}</p>
              <h3 class="mt-3 text-title font-medium">{title}</h3>
              <p class="mt-3 leading-relaxed opacity-80">{body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- a day in the shop -->
    <section class="wrap border-t border-line py-24 sm:py-32">
      <div class="grid gap-14 lg:grid-cols-[1fr_1.55fr]">
        <div class="self-start lg:sticky lg:top-28">
          <h2 class="reveal text-display font-semibold tracking-tight">{s.dayTitle}</h2>
          <p class="reveal mt-5 max-w-md text-lead text-fg-2">{s.daySub}</p>
          <a class="reveal btn btn-secondary mt-8" href={demo}>{s.demo}</a>
        </div>
        <ol class="day">
          {s.day.map(([time, title, body], i) => (
            <li class:list={['reveal', (i === 0 || i === s.day.length - 1) && 'edge']}>
              <span class="time"><bdi>{time}</bdi></span>
              <div class="step"><h3 class="text-xl font-medium tracking-tight">{title}</h3><p class="mt-2 leading-relaxed text-fg-2">{body}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- what's inside -->
    <section id="features" class="scroll-mt-24 wrap border-t border-line py-24 sm:py-32">
      <h2 class="reveal max-w-3xl text-display font-semibold tracking-tight">{s.insideTitle}</h2>
      <div class="mt-14 grid gap-x-10 gap-y-11 sm:grid-cols-2 lg:grid-cols-4">
        {s.inside.map(([title, body]) => (
          <div class="reveal inside"><h3 class="text-lg font-medium tracking-tight">{title}</h3><p class="mt-1.5 text-[.97rem] leading-relaxed text-fg-2">{body}</p></div>
        ))}
      </div>
      <p class="reveal mt-14 text-muted">{s.insideNote}</p>
    </section>

    <!-- who we're looking for, and how it works -->
    <section class="wrap border-t border-line py-24 sm:py-32">
      <div class="grid gap-16 lg:grid-cols-2">
        <div>
          <h2 class="reveal text-display font-semibold tracking-tight">{s.whoTitle}</h2>
          <ul class="mt-10 grid gap-5">
            {s.who.map((x) => <li class="reveal flex items-start gap-4 text-lead"><span class="tick" aria-hidden="true">✓</span><span>{x}</span></li>)}
          </ul>
        </div>
        <div>
          <h2 class="reveal text-display font-semibold tracking-tight">{s.howTitle}</h2>
          <ol class="how mt-10">
            {s.how.map(([title, body], i) => (
              <li class="reveal"><span class="n">{num(i)}</span><div><h3 class="text-lg font-medium">{title}</h3><p class="mt-1 text-fg-2">{body}</p></div></li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <Pricing lang={lang} edition="store" color={b.color} />

    <!-- apply -->
    <section class="wrap pb-24 sm:pb-32">
      <div class="reveal end relative overflow-hidden rounded-[2rem] p-10 sm:p-16">
        <Mark class="end-mark" />
        <div class="relative max-w-2xl">
          <h2 class="text-display font-semibold tracking-tight">{s.endTitle}</h2>
          <p class="mt-4 text-lead text-fg-2">{s.endSub}</p>
          <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a class="btn btn-sys" href={apply}>{s.apply}<span class="arr" aria-hidden="true">→</span></a>
            <a class="btn btn-secondary" href={demo}>{s.demo}</a>
            <a class="link-quiet" href={mail} dir="ltr">{EMAIL}</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  // Play the film on request: controls appear once it's playing, the cover button goes away.
  for (const box of document.querySelectorAll<HTMLElement>('[data-film]')) {
    const video = box.querySelector('video')!, btn = box.querySelector<HTMLButtonElement>('.film-play')!;
    btn.addEventListener('click', () => { video.controls = true; box.classList.add('playing'); video.play().catch(() => {}); });
    video.addEventListener('ended', () => { video.controls = false; box.classList.remove('playing'); video.load(); });
  }
</script>

<style>
  /* Hemlo Stores' own look: warm receipt paper and terracotta */
  .st { --paper: #FFFDF8; --warm: #F6EBE3; --warm-2: #EFDDD0; }
  .accent { color: var(--c); }
  @media (prefers-color-scheme: dark) { .accent { color: var(--cd); } }

  /* hero */
  .hero { position: relative; overflow: hidden; background: linear-gradient(180deg, var(--warm), var(--canvas)); }
  .hero::before { content: ""; position: absolute; inset: auto 0 0; height: 40%; pointer-events: none; opacity: .5;
    background: repeating-linear-gradient(90deg, rgb(168 83 46 / .06) 0 2px, transparent 2px 7px, rgb(168 83 46 / .06) 7px 8px, transparent 8px 12px); mask: linear-gradient(transparent, #000 60%, transparent); }
  @media (prefers-color-scheme: dark) { .hero { background: linear-gradient(180deg, var(--td), var(--canvas)); } }
  .crumb { font-size: .92rem; font-weight: 500; color: var(--fg-2); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 5px; }
  .crumb:hover { color: var(--fg); }
  .live { display: inline-flex; align-items: center; gap: .55rem; padding: .4rem .9rem .4rem .75rem; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); font-size: .92rem; font-weight: 500; }
  .dot { position: relative; width: .5rem; height: .5rem; border-radius: 999px; background: #1F9D5B; flex: none; }
  .dot::after { content: ""; position: absolute; inset: -4px; border-radius: 999px; background: #1F9D5B; opacity: .35; animation: pulse 2.2s var(--ease-soft) infinite; }
  @keyframes pulse { 0% { transform: scale(.6); opacity: .5 } 80%, 100% { transform: scale(1.8); opacity: 0 } }

  .btn-sys { background: var(--c); color: #fff; padding: .95rem 1.5rem; }
  .btn-sys:hover { filter: brightness(1.07); }
  .btn-sys .arr { transition: transform .2s var(--ease-soft); }
  .btn-sys:hover .arr { transform: translateX(3px); }
  :global(html[dir="rtl"]) .btn-sys .arr { transform: scaleX(-1); }
  :global(html[dir="rtl"]) .btn-sys:hover .arr { transform: scaleX(-1) translateX(3px); }
  .link-quiet { color: var(--fg-2); font-weight: 500; text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 5px; }
  .link-quiet:hover { color: var(--fg); text-decoration-color: currentColor; }

  /* the devices, and the receipt coming off the till */
  .devices { position: relative; margin: 4.5rem auto 0; max-width: 58rem; padding-bottom: 2.5rem; }
  .laptop { position: relative; border-radius: 1.1rem; padding: .55rem; background: linear-gradient(180deg, #E9E3DC, #D6CDC3); box-shadow: 0 60px 110px -45px rgb(90 40 15 / .5), 0 0 0 1px rgb(0 0 0 / .06) inset; }
  .laptop img { display: block; width: 100%; height: auto; border-radius: .65rem; }
  .laptop::after { content: ""; position: absolute; inset: auto -4% -1.1rem; height: 1.1rem; border-radius: 0 0 1.4rem 1.4rem; background: linear-gradient(180deg, #DDD5CB, #BFB4A8); box-shadow: 0 24px 40px -22px rgb(90 40 15 / .6); }
  .phone { position: absolute; width: clamp(7rem, 20%, 12.5rem); inset-inline-start: -3%; bottom: -1rem; padding: .35rem; border-radius: 1.9rem; background: #1A1410; box-shadow: 0 40px 70px -26px rgb(60 25 10 / .6); }
  .phone img { display: block; width: 100%; height: auto; border-radius: 1.6rem; }
  .paper { position: absolute; inset-inline-end: -4%; top: 18%; transform: rotate(3deg); filter: drop-shadow(0 28px 36px rgba(60, 30, 12, .26)) drop-shadow(0 2px 4px rgba(0, 0, 0, .06)); }
  :global(html[dir="rtl"]) .paper { transform: rotate(-3deg); }
  .receipt { position: relative; width: min(16.5rem, 52vw); padding: 1.3rem 1.25rem 1.2rem; background: var(--paper); color: #221D17; border-radius: .5rem .5rem 0 0; font-feature-settings: "tnum" 1; font-size: .82rem; }
  .receipt::after { content: ""; position: absolute; inset-inline: 0; bottom: -11px; height: 12px;
    background: linear-gradient(135deg, var(--paper) 50%, transparent 50%) 0 0 / 12px 12px repeat-x, linear-gradient(-135deg, var(--paper) 50%, transparent 50%) 0 0 / 12px 12px repeat-x; }
  .receipt hr { border: 0; border-top: 1.5px dashed #D9D1C4; margin: .75rem 0; }
  .receipt table { width: 100%; border-collapse: collapse; }
  .receipt td { padding: .25rem 0; vertical-align: top; line-height: 1.3; }
  .receipt td:last-child { text-align: end; white-space: nowrap; font-weight: 500; padding-inline-start: 1rem; }
  .float { position: absolute; display: inline-flex; align-items: center; gap: .55rem; padding: .6rem .9rem; border-radius: 1rem; background: var(--surface); border: 1px solid var(--line); box-shadow: 0 14px 32px -12px rgba(14, 20, 32, .28); font-size: .86rem; font-weight: 500; white-space: nowrap; }
  .chip-a { top: -1.3rem; inset-inline-start: 14%; animation: bob 6s var(--ease-soft) infinite; }
  .chip-b { bottom: 0; inset-inline-end: 6%; animation: bob 7s var(--ease-soft) -2s infinite; }
  .ok { display: grid; place-items: center; width: 1.35rem; height: 1.35rem; border-radius: 999px; background: color-mix(in oklab, #1F9D5B 16%, transparent); color: #1F9D5B; font-size: .75rem; }
  .av { display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 999px; background: var(--t); color: var(--c); font-size: .66rem; font-weight: 700; }
  .wa { width: .5rem; height: .5rem; border-radius: 999px; background: #25D366; }
  @keyframes bob { 0%, 100% { transform: translateY(0) } 50% { transform: translateY(-7px) } }
  @media (max-width: 640px) { .devices { margin-top: 3rem; } .paper { display: none; } .chip-a { inset-inline-start: 0; } .float { font-size: .76rem; } .phone { inset-inline-start: -.5rem; } }

  /* the stories */
  .story { padding: clamp(5rem, 11vw, 9rem) 0; border-top: 1px solid var(--line); overflow: hidden; }
  .story-grid { display: grid; gap: 3.5rem; align-items: center; }
  @media (min-width: 1024px) { .story-grid { grid-template-columns: minmax(0, .8fr) minmax(0, 1.3fr); gap: 4.5rem; } .flip .story-grid { grid-template-columns: minmax(0, 1.3fr) minmax(0, .8fr); } .flip .story-text { order: 2; } }
  .kicker { font-size: .9rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--c); }
  :global(html[lang="ar"]) .kicker { letter-spacing: 0; font-size: 1rem; }
  @media (prefers-color-scheme: dark) { .kicker { color: var(--cd); } }
  .shot img { display: block; width: 100%; height: auto; border-radius: 1.1rem; border: 1px solid var(--line); box-shadow: 0 50px 100px -45px rgb(90 40 15 / .45); }
  .story.flip { background: var(--warm); border-top: 0; }
  @media (prefers-color-scheme: dark) { .story.flip { background: var(--td); } }

  /* the film */
  .film { position: relative; aspect-ratio: 16 / 9; border-radius: 1.75rem; overflow: hidden; background: #F4F1EA;
    box-shadow: 0 50px 110px -40px rgba(60, 30, 10, .35), 0 0 0 1px color-mix(in oklab, var(--c) 12%, transparent); }
  .film video { display: block; width: 100%; height: 100%; object-fit: cover; background: #F4F1EA; }
  .film-play { position: absolute; inset: 0; display: flex; align-items: flex-end; justify-content: flex-start; padding: clamp(1rem, 3vw, 2rem); cursor: pointer; }
  .film-play > * { transition: transform .35s cubic-bezier(.16, 1, .3, 1); }
  .film-play:hover > *, .film-play:focus-visible > * { transform: translateY(-3px); }
  .film-btn { display: grid; place-items: center; width: clamp(3.2rem, 6vw, 4.2rem); height: clamp(3.2rem, 6vw, 4.2rem); border-radius: 999px; background: var(--c); color: #fff;
    box-shadow: 0 18px 40px -12px color-mix(in oklab, var(--c) 70%, transparent); }
  .film-btn svg { margin: 0 0 0 4px; } /* a play triangle points right in every language */
  .film-cap { display: grid; gap: .1rem; margin-inline-start: .9rem; text-align: start; color: #0E1420; }
  .film-cap b { font-weight: 600; font-size: clamp(1rem, 1.6vw, 1.2rem); }
  .film-cap span { font-size: .9rem; color: #3A4252; }
  .film.playing .film-play { display: none; }
  @media (max-width: 640px) { .film-cap { display: none; } .film-play { padding: .7rem; } .film-btn { width: 2.6rem; height: 2.6rem; } .film { border-radius: 1.1rem; } }

  /* free for now: terracotta, like the till's total */
  .free { background: var(--c); color: #fff; background-image: radial-gradient(60% 90% at 100% 0%, rgb(255 255 255 / .12), transparent 70%); }
  .free-num { color: #FFE2D2; }
  @media (min-width: 768px) {
    .free-col { padding-inline: 2rem; }
    .free-col:first-child { padding-inline-start: 0; }
    .free-col + .free-col { border-inline-start: 1px solid rgb(255 255 255 / .22); }
  }

  /* a day in the shop */
  .day li { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); }
  .day .time { padding-top: .2rem; font-size: .9rem; font-weight: 500; color: var(--c); font-variant-numeric: tabular-nums; text-align: start; }
  @media (prefers-color-scheme: dark) { .day .time { color: var(--cd); } }
  .day .step { position: relative; padding: 0 0 2.6rem 0; padding-inline-start: 2rem; border-inline-start: 1px solid var(--line-strong); }
  .day li:last-child .step { padding-bottom: 0; border-color: transparent; }
  .day .step::before { content: ""; position: absolute; top: .45rem; inset-inline-start: -5px; width: 9px; height: 9px; border-radius: 999px; background: var(--canvas); border: 2px solid var(--c); }
  .day li.edge .step::before { background: var(--c); }
  .day li.edge .time { color: var(--muted); }
  @media (max-width: 520px) { .day li { grid-template-columns: 1fr; } .day .time { padding: 0 0 .4rem; padding-inline-start: 2rem; border-inline-start: 1px solid var(--line-strong); } }

  .inside { padding-top: 1.1rem; border-top: 2px solid var(--line); }
  .inside:hover { border-color: var(--c); }

  .tick { display: grid; place-items: center; flex: none; width: 1.9rem; height: 1.9rem; margin-top: .1rem; border-radius: 999px; background: var(--t); color: var(--c); font-size: .9rem; font-weight: 700; }
  @media (prefers-color-scheme: dark) { .tick { background: var(--td); color: var(--cd); } }
  .how { display: grid; gap: 1.6rem; }
  .how li { display: grid; grid-template-columns: 2.6rem 1fr; gap: 1.1rem; align-items: start; }
