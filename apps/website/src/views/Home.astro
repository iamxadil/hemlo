---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import BranchLogo from '../components/BranchLogo.astro';
import Compare from '../components/Compare.astro';
import HomeHero from '../components/HomeHero.astro';
import ConnectedStory from '../components/ConnectedStory.astro';
import HwBadge from '../components/HwBadge.astro';
import { BRANCH, type BranchId } from '../brand/brand';
import { t, href, EMAIL, TOOLS_URL, studioUrl, type Lang } from '../i18n/strings';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t(lang);
const picks: { id: BranchId; url: string; ext?: boolean }[] = [
  { id: 'tools', url: TOOLS_URL, ext: true },
  { id: 'studio', url: `${studioUrl(lang)}#build`, ext: true },
  { id: 'systems', url: href(lang, 'systems') },
  { id: 'school', url: href(lang, 'school') },
];
// the announcement: Hemlo Systems now joined by its add-ons (Hemlo Website, Hemlo Connect), shown as one loop
const NEW = lang === 'ar' ? {
  eyebrow: 'جديد في Hemlo Systems', title: ['نظامك الآن متصل.', 'موقعك وواتساب ونظامك، وحدة واحدة.'],
  sub: 'تابِع زبوناً واحداً من موقعك إلى معاينة محجوزة: هاتفه في جهة، ونظامك في الجهة الأخرى. لا نسخ ولا لصق، ولا رسالة تضيع. اضغط أي فصل لتنتقل إليه. متاح الآن لمكاتب العقارات والمتاجر.',
  cta: 'تعرّف على الإضافات', sample: 'شاهد موقعاً نموذجياً',
} : {
  eyebrow: 'New in Hemlo Systems', title: ['Your system is now connected.', 'Your website, WhatsApp and system, one unit.'],
  sub: 'Follow one customer from your website to a booked viewing: their phone on one side, your system on the other. No copying, no pasting, no message lost. Tap any chapter to jump to it. Available now for real estate offices and shops.',
  cta: 'See the add-ons', sample: 'See a sample site',
};
const num = (i: number) => (lang === 'ar' ? ['٠١', '٠٢', '٠٣', '٠٤'][i] : `0${i + 1}`);
---
<Base lang={lang} page="home">
  <HomeHero lang={lang} />

  <!-- the announcement: Hemlo Systems, connected to its add-ons -->
  <section class="wrap pt-20 sm:pt-28" id="connected">
    <div class="conn">
      <div class="conn-head">
        <p class="reveal conn-eyebrow"><span class="conn-new">{NEW.eyebrow}</span><HwBadge /><HwBadge label="Connect" /></p>
        <h2 class="reveal mt-5 text-display font-semibold tracking-tight">{NEW.title[0]}</h2>
        <p class="reveal mt-3 conn-acc text-[clamp(1.25rem,2.4vw,1.75rem)] font-semibold tracking-tight">{NEW.title[1]}</p>
        <p class="reveal mt-4 max-w-2xl text-lead text-fg-2">{NEW.sub}</p>
      </div>
      <div class="reveal conn-stage"><ConnectedStory lang={lang} /></div>
      <p class="reveal conn-cta">
        <a class="btn btn-primary" href={`${href(lang, 'systems')}#addons`}>{NEW.cta}<span class="arr" aria-hidden="true">→</span></a>
        <a class="link-arrow" href={lang === 'ar' ? 'https://business.hemlohq.com/s/sample' : 'https://business.hemlohq.com/s/sample?lang=en'} target="_blank" rel="noopener">{NEW.sample} <span class="arr">→</span></a>
      </p>
    </div>
  </section>

  <!-- the difference at a glance: tools, a system, or something built for you -->
  <section class="wrap pt-16 sm:pt-24"><Compare lang={lang} title={false} /></section>

  <!-- which Hemlo is for you: the visitor's need first, then the answer -->
  <section class="wrap py-24 sm:py-32" id="branches">
    <div class="text-center">
      <h2 class="reveal text-display font-semibold tracking-tight">{s.home.pickTitle}</h2>
      <p class="reveal mt-4 text-lead text-fg-2">{s.home.pickSub}</p>
    </div>
    <div class="mt-14 grid gap-3">
      {picks.map((p) => (
        <a href={p.url} rel={p.ext ? 'noopener' : undefined} class="reveal pick group"
           style={`--t:${BRANCH[p.id].tint};--td:${BRANCH[p.id].tintDark};--c:${BRANCH[p.id].color};--cd:${BRANCH[p.id].dark}`}>
          <p class="need">{s.home.pick[p.id].need}</p>
          <div class="answer">
            <BranchLogo branch={p.id} lang={lang} class="h-9" />
            <p class="mt-3 leading-relaxed text-fg-2">{s.home.pick[p.id].gets}</p>
            <p class="mt-4"><span class="pay">{s.home.pick[p.id].pay}</span></p>
          </div>
          <span class="go">{s.home.pick[p.id].cta}<span class="arr" aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
    <p class="reveal mt-10 text-center text-fg-2">{s.home.notSure} <a class="link-arrow" href={href(lang, 'contact')}>{s.home.notSureCta} <span class="arr">→</span></a></p>
  </section>

  <!-- promises -->
  <section class="wrap py-24 sm:py-32 border-t border-line">
    <h2 class="reveal text-center text-display font-semibold tracking-tight">{s.home.promiseTitle}</h2>
    <div class="mt-14 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {s.home.promises.map(([title, body], i) => (
        <div class="reveal border-t border-line pt-6">
          <span class="text-sm font-medium text-brass tabular-nums">{num(i)}</span>
          <h3 class="mt-3 text-xl font-medium tracking-tight">{title}</h3>
          <p class="mt-2 leading-relaxed text-fg-2">{body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- free tools -->
  <section class="wrap py-24 sm:py-32 border-t border-line">
    <div class="grid items-center gap-14 lg:grid-cols-2">
      <div class="reveal">
        <p class="eyebrow">Hemlo Tools</p>
        <h2 class="mt-3 text-display font-semibold tracking-tight">{s.home.toolsTitle}</h2>
        <p class="mt-5 max-w-xl text-lead text-fg-2">{s.home.toolsBody}</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a class="btn btn-primary" href={`${TOOLS_URL}invoice-maker/`} rel="noopener">{s.home.toolsCta}</a>
          <span class="text-sm text-muted">{s.home.toolsNote}</span>
        </div>
      </div>
      <div class="reveal relative">
        <div class="absolute inset-6 -z-10 rounded-[2rem] bg-sunken" aria-hidden="true"></div>
        <img src={lang === "ar" ? "/images/invoice-demo.png" : "/images/invoice-demo-en.png"} alt={lang === 'ar' ? 'مثال لفاتورة من صانع الفواتير' : 'An example invoice from the invoice maker'}
             width="909" height="1286" loading="lazy" decoding="async"
             class="mx-auto w-[min(100%,24rem)] rounded-md shadow-[0_2px_4px_rgba(14,20,32,.06),0_24px_60px_rgba(14,20,32,.14)] rotate-[-2deg]" />
      </div>
    </div>
  </section>

  <!-- method -->
  <section class="wrap py-24 sm:py-32 border-t border-line">
    <h2 class="reveal text-center text-display font-semibold tracking-tight">{s.home.methodTitle}</h2>
    <ol class="mt-14 grid gap-8 md:grid-cols-3">
      {s.home.method.map(([title, body], i) => (
        <li class="reveal card p-8">
          <span class="grid h-10 w-10 place-items-center rounded-full bg-sunken text-sm font-medium tabular-nums">{num(i)}</span>
          <h3 class="mt-6 text-title font-medium">{title}</h3>
          <p class="mt-3 leading-relaxed text-fg-2">{body}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- end -->
  <section class="wrap py-28 sm:py-36 border-t border-line text-center">
    <Mark class="reveal mx-auto h-12 w-auto text-fg" />
    <h2 class="reveal mt-7 text-display font-semibold tracking-tight">{s.home.endTitle}</h2>
    <p class="reveal mt-4 text-lead text-fg-2">{s.home.endSub}</p>
    <a class="reveal mt-8 inline-block border-b-2 border-brass pb-1 text-[clamp(1.5rem,4vw,2.75rem)] font-medium tracking-tight transition-opacity hover:opacity-70" href={`mailto:${EMAIL}`} dir="ltr">{EMAIL}</a>
  </section>
</Base>

<style>
  .pick { position: relative; display: grid; gap: 1.25rem 2.5rem; align-items: center; padding: 1.75rem; border-radius: var(--radius-tile); border: 1px solid var(--line); background: var(--surface); transition: border-color .25s, transform .3s var(--ease-soft), box-shadow .3s; }
  @media (min-width: 900px) { .pick { grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr) auto; padding: 2rem 2.25rem; } }
  .pick::before { content: ""; position: absolute; inset-block: 1.5rem; inset-inline-start: 0; width: 4px; border-radius: 0 4px 4px 0; background: var(--c); }
  :global(html[dir="rtl"]) .pick::before { border-radius: 4px 0 0 4px; }
  .pick:hover { border-color: var(--c); transform: translateY(-2px); box-shadow: 0 18px 40px -24px rgba(14, 20, 32, .25); }
  .need { font-size: clamp(1.3rem, 2.4vw, 1.75rem); font-weight: 600; line-height: 1.3; letter-spacing: -.01em; }
  :global(html[lang="ar"]) .need { letter-spacing: 0; }
  .pay { display: inline-block; padding: .3rem .8rem; border-radius: 999px; font-size: .85rem; font-weight: 500; background: var(--t); color: var(--c); }
  .go { display: inline-flex; align-items: center; gap: .5rem; justify-self: start; padding: .8rem 1.3rem; border-radius: 999px; background: var(--c); color: #fff; font-weight: 500; white-space: nowrap; }
  .go .arr { transition: transform .2s var(--ease-soft); }
  .pick:hover .go .arr { transform: translateX(3px); }
  :global(html[dir="rtl"]) .go .arr { transform: scaleX(-1); }
  :global(html[dir="rtl"]) .pick:hover .go .arr { transform: scaleX(-1) translateX(3px); }
  .conn { position: relative; padding: clamp(1.6rem, 4vw, 3.4rem); border-radius: 2rem; border: 1px solid var(--line); background: var(--surface); overflow: hidden; }
  .conn::before { content: ""; position: absolute; inset: -40% -10% auto; height: 70%; background: radial-gradient(60% 60% at 50% 40%, color-mix(in oklab, #1F6F5C 14%, transparent), transparent 70%); pointer-events: none; }
  .conn-head { position: relative; text-align: center; display: grid; justify-items: center; }
  .conn-eyebrow { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: .5rem; }
  .conn-new { padding: .3rem .8rem; border-radius: 999px; background: #1F6F5C; color: #fff; font-size: .85rem; font-weight: 600; }
  .conn-acc { color: #1F6F5C; }
  .conn-stage { position: relative; margin-top: clamp(2rem, 5vw, 3.4rem); }
  .conn-cta { position: relative; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 1rem 1.6rem; margin-top: 2.6rem; }
  .conn-cta .btn .arr { margin-inline-start: .4rem; }
  :global(html[dir="rtl"]) .conn-cta .arr { display: inline-block; transform: scaleX(-1); }
  @media (prefers-color-scheme: dark) { .conn-new { background: #5FBF9F; color: #0B1019; } .conn-acc { color: #5FBF9F; } }
  @media (prefers-color-scheme: dark) { .pay { background: var(--td); color: var(--cd); } .go { background: var(--cd); color: #0B0F16; } .pick::before { background: var(--cd); } .pick:hover { border-color: var(--cd); } }
</style>
