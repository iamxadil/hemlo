{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hemlo-coming-soon",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "hemlohq.com", "custom_domain": true },
    { "pattern": "www.hemlohq.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "observability": { "enabled": true }
}
