---
// A blank in the sentence: shows the chosen words, underlined; a native <select> sits invisibly on top,
// so phones open their own picker and keyboards work as usual.
interface Props { name: string; options: [string, string][]; value?: string; label: string; }
const { name, options, value = options[0][0], label } = Astro.props;
const current = options.find(([v]) => v === value)?.[1] ?? options[0][1];
---
<span class="blank"><span data-label>{current}</span><select name={name} aria-label={label}>{options.map(([v, l]) => <option value={v} selected={v === value}>{l}</option>)}</select></span>
